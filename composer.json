{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "althinect/filament-spatie-roles-permissions": "3.x-dev",
        "dave-mills/filament-table-in-a-schema": "dev-main",
        "defstudio/filament-column-length-limiter": "^4.0",
        "filament/filament": "^4.3.1",
        "filament/spatie-laravel-media-library-plugin": "^4.0",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.6",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.1",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "orangehill/iseed": "^3.0",
        "sentry/sentry-laravel": "^4.6",
        "spatie/laravel-permission": "^6.1",
        "spatie/pdf-to-text": "^1.54",
        "stats4sd/filament-team-management": "^4.0",
        "staudenmeir/belongs-to-through": "^2.5",
        "staudenmeir/eloquent-has-many-deep": "^1.7",
        "symfony/http-client": "^7.1",
        "symfony/mailgun-mailer": "^7.1",
        "watheqalshowaiter/filament-sticky-table-header": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "^4.0",
        "larastan/larastan": "^3.0",
        "laravel-shift/blueprint": "^2.8",
        "laravel/boost": "^1.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-ray": "^1.39"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "dave-mills/filament-table-in-a-schema": {
            "type": "path",
            "url": "./packages/filament-table-in-a-schema",
            "options": {
                "symlink": true
            }
        }
    }
}
