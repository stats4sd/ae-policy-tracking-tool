 and `start_offset` = 151141 and `end_offset` = 152124 and `extract` = \'Policy Statements\\\\n                                          The Government, in collaboration with stakeholders, shall:\\\\n                                          i)\\t\\u0007promote environmental and social safeguards and compliance in\\\\n                                                the water sector;\\\\n                                          ii)   ensure land availability for water projects;\\\\n                                          iii)\\t\\u0007promote mainstreaming of climate change resilience interventions\\\\n                                                in the water sector;\\\\n\\\\n\\\\n\\\\n             42\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\niv)\\t\\u0007promote risk-based climate change adaptation and mitigation\\\\n     measures in the water sector; and\\\\nv)\\t\\u0007promote cross-sectoral coordination and collaboration in managing\\\\n     the impacts of climate change and environmental issues\' and `automatic` = 1 and `color` = \'lightblue\') order by `highlights`.`policy_document_id` asc, `highlights`.`start_offset` asc limit 1\",\"time\":\"0.88\",\"slow\":false,\"file\":\"\\/Users\\/dave\\/Sites\\/ae-policy-tracking-tool\\/app\\/Jobs\\/PolicyDocumentAutoSearch.php\",\"line\":75,\"hash\":\"c9ec6d28cfc0ee0290aeda4897106aba\",\"hostname\":\"dave-mbp\"}','2025-11-21 12:13:23'),(1083,'a068f957-cc30-46c5-bf82-55f5f445ed5e','a068f958-0cfa-47d0-b062-04caf9706c89',NULL,1,'model','{\"action\":\"retrieved\",\"model\":\"App\\\\Models\\\\Highlight\",\"count\":2,\"hostname\":\"dave-mbp\"}','2025-11-21 12:13:23'),(1084,'a068f957-cc6a-47de-bbc8-383e4167c819','a068f958-0cfa-47d0-b062-04caf9706c89',NULL,1,'query','{\"connection\":\"mysql\",\"driver\":\"mysql\",\"bindings\":[],\"sql\":\"select * from `highlight_priority_acti