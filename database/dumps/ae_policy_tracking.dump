e9','a068f955-4de6-4077-b30a-c55fdcce9f47',NULL,1,'query','{\"connection\":\"mysql\",\"driver\":\"mysql\",\"bindings\":[],\"sql\":\"select * from `media` where `media`.`model_id` in (2) and `media`.`model_type` = \'App\\\\Models\\\\PolicyDocument\'\",\"time\":\"1.06\",\"slow\":false,\"file\":\"\\/Users\\/dave\\/Sites\\/ae-policy-tracking-tool\\/app\\/Jobs\\/PolicyDocumentExtractContent.php\",\"line\":28,\"hash\":\"e8ccc456086afaabbdbf6b1cbe08dd67\",\"hostname\":\"dave-mbp\"}','2025-11-21 12:13:20'),(871,'a068f953-4517-4a41-bad3-4061b0f2f878','a068f955-4de6-4077-b30a-c55fdcce9f47',NULL,1,'model','{\"action\":\"retrieved\",\"model\":\"Spatie\\\\MediaLibrary\\\\MediaCollections\\\\Models\\\\Media\",\"count\":1,\"hostname\":\"dave-mbp\"}','2025-11-21 12:13:20'),(872,'a068f955-4c5f-4700-83c3-3d12d62ec90f','a068f955-4de6-4077-b30a-c55fdcce9f47',NULL,1,'query','{\"connection\":\"mysql\",\"driver\":\"mysql\",\"bindings\":[],\"sql\":\"update `policy_documents` set `content` = \'THE UNITED REPUBLIC OF TANZANIA\\\\n            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                        National Water Policy 2002 Version 2025\\\\n\\\\nNATIONAL WATER POLICY 2002\\\\n       VERSION 2025\\\\n\\\\n                MARCH 2025                              a\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                b\\\\n      THE UNITED REPUBLIC OF TANZANIA\\\\n            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nNATIONAL WATER POLICY 2002\\\\n       VERSION 2025\\\\n\\\\n                MARCH 2025\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                                              TABLE OF CONTENTS\\\\n\\\\n\\\\n                                          TABLE OF CONTENTS \\u2026 ii\\\\n                                          DEFINITIONS OF TERMS\\u2026 vi\\\\n                                          FOREWORD. \\u2026 x\\\\n\\\\n                                          CHAPTER ONE . \\u20261\\\\n                                          INTRODUCTION\\u20262\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          1.1. Background. \\u2026 2\\\\n                                          1.2. Situation Analysis\\u2026 4\\\\n                                               1.2.1\\t\\t Water Resources Management\\u2026 5\\\\n                                               1.2.2\\t\\t Water Resources Development. \\u2026 10\\\\n                                               1.2.3\\t\\t Water and Wastewater Quality Management\\u2026 11\\\\n                                               1.2.4\\t\\tAccess to Water Supply Services and Water Management\\\\n                                          \\t\\t\\t          Systems\\u2026 13\\\\n                                               1.2.5\\t\\t Sanitation\\u2026 17\\\\n                                               1.2.6\\t\\t Private Sector Participation\\u2026 19\\\\n                                               1.2.7\\t\\t Research and Technology Development\\u2026 20\\\\n                                               1.2.8\\t\\t Cross-Cutting Issues\\u2026 21\\\\n                                          \\t\\t\\t          1.2.8.1 Environmental and Climate Change Resilience. ....... 21\\\\n                                          \\t\\t\\t          1.2.8.2 Gender\\u2026 23\\\\n                                          \\t\\t\\t          1.2.8.3 Good Governance\\u2026 24\\\\n\\\\n                                          CHAPTER TWO. \\u202627\\\\n                                          RATIONALE, VISION, MISSION AND OBJECTIVES\\u202628\\\\n                                          2.1 Rationale and Justification\\u2026 28\\\\n                                          2.2 Vision, Mission and Objectives\\u2026 30\\\\n                                              2.2.1\\t\\t Vision\\u2026 30\\\\n                                              2.2.2\\t\\t Mission\\u2026 30\\\\n                                          2.3 Policy Objectives \\u2026 30\\\\n\\\\n                                          CHAPTER THREE. \\u202631\\\\n                                          POLICY ISSUES, OBJECTIVES AND STATEMENTS. \\u202632\\\\n                                          3.1 Sustainable Management of Water Resources\\u2026 32\\\\n                                          3.2 Water Resources Development. \\u2026 33\\\\n                                          3.3 Water and Wastewater Quality Management\\u2026 34\\\\n                                          3.4 Sustainable Water Supply Services and Water Management\\\\n                                              Systems\\u2026 35\\\\n\\\\n\\\\n\\\\n\\\\n                 ii\\\\n                                                                      THE UNITED REPUBLIC OF TANZANIA\\\\n    MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n3.5    Reliable and Sustainable Sanitation Services\\u2026 38\\\\n3.6    Private Sector Participation in the Water Sector. \\u2026 39\\\\n3.7    Research and Technology Development\\u2026 39\\\\n3.8    Cross-Cutting Issues\\u2026 41\\\\n       3.8.1\\t\\t\\t\\u0007Environment, Climate Change and Disaster Resilience\\\\n                Systems\\u2026 41\\\\n       3.8.2\\t\\t\\t Gender Mainstreaming and Social Inclusion\\u2026 43\\\\n       3.8.3\\t\\t\\t Good Governance. \\u2026 44\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nCHAPTER FOUR\\u202645\\\\nLEGAL AND REGULATORY FRAMEWORK\\u202646\\\\n\\\\nCHAPTER FIVE . \\u202649\\\\nINSTITUTIONAL FRAMEWORK, MONITORING AND EVALUATION. ......50\\\\n5.1 Institutional Framework. \\u2026 50\\\\n5.2 Monitoring and Evaluation\\u2026 53\\\\n5.3 Conclusion\\u2026 54\\\\n\\\\n\\\\n\\\\n\\\\n    iii\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                    LIST OF ABBREVIATIONS AND ACRONYMS\\\\n\\\\n                                          BCM          Billion Cubic Meters\\\\n\\\\n                                          BOD          Biochemical Oxygen Demand\\\\n\\\\n                                          CBO          Community Based Organisation\\\\n\\\\n                                          CBWSOs       Community-Based Water Supply Organisations\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          CM           Cubic Meters\\\\n\\\\n                                          COD          Chemical Oxygen Demand\\\\n\\\\n                                          EFA          Environmental Flow Assessment\\\\n\\\\n                                          EMA          Environmental Management Act\\\\n\\\\n                                          EWS          Early Warning System\\\\n\\\\n                                          EWURA        Energy and Water Utilities Regulatory Authority\\\\n\\\\n                                          FBO          Faith-Based Organisation\\\\n\\\\n                                          FYDP         Five-Year Development Plan\\\\n\\\\n                                          IWRM         Integrated Water Resources Management\\\\n\\\\n                                          IWRMD        Integrated Water Resources Management and Development\\\\n\\\\n                                          JNHPP        Julius Nyerere Hydropower Plant\\\\n\\\\n                                          M&E          Monitoring and Evaluation\\\\n\\\\n                                          MCM          Million Cubic Meters\\\\n\\\\n                                          MIS          Management Information System\\\\n\\\\n                                          MoW          Ministry of Water\\\\n\\\\n                                          MW           Megawatt\\\\n\\\\n                                          NAWAPO National Water Policy\\\\n\\\\n                                          NGO          Non-Governmental Organisation\\\\n\\\\n                                          NSC          National Sanitation Campaign\\\\n\\\\n\\\\n\\\\n\\\\n               iv\\\\n                                           THE UNITED REPUBLIC OF TANZANIA\\\\n                                                        MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nPO-RALG President\\u2019s Office, Regional Administration and Local\\\\n        Government\\\\nRUWASA Rural Water Supply and Sanitation Agency\\\\n\\\\nSDGs      Sustainable Development Goals\\\\n\\\\nTDV       Tanzania Development Vision 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                                                             National Water Policy 2002 Version 2025\\\\nTSF       Tailings Storage Facility\\\\n\\\\nWASH      Water, Sanitation and Hygiene\\\\n\\\\nWRM       Water Resources Management\\\\n\\\\nWSDP      Water Sector Development Program\\\\n\\\\nWSSAs     Water Supply and Sanitation Authorities\\\\n\\\\nWUAs      Water Users Associations\\\\n\\\\n\\\\n\\\\n\\\\n    v\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                                 DEFINITIONS OF TERMS\\\\n\\\\n                                          Ambient Water Quality\\\\n                                          The quality of natural untreated water in rivers, lakes and ground waters,\\\\n                                          representing a combination of natural influences together with the impact\\\\n                                          of all anthropogenic activities\\\\n\\\\n                                          Basin\\\\n                                          An area of land where rainfall collects and drains water into a common\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          outlet\\\\n\\\\n                                          Domestic Purpose\\\\n                                          The use of water solely for meeting household and domestic needs and\\\\n                                          excluding any commercial activities\\\\n\\\\n                                          Faecal Sludge\\\\n                                          The slurry containing both solid and liquid waste that accumulates in on-\\\\n                                          site sanitation systems. Specifically, it may refer to a semi-solid mixture of\\\\n                                          human excrement accumulated in pit latrines, septic tanks, wastewater\\\\n                                          stabilisation ponds, and other liquid waste treatment systems. It can also\\\\n                                          refer to animal waste that collects in holding pens.\\\\n\\\\n                                          Faecal Sludge Management\\\\n                                          Organised programs that provide safe and hygienic septic tank and pit\\\\n                                          emptying services, along with proper treatment of liquids and re-use of\\\\n                                          bio-solids where possible\\\\n\\\\n                                          Groundwater\\\\n                                          Water which is naturally stored or flowing below the surface of the ground\\\\n                                          but can rise to the surface in, e.g. wetlands and springs\\\\n\\\\n                                          Non-Revenue Water\\\\n                                          The amount of water that a water utility produces (or purchases from\\\\n                                          other water utilities) minus the amount sold to consumers is presented as\\\\n                                          a percentage of water produced and\\/or purchased.\\\\n\\\\n                                          Pollution\\\\n                                          In relation to water resources, any direct or indirect alteration of the\\\\n                                          physical, thermal, chemical or biological properties of the water resource\\\\n                                          which makes it (a) less fit for any beneficial purpose for which it is or may\\\\n                                          be reasonably expected to be used; or (b) harmful or potentially harmful\\\\n\\\\n\\\\n               vi\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nto (i) the welfare, health or safety of human beings; (ii) any aquatic or non-\\\\naquatic life; (iii) property; or (iv) the wider environment.\\\\n\\\\nPublic Tap\\\\nAny fountain, standpipe, tap, trough, valve or other appliance or structure\\\\nerected, provided or maintained by or on behalf of a water supply and\\\\nsanitation authority or a community-based water supply organisation to\\\\nsupply its consumers.\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nSanitation\\\\nAccess to and use of facilities and services for the safe disposal of human\\\\nurine and faeces\\\\n\\\\nSanitation Coverage\\\\nThe proportion of the population with access to sanitation services\\\\n\\\\nSanitation Works\\\\nSewers, drains, pipes, ducts or channels, whether open or closed, are used\\\\nfor the drainage of human excreta or wastewater from buildings or land,\\\\nand on-site systems for the reception of human excreta and wastewater\\\\nwhich do not connect to a sewer, as well as treatment to the recommended\\\\nstandards before disposal to the environment.\\\\n\\\\nSewage\\\\nLiquid waste conveyed in sewers, not including stormwater\\\\n\\\\nSewer\\\\nAny pipe or conduit, other than a drain, which is intended for the conveyance\\\\nof sewage\\\\n\\\\nSewerage\\\\nA network of pipes, pumping stations and appurtenances that convey\\\\nsewage from its point of origin to the point of treatment or disposal\\\\n\\\\nWater Stakeholders\\\\nIndividuals, organisations, and communities that are interested in water\\\\nresources and their management include, but are not limited to, government\\\\nagencies, environmental organisations, development partners, agricultural\\\\nproducers, industrial suppliers, the private sector, and local communities.\\\\n\\\\n\\\\n\\\\n\\\\n    vii\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          Surface Water\\\\n                                          All water flowing over the ground or contained in any visible water body,\\\\n                                          such as a lake, pond, reservoir, or river, is of any size and permanent or\\\\n                                          temporary.\\\\n\\\\n                                          Tailing Dam\\\\n                                          A specially constructed tailings pond for storing mining tailings and\\\\n                                          processing water\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          Transboundary Water\\\\n                                          These are water resources contained within drainage or river basins that\\\\n                                          cross political boundaries and are shared by more than one sovereign\\\\n                                          country. These can be surface or ground waters.\\\\n\\\\n                                          Wastewater\\\\n                                          Liquid waste of both excremental and non-excremental nature but which\\\\n                                          does not include stormwater.\\\\n\\\\n                                          Water pan\\\\n                                          An informal term used to collectively describe small, permanent, or\\\\n                                          seasonal water bodies created through the capture of rainwater runoff and\\\\n                                          used as a water source for livestock, agriculture, domestic purposes, and\\\\n                                          wildlife. The term is applied to deliberately constructed water works such\\\\n                                          as excavated ponds, small dams, and water bodies created naturally or as a\\\\n                                          by-product of other human activities such as mining or road construction.\\\\n\\\\n                                          Water Quality\\\\n                                          Chemical, physical, biological, and radiological characteristics of water\\\\n                                          relative to the requirements of the ecosystem or to any human need or\\\\n                                          purpose\\\\n\\\\n                                          Water Quality Management\\\\n                                          This is a process of monitoring, assessing, and improving the quality\\\\n                                          of water resources to ensure they are safe for human consumption,\\\\n                                          environmental health and recreational use. It involves a range of practices\\\\n                                          and policies aimed at protecting or restoring water quality from pollution\\\\n                                          and degradation.\\\\n\\\\n                                          Water Resources\\\\n                                          These are watercourse, surface water, groundwater or estuary water.\\\\n\\\\n\\\\n\\\\n            viii\\\\n                                               THE UNITED REPUBLIC OF TANZANIA\\\\n                                                            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nWater Scheme\\\\nThis is a structured plan or program designed to manage, distribute, and\\\\nimprove water resources within a specific area, typically encompasses\\\\nthe development and maintenance of infrastructure, such as pipelines,\\\\ntreatment facilities, and storage systems, to ensure access to clean and\\\\nsafe drinking water.\\\\n\\\\nWater Sector\\\\nWater resources development and management, water quality, water\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nsupply and sanitation services\\\\n\\\\nWater Service Coverage\\\\nThe percentage (proportion) of the population accessing clean and safe\\\\nwater from improved water sources\\\\n\\\\nWater Source\\\\nThis could be a river, tributary, estuary, lake, swamp, marsh, or other\\\\nwetland; an aquifer or a spring; seawater and the interface between\\\\nseawater and freshwater; or a dam, pond, or reservoir.\\\\n\\\\nWater Supply\\\\nThe provision of appropriate facilities and services for the sourcing,\\\\ntreatment and distribution of potable water\\\\n\\\\nWaterworks\\\\nWaterworks include canals, channels, reservoirs, embankments, weirs,\\\\ndams, wells, boreholes, and other works constructed for, or in connection\\\\nwith, the diversion, damming, storage, or abstraction of water, the\\\\nprotection of rivers, lakes, or any other water sources, the conservation of\\\\nwater sources, drainage, or the use of water for any purpose.\\\\n\\\\n\\\\n\\\\n\\\\n    ix\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                                            FOREWORD\\\\n\\\\n                                          Water is a shared natural resource essential to life and the environment.\\\\n                                          It plays a crucial role in any country\\u2019s social, cultural, and economic\\\\n                                          development. It influences all aspects of life, including the environment,\\\\n                                          productive and social sectors.\\\\n\\\\n                                          In 2002, the Government published the National Water Policy (NAWAPO)\\\\n                                          to ensure that water resources are effectively managed to support the\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          nation\\u2019s social and economic growth while protecting the environment. The\\\\n                                          policy aimed at creating a comprehensive framework for water resource\\\\n                                          management, improving health and reducing poverty in rural areas by\\\\n                                          increasing access to adequate safe water, while achieving sustainable\\\\n                                          development as well as effective management of urban water supply and\\\\n                                          sewerage services.\\\\n\\\\n                                          The implementation of NAWAPO 2002 resulted in the formulation of\\\\n                                          the Water Sector Development Program (WSDP 2006\\u20132025), which is\\\\n                                          the largest water programme in Sub-Saharan Africa, and the enactment\\\\n                                          of two key water laws - The Water Resources Management Act No. 11\\\\n                                          of 2009 (amended by the Miscellaneous Amendment Act No. 8 of 2022)\\\\n                                          and the Water Supply and Sanitation Act No. 12 of 2009 (repealed by the\\\\n                                          Water Supply and Sanitation Act No. 5 of 2019). These initiatives enabled\\\\n                                          the establishment of an institutional framework for water resource\\\\n                                          management and water supply and sanitation services, which included the\\\\n                                          National Water Board, Basin Water Boards, Water Supply and Sanitation\\\\n                                          Authorities, the Rural Water Supply and Sanitation Agency, Community-\\\\n                                          Based Water Supply Organisations, the National Water Fund and Water\\\\n                                          Institute.\\\\n\\\\n                                          Additionally, implementing the policy has led to improved water quality\\\\n                                          management and provision of water supply and sanitation services. Priority\\\\n                                          interventions and investment needs were identified in water resource\\\\n                                          management, urban water supply, sewerage services, and rural water\\\\n                                          supply. The implementation of these interventions have led to increased\\\\n                                          access to clean and safe water in rural areas from 50 to 83 per cent and\\\\n                                          in urban areas from 73 to 91.6 per cent from 2002 to 2024, respectively.\\\\n                                          Despite these achievements, various gaps in the policy have prompted\\\\n                                          its review. One of the gaps was the inability of rural communities to\\\\n                                          implement the policy\\u2019s directive that required them to contribute to capital\\\\n\\\\n\\\\n\\\\n                x\\\\n                                               THE UNITED REPUBLIC OF TANZANIA\\\\n                                                            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\ninvestment and to own and manage their rural water schemes. Large-scale\\\\nwater projects have continued to be constructed in rural areas that require\\\\nsubstantial investment, advanced technology, and professional expertise,\\\\nand their costs are beyond the capacity of local communities. The policy\\\\nwas also silent on managing wastewater quality in rural areas. This led\\\\nto slower progress in service delivery and subsequent poor water quality\\\\nmanagement in rural areas. Furthermore, the policy\\u2019s directive to privatise\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nwater supply and sanitation services in small towns has not been realised\\\\nand is no longer a Government priority.\\\\n\\\\nTo address these gaps, the Government has reviewed the National Water\\\\nPolicy of 2002, now presented as Version 2025, through a consultative\\\\nprocess where all stakeholders were involved. The updated policy aims\\\\nto ensure optimal, reliable, sustainable, and equitable development and\\\\nuse of water resources for the benefit of all in the most cost-effective\\\\nway. It offers guidance to stakeholders on addressing challenges in water\\\\nresource management and development, water quality in both rural and\\\\nurban areas, and water supply and sanitation services of which are critical\\\\nto achieving socio-economic development and water security in line with\\\\nnational and international goals. The policy also emphasises private sector\\\\nengagement and the importance of research and development.\\\\n\\\\nLastly, I appreciate the contribution of all stakeholders and partners who\\\\nsupported the process of reviewing the policy. I urge all of us to commit\\\\nand actively participate in implementing this policy, recognising that water\\\\nis a precious resource essential for the well-being of both present and\\\\nfuture generations.\\\\n\\\\n\\\\n\\\\n\\\\n                    Hon. Jumaa Hamidu Aweso (MP)\\\\n\\\\n                          MINISTER FOR WATER\\\\n\\\\n\\\\n\\\\n\\\\n    xi\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n              xii\\\\n                                              1\\\\n                                              Chapter\\\\n\\\\n\\\\n\\\\n\\\\n                           Introduction\\\\n\\\\n\\\\n\\\\n\\\\n1\\\\n    National Water Policy 2002 Version 2025\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                                       INTRODUCTION\\\\n\\\\n                                          1.1 Background\\\\n                                          Water is a shared natural resource fundamental to life and the sustenance\\\\n                                          of the environment of which human beings depend upon. It plays a central\\\\n                                          role in Tanzania\\u2019s social and economic development, touching on all aspects\\\\n                                          of life necessary for sustainable economic development and stability. For\\\\n                                          the environment, water supports ecosystem biodiversity, including flora\\\\n                                          and fauna, to maintain a viable population.\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          To improve water and sanitation services in the country, the Government\\\\n                                          enacted the first National Water Policy of 1991 to guide the provision\\\\n                                          of clean and safe water to the population within 400 meters of their\\\\n                                          households. Due to challenges in implementing the 1991 Policy emanating\\\\n                                          from changing global trends in the water sector and other national policy\\\\n                                          reforms, the Government launched the National Water Policy of 2002\\\\n                                          (NAWAPO 2002).\\\\n\\\\n                                          The NAWAPO 2002 established an institutional framework for the\\\\n                                          management and development of water resources and the development\\\\n                                          and sustainable management of water supply services in rural and urban\\\\n                                          areas. The framework enabled the establishment of various institutions in\\\\n                                          the water sector, including the National Water Board, which serves as an\\\\n                                          advisory body to the Minister on water and sanitation issues; Basin Water\\\\n                                          Boards (BWBs), responsible for managing and developing water resources;\\\\n                                          Water Supply and Sanitation Authorities (WSSAs), tasked with providing\\\\n                                          water and sanitation services in urban areas; Community-Based Water\\\\n                                          Supply Organisations (CBWSOs), responsible for delivering water and\\\\n                                          sanitation services in rural areas; the Rural Water Supply and Sanitation\\\\n                                          Agency (RUWASA), which oversees the development and sustainable\\\\n                                          management of rural water supply and sanitation projects; the National\\\\n                                          Water Fund (NWF), which mobilises resources and provides investment\\\\n                                          support for water service provision and the management of catchment\\\\n                                          areas; and the Water Institute (WI) which is responsible for provision of\\\\n                                          trained and skilled personnel in the water sector.\\\\n\\\\n                                          The implementation of NAWAPO 2002 enhanced the credibility of\\\\n                                          hydrological data and information, the adoption of Integrated Water\\\\n                                          Resources Management and Development (IWRMD) planning, the\\\\n                                          conservation and protection of water sources, and enhanced collaboration\\\\n\\\\n\\\\n\\\\n                2\\\\n                                                 THE UNITED REPUBLIC OF TANZANIA\\\\n                                                              MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nwith riparian states through joint protocols, conventions, and agreements\\\\nfor the development and management of transboundary water resources.\\\\n\\\\nIn 2020, a review of NAWAPO 2002 revealed some challenges and gaps.\\\\nUnder water resources management and development these challenges\\\\ninclude minimal consideration of the impacts of climate change in the\\\\nsector, and inadequate investment in water storage facilities and water\\\\ndemand management. This is on and above less emphasis on water\\\\nharvesting technologies and supporting a transformative national water\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\ngrid to enhance sustainable water supply and ensure water security in the\\\\ncountry.\\\\n\\\\nIn water quality and wastewater management, there have been challenges\\\\nin implementing the policy, especially due to persistent pollution of water\\\\nsources resulting from improper treatment and discharge of wastewater\\\\ninto the environment. The policy also considered water quality at the\\\\nsource, treatment of urban water and wastewater, but excluded the same\\\\nin rural areas since water quality and sanitation were not a problem in\\\\nsuch localities at the time. The increased rural population and enhanced\\\\neconomic development and change of lifestyles have led to increased water\\\\ndemand in such localities. This has led to the construction of small dams\\\\nin rural areas and the use of unimproved surface water sources, including\\\\nrivers and water pans, which calls for consideration of water quality and\\\\nsanitation issues in such localities. This has led to the construction of small\\\\ndams in rural areas and the use of unimproved surface water sources,\\\\nincluding rivers and water pans, which calls for consideration of water\\\\nquality and sanitation issues as well.\\\\n\\\\nThere are several identified water supply and sanitation challenges. One\\\\nis low investment that cannot cope with rapid urbanisation, industrial\\\\ndevelopment as well as other economic activities. Another critical challenge\\\\nis physical and commercial water loss, which accounts for high non-revenue\\\\nwater (NRW) caused by dilapidated infrastructure and inefficient water\\\\nmanagement (leaks, unauthorised usage and metering inaccuracies). The\\\\npopulation increase in rural areas has outrun the planned water schemes.\\\\nAdditionally, some schemes have been unsustainable due to the impacts\\\\nof climate change that have caused water sources to dry up. This has\\\\nnecessitated investment into large water infrastructure projects using\\\\nreliable water sources. Thus, it has been difficult to implement the policy\\\\ndirective requiring rural communities to contribute part of the project\\\\n\\\\n\\\\n\\\\n    3\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          capital cost. Moreover, rural sanitation services have not developed and\\\\n                                          have been limited in urban areas. The private sector has also not been\\\\n                                          active in investing and operating water supply and sanitation schemes. Their\\\\n                                          contribution has been limited to a few Corporate Social Responsibility (CSR)\\\\n                                          activities or consultancies and construction of water supply infrastructure.\\\\n                                          Furthermore, attempts to promote Public Private Partnerships (PPPs) in\\\\n                                          the water sector have had very limited success.\\\\n\\\\n                                          In addition, the policy emphasised the importance of Research and\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          Development (R&D) in effecting and adapting technological changes and\\\\n                                          innovation in the sector. To date, there has been limited progress in this\\\\n                                          area, with only a few studies that were either demand-driven with minimal\\\\n                                          impact on sectoral transformation. New Information and Communication\\\\n                                          Technology (ICT) tools, for example, the use of Artificial Intelligence (AI) in\\\\n                                          the water sector, have not been fully explored.\\\\n\\\\n                                          1.2 Situation Analysis\\\\n                                          The main goal of NAWAPO 2002 was to establish a robust system for\\\\n                                          managing and developing water resources and to institute a strong legal\\\\n                                          and institutional framework for managing policy implementation. It\\\\n                                          further aimed at ensuring beneficiaries in rural areas participate fully in\\\\n                                          the planning, construction, operation, maintenance and management of\\\\n                                          water supply schemes; and achieving sustainable, effective and efficient\\\\n                                          development and management of urban water supply and sewerage\\\\n                                          services. The Policy also aimed at changing the government\\u2019s role from\\\\n                                          service provision to coordination, policy and guidelines formulation,\\\\n                                          and regulation for sustainable development and management of water\\\\n                                          resources. The three main objectives of NAWAPO 2002 are:\\\\n\\\\n                                          i)\\t\\t\\u0007 Water Resources Management: To establish a comprehensive\\\\n                                                framework that promotes the optimal, sustainable, and equitable\\\\n                                                development of water resources for the benefit of all Tanzanians;\\\\n                                          ii)\\t\\t\\u0007Rural Water Supply: To improve public health and reduce poverty\\\\n                                                in rural areas by enhancing access to adequate and safe water; and\\\\n                                                Urban Water Supply: To ensure the sustainable, effective, and\\\\n                                          iii)\\t\\t\\u0007\\\\n                                                efficient development and management of urban water supply and\\\\n                                                sewerage services.\\\\n\\\\n                                          This section narrates the current situation in implementing the three main\\\\n                                          objectives and highlights the policy gaps that have necessitated a policy\\\\n                                          review.\\\\n\\\\n\\\\n                4\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n1.2.1 Water Resources Management\\\\nTanzania is endowed with abundant natural freshwater resources,\\\\nincluding lakes, rivers, springs and aquifers, some of which are shared with\\\\nneighbouring countries as transboundary water resources. There are also\\\\nconstructed dams and many water pans, which are used as unimproved\\\\nwater sources for domestic and socio-economic purposes. With all these\\\\nresources, there is a need for a well-established and efficient institutional\\\\nset-up for water allocation, resource development, and management\\\\nof both quantity and quality across all water uses. The NAWAPO 2002\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nprovides a basis for supporting and guiding water resources management\\\\n(WRM), including institutions, infrastructure, and information systems.\\\\n\\\\nTo ensure good management of water resources in the country, nine\\\\nBasin Water Boards (BWBs) were established, namely, Pangani, Wami\\/\\\\nRuvu, Rufiji, Ruvuma and Southern Coast, Lake Nyasa, Lake Rukwa, Lake\\\\nTanganyika, Lake Victoria, and the Internal Drainage Basin. BWBs are the\\\\ninstitutions responsible for overseeing the implementation of basin plans.\\\\nThe BWBs develop and manage water resources through the Integrated\\\\nWater Resource Management and Development (IWRMD) and Catchment\\\\nConservation Plans (CCPs) to promote coordinated management and\\\\nsustainable development of water resources. IWRMD plans were prepared\\\\nby the BWBs in collaboration with other water-related sectors and\\\\nstakeholders, with implementation plans involving all parties. Functional\\\\nareas of WRM include water resources data and information systems,\\\\nassessment and planning, water allocation and demand management,\\\\nwater sources conservation and pollution control, dam development and\\\\nmanagement, and transboundary water resources management. Despite\\\\nthe success of NAWAPO 2002 in establishing a sound policy framework for\\\\nwater resources management, over the last twenty-three years, there has\\\\nemerged some challenges that require a new policy guidance as narrated\\\\nherein.\\\\n\\\\n1.2.1.1 Water Resources Data and Information System, Assessment\\\\nand Planning\\\\nThe task of collecting water resources data, processing and analysis for\\\\nwater resources management is performed by BWBs. They are responsible\\\\nfor ensuring the availability of hydrological and hydrogeological data\\\\nand information, which is central to the effective management of water\\\\nresources. In achieving this, a network of 832 monitoring stations has been\\\\ninstalled across the country, including 756 hydrometeorological stations\\\\n\\\\n\\\\n\\\\n    5\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          and 76 groundwater monitoring stations. The collected and analysed data\\\\n                                          support decision-making in managing and developing water resources.\\\\n                                          During the implementation of NAWAPO 2002, it was observed that some\\\\n                                          of the monitoring stations faced sustainability challenges due to wear and\\\\n                                          tear, lack of regular maintenance, outdated technology and equipment\\\\n                                          vandalism. Additionally, the available network is manually operated,\\\\n                                          leading to delays in data collection, processing and dissemination.\\\\n\\\\n                                          Water resources assessment is conducted at the basin level by determining\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          the point of assessment, quantity, and quality, as well as analysing the\\\\n                                          current status and trends related to availability, accessibility, and demand for\\\\n                                          water. Extensive water resources assessments have supported ascertaining\\\\n                                          existing and future water availability, disaster forecasting, establishing\\\\n                                          sectoral water demands and optimum water resource monitoring systems\\\\n                                          for the respective basins. Reliable water resource assessments have been\\\\n                                          hampered by inadequate hydrological, hydrogeological and meteorological\\\\n                                          monitoring networks, resulting in insufficient data and information for\\\\n                                          evidence-based planning and decision-making.\\\\n\\\\n                                          Water resources planning is conducted by using IWRMD plans. The plans\\\\n                                          provide blueprints for rational management and development of the\\\\n                                          nation\\u2019s water resources for multi-sectoral needs in each basin. To ensure\\\\n                                          proper implementation of the plans, the Government established platforms\\\\n                                          for stakeholder engagement for effective water resources planning and\\\\n                                          development.\\\\n\\\\n                                          These include the National Multi-Sectoral Forum, Basins Multi-Sectoral Fora\\\\n                                          and Catchment Stakeholders Fora. The fora have improved stakeholders\\u2019\\\\n                                          involvement in the implementation of the plans. One such success story\\\\n                                          of implementing basin IWRMD through stakeholder engagement is the\\\\n                                          construction of the Julius Nyerere Hydroelectric Power Project (JNHPP),\\\\n                                          where all stakeholders were engaged.\\\\n\\\\n                                          However, the implementation of sectoral plans is faced with inadequate\\\\n                                          coordination, as most sectors still do not adhere to IWRMD plans in\\\\n                                          implementing their respective water projects. This has led to sectoral\\\\n                                          conflicts on water use and inefficiency in water allocation. There has also\\\\n                                          been a lack of capacity and resources to reach and effectively engage\\\\n                                          constituents in remote areas with dispersed populations, especially in\\\\n                                          lower-level catchment areas.\\\\n\\\\n\\\\n\\\\n                6\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n1.2.1.2 Water Allocation, Use and Demand Management\\\\nEffective water allocation aims at ensuring equity in apportioning water to\\\\ndifferent uses. In allocating water, priority is always given to domestic use,\\\\nfollowed by the environment, and lastly, economic activities. The allocation\\\\nprocess is done through issuing water use permits. As of June 2024, 13,579\\\\npermits had been issued across all BWBs, significantly improving control\\\\nof water use and demand management. Challenges observed in water\\\\nallocation include inadequate compliance within permitted volumes of\\\\nwater and insufficient water demand management. Enhancing compliance\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nfor all water users, especially during the dry season, is essential.\\\\n\\\\nWater use and demand have risen over the last 20 years because of\\\\nincreased population and economic activities. In 2015, water demand\\\\nfor different sectors was 47.5 Billion Cubic Meters (BCM); by 2024, it had\\\\nreached 62 BCM. This is projected to increase to 80.2 BCM by 2035, with\\\\na risk of the country being subjected to water stress if no appropriate\\\\naction is taken. In 2002, the population of Tanzania was 33,584,607, which\\\\ntranslated to a water per capita of 3,678 m3\\/ca\\/yr. In 2022, the population\\\\nwas 59,851,357, with a water per capita of 2,105 m3\\/ca\\/yr.\\\\n\\\\nThe internationally acceptable threshold for water stress is 1,700 m3\\/ca\\/yr,\\\\nindicating that Tanzania is not water-stressed. However, water demand is\\\\nincreasing due to population growth, lifestyle changes, rapid urbanisation\\\\nand increased production across all sectors. Alongside the increasing\\\\ndemand, there is limited awareness of efficient water use across various\\\\nsectors, leading to the deterioration of water quality.\\\\n\\\\nThis calls for urgent actions to increase water productivity, prevent\\\\ndeterioration of water quality, make effective use of innovative technologies\\\\nand approaches to increase water availability, harness other freshwater\\\\nsources, increase strategic water storage to ensure water security,\\\\nmaximise seawater desalination and reuse of wastewater. These critical\\\\nareas were not emphasised in NAWAPO 2002.\\\\n\\\\n1.2.1.3 Water Sources Conservation and Pollution Control\\\\nWater source conservation and pollution control have been implemented\\\\nthrough various interventions, including the identification, demarcation,\\\\ngazettement and restoration of degraded water sources. This is on and\\\\nabove enforcing water and related laws and regulations; promoting\\\\nsustainable agricultural, mining and land use practices; efficient water\\\\n\\\\n\\\\n\\\\n    7\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          allocations; issuing discharge permits; and creating awareness. All these\\\\n                                          initiatives have supported the conservation and protection of water\\\\n                                          sources. By June 2024, 3,339 water sources had been identified; out of\\\\n                                          these, 350 have been demarcated and 62 gazetted as protected areas.\\\\n                                          In addition, 254 wastewater discharge permits have been granted to\\\\n                                          industries countrywide to control the quality standards of wastewater\\\\n                                          discharged into the environment.\\\\n\\\\n                                          Despite these efforts, water resource depletion and quality deterioration\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          remain a growing concern. Encroachment into water sources due to\\\\n                                          socio-economic developments and the impacts of climate change are\\\\n                                          now threatening their sustainability. This calls for a new policy direction\\\\n                                          especially in ensuring climate resilience in the water sector.\\\\n\\\\n                                          1.2.1.4 Dam Development and Management\\\\n                                          Water dams are constructed mainly to mitigate droughts\\u2019 effects, regulate\\\\n                                          flows, control floods, and supplement groundwater recharge. Tailing dams,\\\\n                                          commonly known as Tailings Storage Facilities (TSFs), are used to store\\\\n                                          effluents from mines. Dam owners are responsible for such structures\\u2019\\\\n                                          operation, maintenance, and surveillance, while the government is\\\\n                                          responsible for oversight. Dam safety management includes a system for\\\\n                                          monitoring the state of dams, physical threats to the dams, and issuing\\\\n                                          safety warnings when necessary. By June 2024, there were 651 formally\\\\n                                          registered dams with various capacities, 29 of which were large, and the\\\\n                                          remaining were of medium and small sizes. There are also 43 tailings dams.\\\\n\\\\n                                          The government has developed the Dam Safety Regulations of 2020 to\\\\n                                          guide the enforcement of dam safety. This includes monitoring, issuance of\\\\n                                          construction permits, registration of dams with and without safety risk and\\\\n                                          registration of Approved Professional Persons (APPs) who are authorised to\\\\n                                          deal with all aspects of dam safety management - designing, construction,\\\\n                                          commissioning, operation, maintenance and decommissioning.\\\\n\\\\n                                          The Dam Safety Regulations have enhanced safety measures in dam design,\\\\n                                          construction, operations, and maintenance. Following regular monitoring,\\\\n                                          risks associated with dam failure or leakage of hazardous water from\\\\n                                          tailing dams have also been minimised. The government will continue to\\\\n                                          improve dam development and management by preparing and enforcing\\\\n                                          technical guidelines, standards, and design manuals for water dams and\\\\n                                          tailings storage facilities.\\\\n\\\\n\\\\n\\\\n                8\\\\n                                               THE UNITED REPUBLIC OF TANZANIA\\\\n                                                            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n1.2.1.5 Transboundary Water Resources\\\\nTanzania shares with neighbouring countries several water bodies which\\\\ninclude the six transboundary lakes, namely Victoria, Tanganyika, Nyasa,\\\\nNatron, Chala and Jipe; eight transboundary rivers, namely Kagera, Mara,\\\\nMalagarasi, Momba, Mwiruzi, Ruvuma, Songwe and Umba; and eight\\\\ntransboundary aquifers, namely Kagera (Tanzania\\/ Uganda\\/ Rwanda),\\\\nKilimanjaro (Tanzania\\/ Kenya), Coastal Sedimentary Basin (Tanzania and\\\\nKenya), Karoo Sandstone (Tanzania\\/ Mozambique), Weathered Basement\\\\n(Tanzania\\/ Malawi\\/ Zambia), Tanganyika Aquifer (Tanzania\\/ Burundi\\/ DRC\\/\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nRwanda), Rift Aquifer (Tanzania\\/ Kenya\\/ Uganda) and Coastal Sedimentary\\\\nBasin (Tanzania\\/ Mozambique).\\\\n\\\\nTo ensure equity in sharing the transboundary water resources, riparian\\\\ncountries have formed regional and international transboundary\\\\ninstitutions. Tanzania is a strategic and active partner in these regional\\\\ninstitutions, through which programs and projects that benefit Tanzania\\\\nare implemented. The institutions include the Joint Songwe River Basin\\\\nCommission (SONGWECOM), Nile Basin Initiative (NBI), Joint Ruvuma Basin\\\\nCommission, Zambezi Watercourse Commission (ZAMCOM), Lake Victoria\\\\nBasin Commission (LVBC) and Lake Tanganyika Authority (LTA). Additionally,\\\\nTanzania, in collaboration with other member states, implements\\\\ndevelopment strategies and programs that include Africa Water Vision\\\\n2025, Nile Basin Initiative Strategy 2017-2027, African Ministers\\u2019 Council\\\\non Water Strategy 2018\\u20132030, Zambezi Watercourse Strategic Plan 2018-\\\\n2040, and Songwe River Basin Development Program.\\\\n\\\\nBenefits that Tanzania has gained from bilateral, regional and international\\\\ncooperation on transboundary waters include the development of capacity\\\\nfor water experts, implementation of the Lake Victoria Environmental\\\\nManagement Project (LVEMP), construction of the Rusumo Falls\\\\nHydroelectric Power Plant, Kenya - Tanzania Interconnection Project and\\\\nRegional Agricultural Trade and Productivity Project.\\\\n\\\\nOthers are the Ruvuma Shared Watercourses Support Project and the\\\\nproposed Lower Songwe Multipurpose Dam for producing 180 MW of\\\\nelectricity to be shared between Tanzania and Malawi. The latter will\\\\nprovide water for irrigating 6,200ha and for domestic use targeting the\\\\ncommunities in the area. Despite establishing these transboundary\\\\ncooperation institutions, inadequate capacity, incoherent and conflicting\\\\nlegal frameworks, differences in socio-economic setups, differential\\\\n\\\\n\\\\n\\\\n    9\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          capacities and priorities among member states, and geopolitics have led\\\\n                                          to competition over water allocation and uses. Also, the national capacity\\\\n                                          to manage transboundary water affairs is still limited.\\\\n\\\\n                                          1.2.2 Water Resources Development\\\\n                                          The country is endowed with vast water bodies such as rivers, lakes, wetlands,\\\\n                                          springs, and groundwater aquifers. They add up to annual renewable water\\\\n                                          resources estimated to be 126,000 BCM. This figure includes an estimated\\\\n                                          storage capacity of 40 BCM in 651 registered dams (as of June 2024). This\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          does not include the water storage capacity of unregistered, unmanaged\\\\n                                          and unmonitored reservoirs, particularly the numerous natural and man-\\\\n                                          made water pans used as water sources in rural areas. In this regard,\\\\n                                          the storage capacity is underestimated in the country\\u2019s renewable water\\\\n                                          resources because it does not account for the significant contribution\\\\n                                          of rainwater harvesting to socio-economic development. Despite these\\\\n                                          abundant water resources, NAWAPO 2002 did not adequately guide the\\\\n                                          development to ensure lasting water security in the country. Instead, the\\\\n                                          policy only provided guidelines for dam construction. The construction of\\\\n                                          strategic water storage facilities is necessary to increase water security,\\\\n                                          reduce the impacts of climate change and support disaster management\\\\n                                          through drought and flood management. This includes constructing a\\\\n                                          national water grid that draws water resources from the main water bodies\\\\n                                          for distribution across all parts of the country.\\\\n\\\\n                                          During the review of NAWAPO 2002, it was revealed that, although issues\\\\n                                          of preparedness against water-related disasters were provided, their\\\\n                                          implementation was not given priority. The construction of water storage\\\\n                                          infrastructure and Early Warning Systems (EWSs) was inadequate, and\\\\n                                          the Water, Sanitation, and Hygiene (WASH) sector was always unprepared\\\\n                                          to respond promptly and effectively due to a lack of funding. In addition,\\\\n                                          there has been disjointed planning of water-related projects implemented\\\\n                                          in different sectors, resulting in duplication of efforts and wastage of\\\\n                                          resources. Assessment of investments in inter-basin water transfer\\\\n                                          systems was noted to be insufficient to mitigate extreme water stress in\\\\n                                          heavily impacted areas or to distribute water-related risks more evenly\\\\n                                          across different parts of the country. There are also other untapped water\\\\n                                          resource potential, such as desalination and reuse of treated wastewater,\\\\n                                          including development of water pans which could augment the available\\\\n                                          water resources if targeted investments are made.\\\\n\\\\n\\\\n\\\\n\\\\n             10\\\\n                                              THE UNITED REPUBLIC OF TANZANIA\\\\n                                                           MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nGroundwater is one of the most indispensable natural resources and\\\\naccounts for about 17 per cent of available water resources in Tanzania,\\\\nwith numerous boreholes drilled to supplement surface water supply.\\\\nThe government gives groundwater special consideration and has been\\\\nexploring the resource. By June 2024, 172 potential groundwater sources\\\\nwere identified for development. Normally, groundwater helps to replenish\\\\nand maintain levels of surface water bodies such as lakes, streams and\\\\nrivers. Sustainable utilisation of groundwater has been challenging because\\\\nof inadequate data and continuous monitoring due to limited investment.\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nDeliberate initiatives must be taken to ensure sustainable investments in\\\\nthe monitoring of groundwater resources.\\\\n\\\\n1.2.3 Water and Wastewater Quality Management\\\\nWater and wastewater quality management is essential for ensuring that\\\\nquality is within acceptable standards for various uses and for control\\\\nof pollution. Quality management is implemented through monitoring\\\\nand assessment programs performed by Water Quality Laboratories in\\\\ncollaboration with other water quality stakeholders. The formulation and\\\\nimplementation of NAWAPO 2002 led to remarkable achievements in\\\\nwater and wastewater quality management. This include strengthening\\\\nwater quality analytical services through expansion of the service coverage\\\\nand scope, ISO\\/IEC 17025 accreditation of water laboratories on testing\\\\nand calibration, and upscaling of water treatment interventions for\\\\nimproving the quality of drinking water in the country. The Government\\\\ndeveloped National Guidelines on Drinking Water Quality Monitoring and\\\\nReporting, Operational Guidelines for Optimization of Water Treatment\\\\nChemical Dosing, and Guidelines for Preparation of Climate Resilient Water\\\\nSafety Plans for urban and rural water supply that support water quality\\\\nmanagement.\\\\n\\\\nMonitoring and assessment programs performed by Water Quality\\\\nLaboratories involve collection of samples from water sources, water\\\\nsupply systems and wastewater treatment systems. Data are collected\\\\nfrom water quality and pollution control stations established in water\\\\nbodies and water supply \\/distribution networks in various parts of the\\\\ncountry. The collected data are analysed to generate useful information\\\\nfor planning and informed decision-making on the development of water\\\\nsources to determine the suitability of water for various intended uses.\\\\n\\\\n\\\\n\\\\n\\\\n    11\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          In many parts of the country, deterioration of water quality caused by\\\\n                                          human development activities is evident. The water quality assessments\\\\n                                          have revealed the presence of harmful chemicals in water from industrial\\\\n                                          processing, mining and agriculture. There is concern about emerging\\\\n                                          contaminants in water sources which are not fully regulated. The long-\\\\n                                          term effects of these contaminants on human health and ecosystems\\\\n                                          are still being studied. Furthermore, there is inadequate water quality\\\\n                                          management - a lack of regular water quality monitoring and assessment,\\\\n                                          particularly in water sources, a lack of ambient water quality standards\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          and inadequate water pollution control practices. This leads to further\\\\n                                          deterioration of water quality, limits effectiveness and increases the cost\\\\n                                          of water treatment. Polluted water, as well as water-borne and related\\\\n                                          diseases, not only cause misery, morbidity and mortality but also impose\\\\n                                          high socio-economic costs through loss of human productivity and potential.\\\\n                                          Water quality management is also affected by low institutional capacity,\\\\n                                          inadequate implementation and enforcement of the legal provisions for\\\\n                                          water quality management, limited understanding and utilisation of water\\\\n                                          quality data, and inadequate information sharing among institutions and\\\\n                                          communities.\\\\n\\\\n                                          Water quality management in water supply and distribution networks in\\\\n                                          both urban and rural areas is challenged by pollution from both point and\\\\n                                          non-point sources; inadequate monitoring and assessment systems; non-\\\\n                                          compliance with drinking water standards by some utilities; inadequate\\\\n                                          water treatment; limited research on drinking water quality, storage\\\\n                                          and treatment; and a lack of adapted and practicable technologies and\\\\n                                          strategies for water quality management in rural areas for both man-\\\\n                                          made facilities such as small dams and natural water collecting facilities.\\\\n                                          Water quality management in water supply networks for rural areas was\\\\n                                          not stipulated in NAWAPO 2002. The new version has emphasised water\\\\n                                          quality in rural projects.\\\\n\\\\n                                          The government and other stakeholders have taken initiatives to manage\\\\n                                          wastewater quality and control pollution. These include advising on\\\\n                                          ways to legally manage discharges of pollutants from various sources to\\\\n                                          protect public health and integrity of ecosystems. The Government has\\\\n                                          also been regularly reviewing wastewater discharge standards to enhance\\\\n                                          the management of effluent prior to discharge to the environment. These\\\\n                                          initiatives have achieved only 60 per cent compliance. Some industries\\\\n                                          have no wastewater treatment facilities, resulting in toxic substances\\\\n\\\\n\\\\n\\\\n             12\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nbeing discharged directly into the environment. Haphazard wastewater\\\\ndischarges have contaminated water sources, threatening public and\\\\necosystem health. This highlights the need for more efforts to increase\\\\ncompliance. There is also limited research and development on wastewater\\\\ntreatment technologies leading to inadequate and ineffective proactive\\\\nmeasures to curb pollution. Similarly, water quality management facilities\\\\nwere not given priority in rural areas during the implementation of NAWAPO\\\\n2002. This was because the small projects that were implemented in such\\\\nlocalities had no serious pollution challenges. Also, there was no priority in\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nmanaging wastewater in rural areas as people used traditional pit latrines.\\\\nHowever, with change of lifestyles in rural areas where modern houses\\\\nare being built, there is a need to address management of wastewater and\\\\nhence the reviewed policy will give high priority to wastewater management\\\\nin both rural and urban areas.\\\\n\\\\n1.2.4 Access to Water Supply Services and Water Management\\\\nSystems\\\\n\\\\n1.2.4.1 Access to Water Supply Services\\\\nAccess to water supply services for rural and urban populations has\\\\nincreased since 2002. In rural areas, access has increased from 50 per\\\\ncent in 2002 to 83 per cent in June 2024. This improvement is as a result\\\\nof Government investment in the construction of new water projects,\\\\nand rehabilitation and extension of existing ones. As of June 2024, 2,943\\\\nwater projects with 169,515 water points were constructed in rural areas,\\\\nincluding 194,591 house connections. Some of the water projects being\\\\nconstructed in the rural areas are big enough to serve more than one\\\\nvillage. Also, other villages benefit from water transmission mains for\\\\ntowns. These initiatives have enabled 34,950,360 out of 39,232,990 people,\\\\nas per the 2022 census, to access water supply services in rural areas.\\\\n\\\\nDespite these achievements, some challenges are notable. NAWAPO 2002\\\\ndirectives require a water point to serve 250 people within a distance of not\\\\nmore than 400 meters. This has proved impractical because of the scattered\\\\nnature of settlements. Furthermore, small water projects were intended\\\\nto serve small communities, with beneficiaries contributing to investment\\\\ncosts. However, population growth and water demand have outstripped\\\\nadvances in water supply. Currently, the Government is developing large\\\\nand high-tech projects intended to serve many villages. With these types\\\\nof projects, it is difficult for communities to contribute to investing and\\\\n\\\\n\\\\n\\\\n    13\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          operating new water schemes or extend their water supply service outside\\\\n                                          areas designated by the Government at the time. Therefore, the NAWAPO\\\\n                                          2002 directives were not sufficient to respond to rural developments. In\\\\n                                          this regard, the policy need to be reviewed to include more adaptable\\\\n                                          and multi-pronged strategies to address the rapidly changing situations\\\\n                                          especially in rural areas.\\\\n\\\\n                                          In urban areas, access to water supply services increased from 73% in 2002\\\\n                                          to 91.6% in 2024. This improvement results from Government initiatives to\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          invest in water supply infrastructure, including developing water sources,\\\\n                                          transmission mains, water treatment plants, storage reservoirs or tanks,\\\\n                                          distribution networks, customer connections and water meters. These\\\\n                                          efforts have significantly expanded the water networks in regional centres,\\\\n                                          which have extended from 8,662 kilometres in 2015 to 27,534 in 2024.\\\\n\\\\n                                          Likewise, the cumulative storage tanks capacity increased from 712,933\\\\n                                          cubic meters to 857,900 cubic meters by 2024. Water supply services in\\\\n                                          urban areas are expected to continue improving, as most regional water\\\\n                                          utilities have the potential to expand their customer base, generating more\\\\n                                          revenue to fund service extensions and new connections.\\\\n\\\\n                                          Despite the achievements in providing water services to urban areas\\\\n                                          under the NAWAPO 2002, the assessment shows that the quantity of\\\\n                                          water available per person remains below national standards, and some\\\\n                                          households still need to travel long distances to fetch water. Additionally,\\\\n                                          the assessment highlights Tanzania\\u2019s growing population and economy.\\\\n                                          Population is expected to reach 138 million by 2050, with 50 per cent living\\\\n                                          in urban areas. There will thus be a significant increase in water demand.\\\\n                                          Battered water infrastructures and increasing population density due to\\\\n                                          unplanned urbanisation present further challenges.\\\\n\\\\n                                          The rapid population growth has outpaced the capacity of existing\\\\n                                          infrastructure, reducing the quality of water services. Economic growth\\\\n                                          in urban areas has also increased the water demand. As cities expand,\\\\n                                          slum-like peri-urban areas have emerged, requiring new investments in\\\\n                                          water supply infrastructure. The deterioration of existing infrastructure\\\\n                                          has resulted in higher Non-Revenue Water, thus undermining the ability\\\\n                                          of water utilities to cover operational and maintenance costs.\\\\n\\\\n\\\\n\\\\n\\\\n             14\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n1.2.4.2 Water for Other Uses\\\\nNAWAPO 2002 outlined three key areas of water demand i.e domestic use,\\\\nenvironmental needs and economic activities. During its implementation,\\\\nthe policy focused primarily on meeting water needs for domestic and\\\\npastoral communities. However, with significant rural and urban economic\\\\ngrowth, it is necessary to widen the scope to focus more on ensuring water\\\\nsecurity rather than meeting water needs.\\\\n\\\\nCurrently, water demand for agriculture, hydropower, mining industry,\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nenvironmental services, and other sectors is rising due to increased\\\\neconomic activities. Despite the importance of water in these sectors, there\\\\nhas been minimal cross-sectoral planning on water issues. Joint planning is\\\\nuseful especially to avoid duplication of efforts e.g inadvertently allocation\\\\nof a water source for multiple purposes of which could have a direct impacts\\\\non downstream water users. Joint planning would trigger early warning\\\\nsystems for overuse of water sources, enhance water productivity, and\\\\nprevent duplication and wastage of public resources. The revised policy\\\\nemphasises cross-sectoral coordination in design and implementation of\\\\nall water-related projects.\\\\n\\\\nAnother area not sufficiently addressed in NAWAPO 2002 is the provision\\\\nof water services to public institutions such as schools, markets and\\\\nhealth facilities. Adequate water supply to these facilities is essential for\\\\nhygiene, drinking, medical use, cleaning, sanitation, and overall well-being\\\\nof surrounding environment. By 2019, through the WASH initiative, the\\\\nGovernment had provided water access to 2,105 health facilities through\\\\ntap connections and 3,220 through rainwater harvesting storage tanks.\\\\nAdditionally, 8,832 out of 19,995 schools gained access to clean and safe\\\\nwater through tap connections, wells, and rainwater harvesting storage\\\\ntanks. Integrating water supply, sanitation services and hygiene education\\\\nhas been a priority in improving health conditions, particularly in rural\\\\nareas. However, the lack of inter-sectoral planning has led to gaps in\\\\naccessing clean water in some institutions.\\\\n\\\\nWater supply for livestock is also crucial in rural areas where over 70%\\\\nof Tanzania\\u2019s livestock is reared. Water projects must, therefore, include\\\\nprovision for watering livestock, as prescribed and outlined in the Design,\\\\nConstruction, Supervision, and Operation and Maintenance Manual\\\\n(2020). By June 2024, the Government had constructed 1,384 Charco dams\\\\nand 458 cattle troughs and drilled 103 boreholes for providing water to\\\\n\\\\n\\\\n\\\\n    15\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          livestock. Inadequate water supply for livestock leads to herders migrating\\\\n                                          in search of water. This can result in land degradation, contamination and\\\\n                                          destruction of water sources and infrastructure, and conflicts among water\\\\n                                          users. The reviewed policy includes directives to promote water supply for\\\\n                                          livestock in rural areas through inter-sectoral cooperation and dialogue\\\\n                                          with all stakeholders.\\\\n\\\\n                                          1.2.4.3 Management of Water Supply Services\\\\n                                          The Water Supply and Sanitation Act No. 5 of 2019 assigns responsibility for\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          water supply and sanitation services to water entities. In rural areas, this\\\\n                                          mandate is bestowed to Community-Based Water Supply Organisations\\\\n                                          (CBWSOs), which manage water schemes, collect water tariffs, and manage\\\\n                                          operational and maintenance (O&M) costs. CBWSO leadership is elected\\\\n                                          at village meetings and is tasked to employ a technician for maintenance\\\\n                                          works and an accountant to manage funds. As of June 2024, 1,018 CBWSOs\\\\n                                          were registered, serving 9,203 villages. The Rural Water Supply and\\\\n                                          Sanitation Agency (RUWASA) was also established to improve water and\\\\n                                          sanitation services in rural areas. It is mandated to construct and monitor\\\\n                                          rural water projects and ensuring the sustainability of rural water supply\\\\n                                          services. While RUWASA oversees and regulates rural water services, its\\\\n                                          dual role in construction and regulation may create conflict of interest or\\\\n                                          lack of impartiality in their mandate.\\\\n\\\\n                                          In rural areas, water service beneficiaries are expected to contribute\\\\n                                          to investment costs and pay tariffs to cover O&M costs. Some water\\\\n                                          schemes function well, while others struggle because of poor resource\\\\n                                          management. This includes disinterest among people in paying for water\\\\n                                          services, inadequate capacity of CBWSO leadership, and theft or damage\\\\n                                          of water infrastructure. All these threaten sustainability of rural water\\\\n                                          service delivery. The review of NAWAPO will address these challenges in\\\\n                                          rural water services especially operational and regulatory issues.\\\\n\\\\n                                          In urban areas, the Minister responsible for Water is empowered to\\\\n                                          establish Water Supply and Sanitation Authorities (WSSAs). By 2024,\\\\n                                          there were 88 WSSAs providing water and sanitation services in urban\\\\n                                          centres. Their primary function is to ensure efficient and equitable water\\\\n                                          supply by implementing Water Demand Management (WDM) strategies.\\\\n                                          These include technological, economic, institutional, and communication\\\\n                                          measures to promote sustainable water use. To maintain high-quality\\\\n                                          water supply services in urban areas, WSSAs must minimise non-revenue\\\\n\\\\n\\\\n\\\\n             16\\\\n                                                 THE UNITED REPUBLIC OF TANZANIA\\\\n                                                              MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nwater (NRW), increase water production, assess water use through\\\\nwater meters, apply appropriate tariffs, and set aside funds for service\\\\nexpansion and infrastructure rehabilitation. The Government typically\\\\ncarries out major water projects requiring significant investment in\\\\ncollaboration with development partners. The National Water Fund (NWF)\\\\nprovides financial support to WSSAs through soft loans for rehabilitation\\\\nand service expansion projects. Between 2015 and 2024, several major\\\\nwater projects were completed, including the Tabora\\u2013Igunga\\u2013Nzega,\\\\nMugango\\u2013Kiabakari\\u2013Butiama, Orkesumet and Arusha City projects. These\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nefforts reduced national average of NRW from 43% to 36.6%, increased\\\\nthe metering ratio from 95.4% to 99.9%, boosted water production from\\\\n234.50 MCM to 334.7 MCM per year, and promoted the use of appropriate\\\\ntariffs to minimise wasteful water use.\\\\n\\\\nChallenges in urban water service provision include the increasing water\\\\ndemand, which is not matched by the expansion of supply services. For\\\\ninstance, cumulative water demand in all regional centres increased from\\\\n435.04 MCM in 2015 to 681.87 MCM in 2024 due to rapid urbanisation,\\\\nincreased economic activities, and inefficient water use. While the\\\\nGovernment continues to establish water projects and commission them to\\\\nWSSAs, the authorities are responsible for collecting water tariffs and using\\\\nthe same to cover O&M costs, including minor rehabilitation. Investment\\\\nin major infrastructure rehabilitation remains the responsibility of the\\\\nGovernment. Despite the substantial investments by the Government,\\\\nleakages and illegal connections contribute to high NRW, leading to\\\\nrevenue loss, poor service delivery, and water rationing. The revised policy\\\\nwill emphasise effective water supply management to ensure sustainability\\\\nand high-quality water services in urban areas.\\\\n\\\\n1.2.5 Sanitation\\\\nSanitation encompasses a broader system of managing waste and ensuring\\\\na clean environment and prevent the spread of diseases. It includes\\\\nproviding and maintaining facilities for the proper disposal of human\\\\nexcrement, managing wastewater, and promoting good hygiene practices.\\\\nIt involves constructing and maintaining toilets and latrines, waste collection\\\\nand treatment, installing hygiene facilities, and public education on health\\\\nand cleanliness. Implementing and promoting sanitation in the country,\\\\nincluding hygienic behaviour and solid waste and stormwater management,\\\\nis crucial because they are all related to human health, cleanliness and\\\\nenvironmental entegrity. All these require collaborative actions among\\\\n\\\\n\\\\n\\\\n    17\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          various actors, including the Ministry of Health, which deals with sanitation\\\\n                                          and hygiene in rural areas; the Ministry of Education, dealing with school\\\\n                                          sanitation and hygiene; and Local Governments, dealing with sanitation\\\\n                                          in their areas, including solid waste and stormwater management. There\\\\n                                          has been fragmented planning among these key stakeholders dealing with\\\\n                                          overall issues of sanitation and effective coordination is required.\\\\n\\\\n                                          Wastewater is generated from different sources including domestic water\\\\n                                          use which 80% of its water supplies is converted to wastewater. Other\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          sources include industrial processes and mining. Wastewater usually\\\\n                                          contains toxic substances or biological process inhibitors. Therefore, it\\\\n                                          must be treated before being discharged into the environment. In the last\\\\n                                          20 years, there has been a slight increase in access to sanitation facilities\\\\n                                          and services to safely dispose of human excreta. By 2024, 11 regional\\\\n                                          centres out of 26 had constructed sewered sanitation infrastructure with\\\\n                                          an average access of 13 per cent. The regions are Dodoma, Songea, Iringa,\\\\n                                          Arusha, Tanga, Moshi, Mbeya, Tabora, Morogoro, Mwanza and Dar es\\\\n                                          Salaam. The Government has been constructing sewerage networks and\\\\n                                          waste stabilisation ponds in different areas of the country.\\\\n\\\\n                                          Construction of conveyance infrastructure has increased the length of\\\\n                                          the sewer network from 652.29 kilometres in 2010 to 1,477.63 kilometres\\\\n                                          in 2024 in regional centres. The remaining 15 regions use non-sewered\\\\n                                          sanitation, and in some townships, the Government has constructed\\\\n                                          faecal sludge treatment facilities. These are Kahama, Nansio, Sengerema,\\\\n                                          Sumbawanga, Kigoma, Geita, Lamadi, Musoma, Magu, Misungwi, Lindi,\\\\n                                          Bukoba and Arusha. Emptying and transporting faecal sludge in areas\\\\n                                          without a sewerage network is through public and private exhauster trucks.\\\\n\\\\n                                          During the implementation of NAWAPO 2002, although there was some\\\\n                                          emphasis on constructing sewerage systems in urban centres, it was\\\\n                                          insufficient because more attention was on providing potable water\\\\n                                          and relatively low investments were channeled to sanitation. This has\\\\n                                          resulted in inadequate sewerage network and treatment facilities, unsafe\\\\n                                          sludge disposal and dilapidated sewerage infrastructure. Investment in\\\\n                                          sanitation infrastructure has been low because of high costs and limited\\\\n                                          financial resources. Access to sewage removal and treatment services\\\\n                                          has, therefore, been unsatisfactory. For example, by June 2024, availability\\\\n                                          of sewerage service was only 13 per cent in regional centres. For other\\\\n                                          urban areas, sewage disposal service is being provided using wastewater\\\\n\\\\n\\\\n\\\\n             18\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\ntrucks. Another challenge in wastewater management is ineffective\\\\nregulatory monitoring and unreliable enforcement of minimum quality of\\\\nservice in each segment of the non-sewered sanitation chain. This results\\\\nin non-emptiable toilets, leaking containments, unsafe emptying and\\\\ntransportation facilities and inadequate faecal sludge treatment facilities.\\\\nFor rural areas, NAWAPO 2002 remained silent, and no investment has\\\\nbeen made in sewage disposal in such localities. Communities use pit\\\\nlatrines, which are abandoned when they are full. Enhanced socio-economic\\\\ndevelopment in rural areas has empowered people to construct modern\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nhouses requiring wastewater treatment facilities, including faecal sludge\\\\ncollection. Untreated wastewater adversely affects the environment,\\\\ncausing contamination and pollution of surface and groundwater sources.\\\\nThe reviewed policy considers wastewater infrastructure construction in\\\\nrural and urban areas.\\\\n\\\\n1.2.6 Private Sector Participation\\\\nThere has been a deliberate effort by the Government to enhance Private\\\\nSector Participation (PSP) in the water sector especially in supporting the\\\\nprovision of goods and water services to the public. The Government\\\\nhas multiple national responsibilities and faces financial constraints and\\\\nhence it\\u2019s prudent to seek alternatives sources of funds to support the\\\\nwater sector. The private sector is often more advanced in leveraging skills\\\\nand efficiencies - bringing in new technologies, sharing risks and providing\\\\nfinancing to accelerate development that aligns with the inclusive objectives\\\\nof the Government. In Tanzania, the government has created an enabling\\\\nenvironment for PSP, including the enactment of the Public Private\\\\nPartnership Policy (2009), the Public Private Partnership (Amendment)\\\\nAct, 2023, and the Public Private Partnership Regulations (2020). NAWAPO\\\\n2002 identifies the private sector as among the key partners in supporting\\\\ngovernment initiatives to provide water supply and sanitation services.\\\\n\\\\nNAWAPO 2002 emphasises the construction of water infrastructure,\\\\nrehabilitation and building the capacity of WSSAs to operate commercially\\\\nas areas that the private sector could invest and or add value. Various\\\\ninitiatives have been undertaken to implement the policy directive,\\\\nincluding capacity building at all levels in the sector through PPP training,\\\\ndevelopment of project concept notes, and convening forums to discuss\\\\nPSP development. Achievements realized include motivated Implementing\\\\nAgencies (IAs) to engage the private sector, some of which have already\\\\ndeveloped a pipeline of projects. Tanga WSSA has managed to prepare\\\\n\\\\n\\\\n\\\\n    19\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          a project that has raised about TZS 53 billion through Green bonds, and\\\\n                                          other WSSAs are preparing projects of the same nature. Despite these\\\\n                                          achievements, PSP in water resources has been limited, relying mainly\\\\n                                          on corporate social responsibility (CSR) activities, consultancy services,\\\\n                                          project construction and provision of goods and services. NAWAPO 2002\\\\n                                          evaluation report shows that the private sector not motivated to invest\\\\n                                          and operate water projects due to relatively high investment costs and\\\\n                                          long payback periods. Moreover, Section 76 of the Water Supply and\\\\n                                          Sanitation Act No. 5 of 2019 and Regulation 14(1) of the Water Supply\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          Regulation of 2019 requires a private entity to vacate a service area once\\\\n                                          a water authority extends its operations to the area earlier serviced by the\\\\n                                          private service provider. These legal directives discourage private sector\\\\n                                          investment and operation in water projects.\\\\n\\\\n                                          To attract PSPs to the water sector, the reviewed policy will prioritise creating\\\\n                                          a conducive and supportive environment to encourage private sector\\\\n                                          engagement and investments. The Government will create opportunities\\\\n                                          for private sector partners as part of an integrated strategy, placing them\\\\n                                          alongside government funded water schemes in non-viable areas.\\\\n\\\\n                                          NAWAPO 2002 also directed the privatisation of water supply and sewerage\\\\n                                          entities in small urban centres to improve water supply and sewerage\\\\n                                          services. According to the policy, water supply and sewerage entities in small\\\\n                                          urban centres were to be encouraged to form private liability companies\\\\n                                          or any other legal autonomous commercial arrangement. Attempts to\\\\n                                          privatise service provision in other sectors showed unfavourable results\\\\n                                          and hence the policy directive was not implemented. This prompted the\\\\n                                          Government to change the mode of engagement from privatisation to\\\\n                                          public-private partnerships. PPP policy, legislation and guidelines have\\\\n                                          been prepared and are used to engage the private sector. The review of\\\\n                                          this policy considers changing the modality of private sector engagement\\\\n                                          in line with the PPP enabling environment.\\\\n\\\\n                                          1.2.7 Research and Technology Development\\\\n                                          NAWAPO 2002 emphasised strengthening the capacity of Research\\\\n                                          and Development (R&D) through enhancing collaboration with sector\\\\n                                          stakeholders and local and international research institutions. The objective\\\\n                                          was to undertake strategic water sector research initiatives, establish water\\\\n                                          resources research and technological development centres, and encourage\\\\n                                          local researchers to take lead in such strategic initiative. To this end, the\\\\n\\\\n\\\\n\\\\n             20\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nGovernment has established the Water Resources Center of Excellence\\\\n(WRCoE) and conducted a few research studies on water-related issues.\\\\nResearch institutions, including the University of Dar es Salaam, Sokoine\\\\nUniversity of Agriculture (SUA), Nelson Mandela African Institution of\\\\nScience and Technology and others, have continued to conduct academic\\\\nresearch in the water sector. However, the challenge is bridging the gap\\\\nbetween academic findings and practical applications that could directly\\\\nbenefit the sector. Furthermore, the Water Institute (WI), a college under\\\\nthe Ministry of Water, undertakes research related to water and sanitation,\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nbut the scope and dissemination of its findings remain limited. Similarly, the\\\\nNgurdoto Defluoridation Research Center has produced groundbreaking\\\\ninnovations in safe water provision. However, the Center\\u2019s potential is not\\\\nfully exploited. A stronger focus on prioritising and facilitating strategic\\\\nresearch and development within the water and sanitation sector is\\\\nimperative to address these challenges. It is also acknowledged that most\\\\nof the research undertaken is externally funded through partnerships\\\\nwith international institutions. For the water sector to maximumly benefit\\\\nfrom local research efforts, a dedicated commitment is required to fund\\\\nstrategic research in earmarked sectoral areas of concern through public\\\\nresources. This is also supported by the NAWAPO 2002 assessment report\\\\nthat highlights that the reviewed policy will need to motivate the sector to\\\\nadopt local emerging innovations and technologies by investing in R&D. In\\\\nthe long run, this will generate additional revenue and improve operational\\\\nefficiency.\\\\n\\\\n1.2.8 Cross-Cutting Issues\\\\n\\\\n1.2.8.1 Environmental and Climate Change Resilience\\\\nNAWAPO 2002 directed environmental and climate change issues to be\\\\nconsidered during the planning, preparation and implementation of water\\\\nresource management and in water supply and sanitation projects. This\\\\nis due to inherent impacts of climate change on water availability in the\\\\ncountry. Water is a finite resource with existential importance and currently\\\\nunder pressure, getting scarcer, due to growing population and increased\\\\nmulti-sectoral demands. Primary livelihood and development strategies\\\\nstrongly rely on extracting natural resources from the environment,\\\\nwith limited options for decoupling economic growth and resource use.\\\\nThe increase in temperature, due to climate change, has affected water\\\\navailability as well as functionality and sustainability of some water supply\\\\nand sanitation works. Temperatures over the highland areas have been\\\\n\\\\n\\\\n\\\\n    21\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          rising, while rainfall has been decreasing amid seasonal shifts in rainfall\\\\n                                          patterns in most parts of the country. Other areas have continued to\\\\n                                          receive heavy rains leading to hazardous floods. These are attributed to\\\\n                                          changing of hydrological cycle triggered by increase in temperatures. The\\\\n                                          impacts of such changes are observed not only in water resources but also\\\\n                                          in water and sanitation works.\\\\n\\\\n                                          To ensure environmental issues are considered, the Government has\\\\n                                          developed various environmental and social safeguard frameworks to\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          protect and manage water sources and associated water and sanitation\\\\n                                          infrastructure. These include the National Climate Change Strategy\\\\n                                          of 2021, the Environmental and Social Management Framework, the\\\\n                                          Resettlement Management Framework, the Climate Resilient Water Safety\\\\n                                          Plans Preparation Guidelines, and Guidelines for Good Environmental and\\\\n                                          Social Practices for the Water and Sanitation Sector. These frameworks\\\\n                                          have facilitated government\\u2019s implementation of the Simiyu Climate\\\\n                                          Resilience Project, Climate Adapted Urban Infrastructure, and Integrated\\\\n                                          Water Resources Management Programs.\\\\n\\\\n                                          The construction of the Kidunda dam along the Ruvu River is intended\\\\n                                          address the impacts of climate change on river flows in the Ruvu river. The\\\\n                                          frameworks and other initiatives have facilitated building the resilience\\\\n                                          of communities that have adversely been impacted by climate change. In\\\\n                                          addition, the frameworks have improved compliance to environmental\\\\n                                          and social safeguard mechanisms through training, providing technical\\\\n                                          support on enhancing compliance of water and sanitation projects to\\\\n                                          guidelines on environmental and social safeguard, and undertaking\\\\n                                          environmental audits on the implementing agencies.\\\\n\\\\n                                          Furthermore, compliance with environmental and social safeguard\\\\n                                          requirements to address hydrological ecosystems and climatic matters\\\\n                                          has gradually improved due to increased awareness among water and\\\\n                                          sanitation practitioners. The impact of compliance with environmental and\\\\n                                          social safeguard requirements in the water sector cuts across different\\\\n                                          sectors and hence enhances collective initiatives on environmental\\\\n                                          conservation and protection. These have led to social stability, protection,\\\\n                                          and conservation of water and sanitation infrastructure and natural\\\\n                                          systems.\\\\n\\\\n                                          Despite the government\\u2019s efforts to address concerns on environmental\\\\n                                          and social safeguard in the water sector, land degradation, deforestation,\\\\n\\\\n\\\\n             22\\\\n                                               THE UNITED REPUBLIC OF TANZANIA\\\\n                                                            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nand pollution have continued to be a challenge.\\\\nBesides, competing water use demands, inadequate enforcement of\\\\nwastewater management and implementation of some projects without\\\\nadherence to environmental and social guidelines have led to environmental\\\\ndegradation, pollution and social grievances, which significantly affect\\\\nsocio-economic development.\\\\n\\\\nSome of the existing rainwater harvesting structures, such as charco\\\\ndams, are located specifically to intercept surface water run-off of which\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nis expected to flow downstream for environment and other water uses. In\\\\nthis regard, research is needed to explore sustainability issues, address\\\\nenvironment concerns and possibility of utilising such waterworks in\\\\neffectively channelling and managing floodwaters, feeding secondary\\\\nwater storage systems and increasing drought resilience.\\\\n\\\\nIn addition, natural disasters (floods and droughts) induced by climate\\\\nvariability and climate change has led to various environmental impacts\\\\nincluding decreased or increased runoff in rivers, prolonged dry periods,\\\\nerratic rainfall, and sea level rise. The latter has often led to seawater\\\\nintrusion affecting freshwater resources along the coastal areas. The\\\\nreviewed policy will promote strengthening environmental safeguards and\\\\nclimate resilience in the water sector to overcome identified challenges.\\\\n\\\\n1.2.8.2 Gender\\\\nNAWAPO 2002 emphasised active and effective participation of women and\\\\nmen in rural water supply programs through fair representation of women\\\\nin village water-user entities. Water supply programs were established\\\\nbased on what both men and women in rural communities knew, wanted,\\\\ncould manage, maintain and pay for. This was on and above raising\\\\nawareness, training, and empowering women to actively participate at\\\\nall levels of implementing water programmes, including decision-making,\\\\nplanning, supervision, and management.\\\\n\\\\nThis policy directive has been implemented where gender has been\\\\nmainstreamed ensuring equity and equality in managing water resources\\\\nand services related to access to clean and safe water as well as sanitation\\\\nservices. In 2005, the Government prepared the National Strategy for\\\\nGender Development (NSGD), which provides guidance on promoting\\\\nequity, equality and empowerment of women, men and vulnerable\\\\ngroups. Also, the Ministry of Water prepared a gender strategy to guide the\\\\nparticipation of women and men in management, decision-making, use\\\\n\\\\n\\\\n    23\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          and operation of water resources, water supply and sanitation services.\\\\n                                          In implementing the policy directive, gender mainstreaming in rural water\\\\n                                          supply has shown notable success in enhancing equity and efficiency.\\\\n                                          Women, often the primary water collectors and users in rural areas, have\\\\n                                          continued to be involved in planning and decision-making. This has made\\\\n                                          water projects more responsive to the community\\u2019s needs. For example,\\\\n                                          gender equity has been noted in management positions, decision-making,\\\\n                                          operations and implementation of water projects in the country. As of\\\\n                                          2022, out of 9,207 employees in water sector institutions, 2,762 are women,\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          equal to 30 per cent of the total workforce. Despite women increasing their\\\\n                                          presence in decision-making roles in the water sector, progress has been\\\\n                                          uneven across the different institutions. In the 2020-2024 period, women\\\\n                                          accounted for an average of 35 per cent of Ministry of Water leadership,\\\\n                                          37 per cent of the National Water Fund, 22 per cent of Basin Water Board\\\\n                                          directors, and six per cent of WSSA leadership. Within RUWASA, women\\\\n                                          comprise 28 per cent of managers and directors and 14 per cent of regional\\\\n                                          managers.\\\\n\\\\n                                          Additionally, gender considerations in the water sector have empowered\\\\n                                          women, increasing their participation in local governance and development\\\\n                                          activities. This inclusive approach ensures that water supply systems are\\\\n                                          more effectively managed and contributes to broader social and economic\\\\n                                          benefits by fostering gender equality and community resilience. Despite\\\\n                                          the achievements, women and girls remain disproportionally affected\\\\n                                          by water challenges, for example, carrying the burden of care duties for\\\\n                                          family members suffering from water-borne diseases, lack of good hygiene\\\\n                                          facilities in schools, and spending more time and effort to collect water\\\\n                                          and other resources from degrading ecosystems. The reviewed policy\\\\n                                          will continue to assess gender disparities in decision-making and access\\\\n                                          to water to ensure the water sector draws on the capabilities of women,\\\\n                                          youth and the disable and responds to their needs.\\\\n\\\\n                                          1.2.8.3 Good Governance\\\\n                                          NAWAPO 2002 does not have directives for promoting good governance\\\\n                                          in the water sector. However, good governance practices have been\\\\n                                          adhered to using various guidelines issued by the Ministry that are aligned\\\\n                                          with the same. Good governance in the water sector has improved the\\\\n                                          sustainable and equitable use and distribution of water while ensuring\\\\n                                          better use of water resources and effective delivery of water supply and\\\\n                                          sanitation services. Accountability and integrity in the provision of water\\\\n\\\\n\\\\n\\\\n             24\\\\n                                             THE UNITED REPUBLIC OF TANZANIA\\\\n                                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nservices have improved through greater transparency regarding water\\\\nuse fees, active stakeholders\\u2019 engagement and effective management in\\\\nimplementation of water supply and sanitation projects. There has been\\\\nincreased community participation in water resources management and\\\\nwater supply and sanitation services through community governing bodies\\\\nsuch as WSSA Boards, Water Users Associations (WUAs) and CBWSOs that\\\\nadhere to good governance. This has increased communities\\u2019 awareness of\\\\nwater charges, thus making them more willing to pay for various services.\\\\n\\\\n\\\\n\\\\n\\\\n                                                                               National Water Policy 2002 Version 2025\\\\nGood governance in the water sector is a priority issue and hence the\\\\nreviewed policy has provided targeted policy statements for promoting\\\\nits functionality in all thematic areas of management and development of\\\\nwater resources, water and wastewater quality, and water supply services\\\\nprovision.\\\\n\\\\n\\\\n\\\\n\\\\n    25\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n             26\\\\n   Chapter\\\\n\\\\n\\\\n    2\\\\n\\\\n                  National Water Policy 2002 Version 2025\\\\nRationale,\\\\nVision, Mission\\\\nand Objectives\\\\n\\\\n\\\\n\\\\n\\\\n                               27\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                RATIONALE, VISION, MISSION AND OBJECTIVES\\\\n\\\\n                                          2.1 Rationale and Justification\\\\n                                          The foundation of NAWAPO 2002 was the management of water resources\\\\n                                          and delivery of water supply in both urban and rural areas. However, over\\\\n                                          the last twenty-three years of implementing the policy, the water sector\\\\n                                          has experienced biophysical changes and socio-economic transformation\\\\n                                          in urban and rural areas, requiring a new policy focus on ensuring water\\\\n                                          security and service delivery. The new policy focus must also align with the\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          Tanzania Development Vision 2050, emphasising climate resilience and\\\\n                                          water security. The latter may include constructing strategic water storage\\\\n                                          and reticulated infrastructure for enhancing water security and resilience\\\\n                                          against risks associated with climate change and water-related disasters.\\\\n                                          In particular, some of the key gaps that were noted in NAWAPO 2002 and\\\\n                                          have been addressed in the revised policy include:\\\\n\\\\n                                          2.1.1 Community Contribution and Management of Water Projects in\\\\n                                          Rural Areas\\\\n                                          NAWAPO 2002 had provided that, for the sustainability of rural water\\\\n                                          schemes, they were best owned and managed by the communities. The\\\\n                                          policy also required beneficiaries in rural areas to contribute financially\\\\n                                          or in kind to the construction of water supply projects. However, due to\\\\n                                          diminished freshwater sources caused by climate change and impacts of\\\\n                                          land use change, the government is currently constructing large water\\\\n                                          projects that draw water from reliable sources that are not necessarily\\\\n                                          close to service delivery areas. The construction, technology and operation\\\\n                                          costs of these projects are high and need special attention and expertise.\\\\n                                          Hence, communities cannot own or operate them. The revised policy\\\\n                                          provides for managing and operating rural water projects by entities\\\\n                                          with the requisite capacity to deliver services at the desired standards.\\\\n                                          Such an approach enhances the resilience of the infrastructure and the\\\\n                                          water supply services. The revised policy also encourages communities,\\\\n                                          especially those in underserved areas, to improve water access by utilising\\\\n                                          sources within their reach, while at the same time the Government creates\\\\n                                          an enabling environment for them.\\\\n\\\\n                                          2.1.2 Sanitation Services in Rural Areas\\\\n                                          NAWAPO 2002 recognised the importance of sanitation in both urban and\\\\n                                          rural areas. However, while the policy provided for hygiene and sanitation\\\\n                                          education in rural areas, it did not emphasise the construction of sewage\\\\n\\\\n\\\\n\\\\n             28\\\\n                                              THE UNITED REPUBLIC OF TANZANIA\\\\n                                                           MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nconveyance and disposal infrastructure. In addition, the policy did not\\\\naddress wastewater quality management, and as a result, the requisite\\\\nwastewater infrastructure to complement water supply services was not\\\\nconstructed in rural areas.\\\\n\\\\nDue to the ongoing socio-economic transformation in rural areas that\\\\ninvolves the construction of modern houses, the provision of total\\\\nsanitation services, including sewage management, needs to be covered in\\\\nthe revised policy. This will ensure the implementation of integrated water\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nsupply and sanitation projects and prioritising and supporting initiatives\\\\nthat improve effluent quality in rural areas.\\\\n\\\\n2.1.3 Privatization of Water Supply and Sanitation Services in Small\\\\nTowns\\\\nNAWAPO 2002 emphasised privatising water supply and sanitation\\\\nservices in small towns. This policy direction has never been implemented,\\\\nand privatisation of such entities is no longer a Government priority after\\\\nthe exercise failed to deliver in other sectors. However, the Government\\\\nenacted the Public-Private Partnership Policy (PPP) of 2009, establishing a\\\\nsound and progressive framework for engaging the private sector. In this\\\\nregard, in alignment with the PPP policy, the revised water policy guides\\\\nengaging the private sector in investing in water and sanitation services.\\\\nThis is useful, especially in widening the water sector\\u2019s funding sources.\\\\n\\\\n2.1.4 Adaptation to Climate Change and Disaster Management\\\\nThe impacts of climate change are often manifested through water, either\\\\nin droughts or floods. The country has continued to experience frequent\\\\nunprecedented disastrous events such as floods and droughts that have\\\\nled to loss of lives and property. NAWAPO 2002 did not have adequate\\\\nprovisions on adaptation measures to climate change in the water\\\\nsector. For example, it did not provide for integrating climate adaptation\\\\nand resilience measures in all planning and implementation strategies,\\\\nincluding establishing integrated flood and drought Early Warning Systems\\\\n(EWSs).\\\\n\\\\nThe lack of integrated EWSs makes the country vulnerable to disasters,\\\\nwhich can be easily managed by providing adequate lead information to\\\\nenable relevant authorities to take appropriate measures. The new policy\\\\nprovides for such measures with a view to enhancing climate resilience\\\\nand managing disasters in the water sector.\\\\n\\\\n\\\\n\\\\n    29\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          2.2 Vision, Mission and Objectives\\\\n\\\\n                                          2.2.1 Vision\\\\n                                          A water-secure country with equitable, sustainable, accessible, affordable,\\\\n                                          and reliable water and sanitation services for socio-economic development.\\\\n\\\\n                                          2.2.2 Mission\\\\n                                          Through innovative, ethical, and motivated staff, protect and conserve\\\\n                                          water sources, control water quality and pollution, improve sanitation\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          services, and develop water resources and water supply infrastructure in\\\\n                                          Tanzania while ensuring climate resilience.\\\\n\\\\n                                          2.3 Policy Objectives\\\\n                                          The main objective of NAWAPO 2002, Version 2025, is to ensure water\\\\n                                          security for all through optimal, reliable, sustainable, and equitable\\\\n                                          development and use of water resources in the most cost-effective manner.\\\\n\\\\n                                          The specific objectives of this policy are:\\\\n                                          i)     To enhance sustainable management of water resources;\\\\n                                          ii)    To improve water resources development;\\\\n                                          iii) To improve water and wastewater quality management;\\\\n                                          iv)\\t\\u0007To enhance sustainable water supply services and water management\\\\n                                                 systems;\\\\n                                          v)     To enhance reliable and sustainable sanitation services;\\\\n                                          vi) To strengthen private sector participation in the water sector;\\\\n                                          vii)\\t\\u0007 To enhance research and technology development in the water\\\\n                                                 sector; and\\\\n                                          viii)\\t\\u0007To promote cross-cutting issues, which include environmental and\\\\n                                                 climate change resilience, gender and good governance.\\\\n\\\\n\\\\n\\\\n\\\\n             30\\\\n  Chapter\\\\n\\\\n\\\\n    3\\\\n\\\\n                 National Water Policy 2002 Version 2025\\\\nPolicy Issues,\\\\nObjectives and\\\\nStatements\\\\n\\\\n\\\\n\\\\n\\\\n                              31\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                     POLICY ISSUES, OBJECTIVES AND STATEMENTS\\\\n\\\\n                                          This chapter highlights policy issues, objectives, and statements.\\\\n\\\\n                                          3.1 Sustainable Management of Water Resources\\\\n                                          Effective water resources management requires an adequate understanding\\\\n                                          of the balance between available water resources and water demand.\\\\n                                          This has to be based on robust data and information to facilitate strategic\\\\n                                          decision-making processes. There is inadequate data and information\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          on key areas, including water availability, water requirements for various\\\\n                                          uses, and water productivity for assessing and managing competing water\\\\n                                          demands. Management of water resources is also affected by different\\\\n                                          factors, including (i) inefficiency in existing water use technologies, (ii) illegal\\\\n                                          water use, (ii) high non-revenue water, (iii) inefficient irrigation practices,\\\\n                                          (iv) inefficient abstraction control facilities, and (v) ineffective preparedness\\\\n                                          to water-related disasters such as floods and droughts.\\\\n\\\\n                                          In addition, the framework for implementing Integrated Water Resources\\\\n                                          Management Plans (IWRM) requires all sectors using and or dependent on\\\\n                                          water resources to plan together, especially on water-related projects that\\\\n                                          serve multiple socio-economic needs. This includes dams that supply water\\\\n                                          for domestic water, irrigated agriculture, electricity production, drought\\\\n                                          and flood control, among others. Lack of collaborative planning and\\\\n                                          coordination in implementing IWRM plans among sectors has sometimes\\\\n                                          caused duplication of efforts and wastage of resources.\\\\n\\\\n                                          There are also natural rainwater harvesting structures, man-made ponds,\\\\n                                          rural water pans and pit lakes, which are poorly monitored or not well\\\\n                                          documented with proper guidelines on their sustainable use. In addition,\\\\n                                          the rate of encroachment of water sources to create space for other socio-\\\\n                                          economic developments is increasing to the extent that the sustainability of\\\\n                                          water resources in many localities is being threatened. Such bad practices\\\\n                                          and illegal activities can be controlled and managed through effective\\\\n                                          stakeholder engagement processes, especially at the community level.\\\\n                                          Moreover, management of transboundary water resources is hampered by\\\\n                                          inadequate capacity of sectoral institutions, lack of effective management\\\\n                                          of transboundary water resources among riparian member states,\\\\n                                          differences in socio-economic set-ups and priorities between member\\\\n                                          states, geopolitics, and competition over water allocation, security, and\\\\n                                          uses.\\\\n\\\\n\\\\n\\\\n             32\\\\n                                                  THE UNITED REPUBLIC OF TANZANIA\\\\n                                                               MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nPolicy Objective\\\\nTo enhance sustainable management of water resources.\\\\n\\\\nPolicy Statements\\\\nThe Government, in collaboration with stakeholders, shall:\\\\ni)\\t\\u0007ensure water resources data, information, and early warning systems\\\\n      are available for informed decision-making;\\\\nii)\\t\\u0007ensure effective water resources assessment for determining water\\\\n      availability, quality, distribution, scarcity, pollution and climate change\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\n      impacts;\\\\niii)\\t\\u0007ensure collaborative planning, allocation and efficient utilisation of\\\\n      water resources and water demand management across sectors;\\\\niv)\\t\\u0007ensure water source conservation, protection, pollution control, and\\\\n      catchment management;\\\\nv)\\t\\u0007ensure effective management of transboundary water resources for\\\\n      the interest of the country; and\\\\nvi)\\t\\u0007\\u0007promote stakeholders\\u2019 awareness of sustainable management of\\\\n      water resources in both urban and rural areas.\\\\n\\\\n3.2 Water Resources Development\\\\nWater resources development in the country is constrained by various\\\\nissues, including inadequate investment in strategic water storage and\\\\nrainwater harvesting systems, limited use of the large natural freshwater\\\\nlakes, limited inter-basin transfer systems, partial development and non-\\\\noptimal exploitation of the immense potential of groundwater resources,\\\\nincluding enhancing recharge systems. This calls for change of approach in\\\\nthe water sector by aligning more on ensuring water security and quality\\\\nservice. A good example is envisioning a national water grid system that\\\\nis able to tap onto sustainable and unlimited water sources e.g lakes\\\\nand conveying it to all parts of the country through inter-basin transfer\\\\nschemes. One area that has not been fully explored is maximising the\\\\ndevelopment of multi-purpose water storage infrastructure to cater for\\\\ndifferent sectors. Such an approach has the benefit of reducing costs and\\\\navoiding duplication of efforts while promoting integrated water resources\\\\nplanning and development. Other areas that have not been fully explored\\\\nare maximizing the potential of alternative sources of water such as\\\\nrecycling, reuse of treated wastewater and desalination.\\\\n\\\\nPolicy Objective\\\\nTo improve water resources development.\\\\n\\\\n\\\\n\\\\n    33\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          Policy Statements\\\\n                                          The Government, in collaboration with stakeholders, shall:\\\\n                                          i)\\t\\u0007ensure development and management of climate-resilient multi-\\\\n                                                purpose water storage infrastructure for socio-economic activities,\\\\n                                                enhancement of water security, and reduction of drought and flood\\\\n                                                risks across sectors;\\\\n                                          ii)   promote rainwater harvesting technologies;\\\\n                                          iii)\\t\\u0007ensure and coordinate integrated planning, development and\\\\n                                                management of water resources infrastructure across sectors;\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          iv)\\t\\u0007ensure development and management of inter and intra-basin\\\\n                                                water transfer infrastructure;\\\\n                                          v)\\t\\u0007explore and promote the development of alternative sources of\\\\n                                                water, including recycling of wastewater and desalination; and\\\\n                                          vi)\\t\\u0007assess and enhance groundwater development and recharging\\\\n                                                systems.\\\\n\\\\n                                          3.3 Water and Wastewater Quality Management\\\\n                                          Managing the quality of water supplies and wastewater is critical to\\\\n                                          ecosystem protection and sustaining public health. Ensuring the desired\\\\n                                          quality of both water supplies and wastewater is essential for protecting\\\\n                                          and sustaining water resources, guaranteeing the safety of human\\\\n                                          health and the integrity of the environment. The quality of water and\\\\n                                          wastewater has continued to face numerous challenges, mainly as a result\\\\n                                          of anthropogenic activities. Various assessments of water quality have\\\\n                                          indicated the presence of harmful chemicals with threats of emerging\\\\n                                          contaminants in water sources. Deterioration of water quality contributes\\\\n                                          to the spread of water-borne and water-related diseases. It also limits the\\\\n                                          effectiveness of water treatment and increases the overall cost of ensuring\\\\n                                          water quality thresholds for different uses.\\\\n\\\\n                                          Additionally, water quality management lacks regular monitoring and\\\\n                                          assessment, particularly in water sources. There is also a lack of ambient\\\\n                                          water quality standards, inadequate technical and institutional capacity,\\\\n                                          weak inter-sectoral collaboration among water quality management-\\\\n                                          related sectors, weak enforcement of existing water quality and wastewater\\\\n                                          management regulations and inadequate water pollution control.\\\\n\\\\n                                          On the other hand, water supply projects in rural areas were constructed\\\\n                                          without reticulated treatment infrastructure since they were small\\\\n                                          schemes and sourced water from wells and springs that did not have\\\\n\\\\n\\\\n\\\\n             34\\\\n                                               THE UNITED REPUBLIC OF TANZANIA\\\\n                                                            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nwater quality challenges. However, enhanced socio-economic growth,\\\\nimproved livelihoods and change of lifestyles in rural areas have led to the\\\\npollution of previously pristine water sources. In this case, water quality\\\\nissues must be considered in both urban and rural areas. NAWAPO 2002\\\\ndid not provide for consideration of water quality in rural water projects.\\\\nHence, the revised policy has addressed this anomaly by emphasising\\\\nwater quality issues in rural water projects. Additionally, the revised\\\\npolicy has addressed issues of technical and institutional capacity, inter-\\\\nsectoral collaboration, and legal and regulatory framework for water and\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nwastewater quality management.\\\\n\\\\nPolicy Objective:\\\\nTo improve water and wastewater quality management.\\\\n\\\\nPolicy Statements\\\\nThe Government, in collaboration with stakeholders, shall:\\\\ni)\\t\\u0007Strengthen monitoring and assessment of the quality of water\\\\n      sources and wastewater for the safety and well-being of the people\\\\n      and to protect ecosystems and biodiversity;\\\\nii)\\t\\u0007safeguard public health through monitoring and assessment of\\\\n      water quality in public and private water supply schemes in both\\\\n      rural and urban areas;\\\\niii)\\t\\u0007promote public awareness and education to build public support for\\\\n      water and wastewater quality management through encouraging\\\\n      responsible water use and fostering a culture of environmental\\\\n      stewardship;\\\\niv)\\t\\u0007enhance water and wastewater quality infrastructure investment to\\\\n      ensure the delivery of safe drinking water and the safe disposal of\\\\n      wastewater in rural and urban areas;\\\\nv)\\t\\u0007enhance inter-sectoral and transboundary water quality\\\\n      management and\\\\nvi)\\t\\u0007improve the institutional, legal, and regulatory frameworks for water\\\\n      and wastewater quality management.\\\\n\\\\n3.4 Sustainable Water Supply Services and Water Management\\\\nSystems\\\\n\\\\n3.4.1 Rural Water Supply\\\\nMost water projects constructed in rural areas were small to meet the\\\\ngrowing community demands. Furthermore, the scattered population due\\\\n\\\\n\\\\n\\\\n    35\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          to unplanned rural development has caused challenges in providing water\\\\n                                          service using domestic water points (DPs) that earlier were designed to\\\\n                                          serve 250 people in a radius of 400 meters. In addition, climate change has\\\\n                                          led to drying of boreholes and water springs in some rural areas, especially\\\\n                                          during dry seasons, making the sources unsustainable and unreliable. All\\\\n                                          these factors have led to insufficient water supply and sanitation services,\\\\n                                          as well as poor hygiene, thus contributing to waterborne diseases in\\\\n                                          rural areas. These challenges disproportionately affect women and girls,\\\\n                                          who are usually responsible for fetching water and caring for household\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          members who fall sick from contaminated water.\\\\n\\\\n                                          High operational and maintenance costs have hampered the sustainability\\\\n                                          of some rural water schemes. Some CBWSO schemes have depleted their\\\\n                                          water sources due to impacts of climate change. To address such failures,\\\\n                                          the Government is currently constructing large water projects that use\\\\n                                          reliable sources, covering both rural and urban areas. The design and\\\\n                                          implementation of these projects do not align with the NAWAPO 2002\\\\n                                          guidance, which directed small water supply projects to be constructed\\\\n                                          and managed by local communities. The large projects require advanced\\\\n                                          expertise and technology, which local communities can neither afford nor\\\\n                                          manage. Likewise, socio-economic transformation in rural areas has led\\\\n                                          to increased demand for house connections, thus reducing the need for\\\\n                                          public water points, the model on which CBWSOs are based upon. In this\\\\n                                          regard, reflecting afresh on service delivery and providing policy directives\\\\n                                          on restructuring water supply services in rural areas is useful.\\\\n\\\\n                                          In addition, separating water requirements for people and livestock\\\\n                                          has been difficult in rural and semi-arid livestock-keeping communities.\\\\n                                          Livestock keeping is one of the main economic activities supporting many\\\\n                                          rural livelihoods. There is a need for the construction of more infrastructure\\\\n                                          for watering livestock to prevent conflict with and contamination of water\\\\n                                          for domestic use. This also calls for new designs of water abstraction and\\\\n                                          treatment systems for domestic water use that can draw water for multi-\\\\n                                          purpose water uses. The integrated management of such multi-purpose\\\\n                                          water supply systems needs to be well coordinated to avoid conflicts\\\\n                                          between competing users.\\\\n\\\\n                                          3.4.2 Urban Water Supply\\\\n                                          In urban areas, water supply services face water demand management\\\\n                                          challenges due to wasteful water use and unmanageable non-revenue\\\\n\\\\n\\\\n\\\\n             36\\\\n                                                 THE UNITED REPUBLIC OF TANZANIA\\\\n                                                              MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nlosses. Increased population density and enhanced economic activities\\\\nhave strained water service management. Insufficient water production\\\\nby utilities, increased water demand, and high non-revenue water losses\\\\nhave led to water rationing and even lack of water supply services in some\\\\nareas. Nevertheless, the Government has continued to invest in new water\\\\nsupply infrastructure, including major rehabilitation on some of the water\\\\ninfrastructure. Plans are underway to design a national water grid that will\\\\ntap water from reliable water sources for supplying across the country.\\\\nHowever, some water utilities still depend on the Government for operation\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nand maintenance costs (salaries and electricity), service extension and\\\\ninfrastructure rehabilitation. These WSSAs must be restructured to enable\\\\nthem to use their revenues to meet operation and maintenance costs,\\\\nincluding rehabilitation.\\\\n\\\\nSince clean and safe water is a basic need and right for all, entities providing\\\\nwater services must do so at affordable costs and within a reasonable\\\\ndistance to reduce time poverty, especially for women and children. The\\\\nrevised policy has considered this.\\\\n\\\\nPolicy Objective\\\\nTo enhance sustainable water supply services and water management\\\\nsystems.\\\\n\\\\nPolicy Statements\\\\nThe Government, in collaboration with stakeholders, shall:\\\\ni)\\t\\u0007develop large-scale water projects, including a national water grid\\\\n      using reliable water sources for socio-economic development;\\\\nii)   enhance reduction of non-revenue water to acceptable levels;\\\\niii)\\t\\u0007ensure rural water supply schemes are effectively regulated,\\\\n      operated, and managed sustainably by well-capacitated legal\\\\n      entities;\\\\niv)\\t\\u0007ensure full cost recovery by water supply and sanitation authorities;\\\\nv)\\t\\u0007ensure good quality water supply services for household and other\\\\n      uses;\\\\nvi)\\t\\u0007ensure sustainability of water supply services in both rural and\\\\n      urban areas; and\\\\nvii)\\t\\u0007promote public awareness of the efficient use and management of\\\\n      water.\\\\n\\\\n\\\\n\\\\n\\\\n    37\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          3.5 Reliable and Sustainable Sanitation Services\\\\n                                          Sewerage infrastructure has been developed in 11 of the 26 regional\\\\n                                          centres where only 13 per cent of the population in these localities have\\\\n                                          access to sewerage services. Some areas use faecal sludge facilities to\\\\n                                          treat wastewater, while others do not have sustainable sanitation services\\\\n                                          and hence unsafely discharge their wastes into the environment. Provision\\\\n                                          of sanitation services in the country is limited mainly due to low coverage\\\\n                                          of sewerage services, high connection costs, unplanned dwellings and\\\\n                                          dilapidated infrastructure.\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          Most households continue to use unsustainable onsite sanitation, which\\\\n                                          risks contaminating groundwater sources and polluting the environment.\\\\n                                          Likewise, most of the existing wastewater treatment facilities do not cater\\\\n                                          to treating faecal sludge. Such an anomaly has led to the deterioration\\\\n                                          of wastewater treatment facilities. Hence, the quality of both the faecal\\\\n                                          sludge and effluents does not meet the desired disposal standards.\\\\n\\\\n                                          Non-sewered sanitation is used in many urban areas and is the dominant\\\\n                                          system in rural areas. Despite some initiatives to construct faecal sludge\\\\n                                          treatment facilities in 16 townships, progress has been slow and falls short\\\\n                                          of service requirements. A significant proportion of the population in\\\\n                                          the country uses non-emptiable pit latrines that eventually contaminate\\\\n                                          groundwater.\\\\n\\\\n                                          The sanitation challenge in the country is further compounded by unsafe\\\\n                                          emptying of pit latrines, improper transportation facilities, inadequate\\\\n                                          faecal sludge treatment facilities and unsafe disposal practices. In addition,\\\\n                                          many urban centres have not planned for sanitation services, such as\\\\n                                          setting aside land for sanitation infrastructure. Also, regulatory monitoring\\\\n                                          and enforcement of minimum service standards in each segment of the\\\\n                                          non-sewered sanitation chain is largely ineffective.\\\\n\\\\n                                          Implementing and promoting sanitation in the country, including hygienic\\\\n                                          behaviour, solid waste and stormwater management, has become critical.\\\\n                                          All these touch on human health, so their proper handling requires\\\\n                                          collaborative action among various actors.\\\\n\\\\n                                          Policy Objective\\\\n                                          To enhance reliable and sustainable sanitation services.\\\\n\\\\n\\\\n\\\\n\\\\n             38\\\\n                                               THE UNITED REPUBLIC OF TANZANIA\\\\n                                                            MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nPolicy Statements\\\\nThe Government, in collaboration with stakeholders, shall:\\\\ni)\\t\\u0007enhance investment and appropriate technologies for sanitation\\\\n      infrastructure and service provision in rural and urban areas;\\\\nii)\\t\\u0007enhance regulatory monitoring and enforcement for quality\\\\n      sanitation services;\\\\niii)\\t\\u0007promote and coordinate risk-based management approach in the\\\\n      sanitation value chain among sectors;\\\\niv) promote city-wide and rural inclusive sanitation planning; and\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nv)    promote community hygiene practices.\\\\n\\\\n3.6 Private Sector Participation in the Water Sector\\\\nPrivate sector engagement and contribution in the water sector remains\\\\nminimal, limited to capacity building, supplies, consultancy services\\\\nand construction. Their participation in financing, investment and\\\\nimplementation of water projects has been low because of high investment\\\\nrequirements and long payback periods. Existing regulations, such as\\\\nthe Water Supply and Sanitation Act No.5 of 2019 and the Water Supply\\\\nRegulations, regulation 14(1), are also not attractive for private sector\\\\ninvestment and operation of water supply schemes. Thus, the government\\\\nhas remained burdened with all capital investment and the operation of\\\\nwater sector projects. With overcommitted financial resources and the\\\\nmany needs in the water sector, greater private sector involvement will\\\\nrelieve government finances for other critical purposes, increase service\\\\ndelivery efficiency and advance modern technology in the sector.\\\\n\\\\nPolicy Objective\\\\nTo strengthen private sector participation in the water sector.\\\\n\\\\nPolicy Statements\\\\nThe Government, in collaboration with stakeholders, shall:\\\\ni)\\t\\u0007promote private sector engagement in water resources\\\\n     management and development, provision of water supply and\\\\n     sanitation services, and\\\\nii)  coordinate and support private sector initiatives in the water sector.\\\\n\\\\n3.7 Research and Technology Development\\\\nEmerging innovations and technologies in the water sector require\\\\ndedicated learning from different experiences and continuous, purposeful\\\\nresearch in different areas. Some areas that require such interventions\\\\n\\\\n\\\\n\\\\n    39\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          are data and information management systems, climate resilience,\\\\n                                          non-revenue water losses, wastewater reuse and resource recovery,\\\\n                                          sanitation, desalination, revenue management and all aspects of water\\\\n                                          resource management. The absence of a robust knowledge base and\\\\n                                          continued reliance on traditional and conventional approaches impede\\\\n                                          effective water resources management, water and wastewater quality\\\\n                                          management, as well as the provision of sustainable water supply and\\\\n                                          sanitation services. This requires prioritising research and development\\\\n                                          and strategic investments in transformative technologies to revolutionise\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          the water sector. Actions needed include fostering and promoting research,\\\\n                                          technology, and innovation as key drivers of a thriving water sector.\\\\n                                          Through research, cost-effective and efficient technological alternatives in\\\\n                                          water and sanitation can be identified to suit current and future needs.\\\\n\\\\n                                          In addition, Information and Communication Technology (ICT) plays a\\\\n                                          pivotal role in enhancing Research and Development (R&D) by providing\\\\n                                          tools such as Artificial Intelligence (AI) and platforms for streamlining\\\\n                                          processes, facilitating collaboration and accelerating innovation. It enables\\\\n                                          researchers to access vast databases, shares findings in real-time, and\\\\n                                          utilise advanced analytical tools to derive insights from complex data sets.\\\\n                                          ICT in the water sector must adapt and innovate digital technologies and\\\\n                                          related tools to facilitate timely informed decisions on water resources\\\\n                                          management, water quality management, water supply and sanitation\\\\n                                          services, and infrastructure management. Considering the importance of\\\\n                                          ICT, the revised policy will continue to strengthen and promote ICT in the\\\\n                                          water sector.\\\\n\\\\n                                          A clear policy direction is required to ensure continued research and\\\\n                                          technological innovations in the water and sanitation sector, such as\\\\n                                          categorisation, piloting, approval, and implementation of research\\\\n                                          findings and technological innovations. A policy environment that allows\\\\n                                          and encourages experimentation and entrepreneurial thinking, or where\\\\n                                          WASH innovations are remunerated, is likely to provide an incentive to\\\\n                                          Basin Water Boards, water utilities and other entities across the sector to\\\\n                                          invest in R&D. Such investment will, in the long run, lead to well-managed\\\\n                                          water resources, quality and effective water and sanitation services, more\\\\n                                          revenue generation by WSSAs and reduction in operational expenses.\\\\n\\\\n                                          Furthermore, integrating ICT into water sector R&D will enhance water\\\\n                                          resource planning, allocation, development, and conservation.\\\\n\\\\n\\\\n\\\\n             40\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nPolicy Objective\\\\nTo enhance research and development in the water sector.\\\\n\\\\nPolicy Statements\\\\nThe Government, in collaboration with stakeholders, shall:\\\\ni)\\t\\u0007promote and encourage Research and Development (R&D) in the\\\\n     water sector;\\\\nii)  promote enabling R&D environment; and\\\\niii) promote the use of ICT in the water sector.\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\n3.8 Cross-Cutting Issues\\\\n\\\\n3.8.1 Environment, Climate Change and Disaster Resilience Systems\\\\nThe climate in Tanzania is mainly influenced by biophysical factors such\\\\nas location, seasons, vegetation cover, and proximity to natural dominant\\\\nbodies such as lakes, oceans, and mountains. Climate change has continued\\\\nto affect the functioning of ecosystems and has had direct, often harmful,\\\\nimpacts on human well-being.\\\\n\\\\nIn addressing the challenges and impacts of climate change, the Government\\\\ndeveloped and is implementing the National Climate Change Strategy of\\\\n2021, covering all sectors. However, the water sector is still vulnerable\\\\nto climate change, where numerous impacts have been observed,\\\\nincluding higher temperatures, droughts, floods, and sea level rises.\\\\nFloods have disrupted water and sanitation services and destruction of\\\\ncritical infrastructure such as river monitoring stations, roads and bridges.\\\\nDroughts have led to the drying of rivers and reservoirs, crop failures\\\\nand depletion of pastures. Generally, climate change has disrupted most\\\\nproductive sectors and negatively impacts rural communities\\u2019 livelihoods.\\\\nNotably, the impacts have affected men and women differently - for\\\\nexample, increasing water scarcity forces women and girls to walk longer\\\\ndistances to access clean water, thus reducing time for education and\\\\nincome-generating activities.\\\\n\\\\nDespite these observable changes and recorded impacts, the capacity\\\\nto guide responses is inadequate, and there is generally low resilience\\\\nagainst climate shocks. The latter could encompass strategic water\\\\nsecurity investments, e.g., dams to cushion the country against droughts\\\\nand promotion of risk-based planning in all water projects, among others.\\\\nInformation systems are uncoordinated, and levels of preparedness\\\\n\\\\n\\\\n\\\\n    41\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          for water-related disasters remain low, making the water sector more\\\\n                                          vulnerable to the impacts of climate change.\\\\n\\\\n                                          In addition, promoting environmental integrity and social safeguards\\\\n                                          are key aspects to be considered in implementing water and sanitation\\\\n                                          projects. Some of the key aspects include pollution and contamination\\\\n                                          of water resources; purposeful land acquisition for conserving water\\\\n                                          sources, water supply and sanitation works; catchment degradation and\\\\n                                          deforestation attributed to land use and land use change; competing water\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          use demands; and inadequate initiatives on wastewater management.\\\\n\\\\n                                          There have been cases where some projects have been implemented\\\\n                                          without adherence to environmental and social guidelines, leading\\\\n                                          to environmental degradation, pollution and social grievances. These\\\\n                                          unwarranted impacts have led to significant effects on socio-economic\\\\n                                          development. In order to address environmental and social safeguards\\\\n                                          in surface and groundwater projects, a catchment approach is needed.\\\\n                                          This recognises that all hydrological and environmental systems in the\\\\n                                          catchment are integrated and dependent on each other. A good example\\\\n                                          is the change of hydrological water balance across catchments where\\\\n                                          inter-basin transfer schemes have been implemented.\\\\n\\\\n                                          In addressing the potential impact of environmental and social safeguards\\\\n                                          in water projects, the Ministry of Water has developed and implemented\\\\n                                          the Resettlement Management Framework, the Environmental and Social\\\\n                                          Management Framework, and Guidelines for Good Environmental and\\\\n                                          Social Practices for the water and sanitation sector. However, challenges\\\\n                                          continue to exist regarding environmental and social safeguards, which\\\\n                                          require policy guidance.\\\\n\\\\n                                          Policy Objective\\\\n                                          To promote environmental and climate change resilience.\\\\n\\\\n                                          Policy Statements\\\\n                                          The Government, in collaboration with stakeholders, shall:\\\\n                                          i)\\t\\u0007promote environmental and social safeguards and compliance in\\\\n                                                the water sector;\\\\n                                          ii)   ensure land availability for water projects;\\\\n                                          iii)\\t\\u0007promote mainstreaming of climate change resilience interventions\\\\n                                                in the water sector;\\\\n\\\\n\\\\n\\\\n             42\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\niv)\\t\\u0007promote risk-based climate change adaptation and mitigation\\\\n     measures in the water sector; and\\\\nv)\\t\\u0007promote cross-sectoral coordination and collaboration in managing\\\\n     the impacts of climate change and environmental issues.\\\\n\\\\n3.8.2 Gender Mainstreaming and Social Inclusion\\\\nGender equity and social inclusion play a pivotal role in ensuring the\\\\neffective management and development of water resources and the\\\\nprovision of water supply and sanitation services. Women, girls and those\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nwith disabilities often have unique WASH challenges, and WASH practices\\\\nare usually steeped in traditional norms and stigma. Strengthened WASH\\\\nand IWRM practices often require the empowerment of marginalised\\\\nvoices within the home, workplace, community, and society to have equal\\\\nopportunities in the sector.\\\\n\\\\nThis includes the youth, who form the main structural base for the\\\\nTanzanian population. The Government recognises the importance\\\\nof social inclusion, especially women\\u2019s active participation in water\\\\nmanagement decision-making, the gendered nature of water collection\\\\nand the resulting consequences for economic development. In the water\\\\nsector, efforts to promote gender equality have increased the gender\\\\nbalance in some decision-making bodies for water resource management\\\\nand Water Supply and Sanitation Authorities.\\\\n\\\\nHowever, the leadership in several of these bodies remains male-\\\\ndominated, especially in WSSA, where women in leadership positions are\\\\nless than 10%. By promoting social inclusion in decision-making and using\\\\na gender lens to inform decisions within the water sector, the revised\\\\npolicy aims to ensure that relevant water infrastructure is accessible to all\\\\nand sustainably addresses respective water needs.\\\\n\\\\nPolicy Objective\\\\nTo promote gender and social inclusion in the water sector.\\\\n\\\\nPolicy Statements\\\\nThe Government, in collaboration with stakeholders, shall:\\\\ni)     strengthen gender mainstreaming in the water sector;\\\\nii)\\t\\u0007promote public awareness of the role of gender in the water sector;\\\\n       and\\\\niii)\\t\\u0007\\u0007ensure inclusiveness of socially vulnerable groups in water-related\\\\n       matters.\\\\n\\\\n\\\\n    43\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          3.8.3 Good Governance\\\\n                                          Good governance is important in managing and developing water\\\\n                                          resources and providing water supply and sanitation services. Some good\\\\n                                          governance practices ensure participatory decision-making processes,\\\\n                                          equal capacity-building opportunities, transparency and accountability.\\\\n                                          These must be observed and mainstreamed in legal frameworks,\\\\n                                          strategies, plans and programs. To mainstream good governance in the\\\\n                                          water sector, the Government, in collaboration with stakeholders, will\\\\n                                          continue to monitor and enforce legal frameworks that prevent corruption\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          and maintain the political stability of the country; enhance transparency\\\\n                                          and accountability in all implementing agencies by publicly availing various\\\\n                                          reports and engaging the public on issues of interest relating to the water\\\\n                                          sector. This is useful so that people are aware of ongoing activities and\\\\n                                          effectively contribute to development initiatives.\\\\n\\\\n                                          Apart from the Government, other partners and stakeholders, e.g.,\\\\n                                          development partners, the private sector, well-wishers, and communities,\\\\n                                          have continued to provide financial resources to support the water\\\\n                                          sector. These resources require accountability and transparency on their\\\\n                                          expenditures in financing water projects.\\\\n\\\\n                                          Policy Objective\\\\n                                          To promote good governance in the water sector.\\\\n\\\\n                                          Policy Statements\\\\n                                          The Government, in collaboration with stakeholders, shall:\\\\n                                          i)   s\\u0007trengthen accountability, Impartiality, transparency, and the rule of\\\\n                                               law in the water sector;\\\\n                                          ii)  enhance staff capacity building;\\\\n                                          iii) enhance stakeholders\\u2019 engagement in water sector activities and\\\\n                                          iv) promote public awareness of good governance in the water sector.\\\\n\\\\n\\\\n\\\\n\\\\n             44\\\\n  Chapter\\\\n\\\\n\\\\n    4\\\\n\\\\n                       National Water Policy 2002 Version 2025\\\\nLegal and Regulatory\\\\nFramework\\\\n\\\\n\\\\n\\\\n\\\\n                                    45\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                      LEGAL AND REGULATORY FRAMEWORK\\\\n\\\\n                                          Tanzania has established the legal and regulatory frameworks facilitating\\\\n                                          the management, coordination, and implementation of NAWAPO 2002\\\\n                                          objectives, strategies, and activities. The legislation is aligned to various\\\\n                                          Acts, Codes of Practice, and Regulations under a general water law that\\\\n                                          guides the functioning of the water sector. The existing legal and regulatory\\\\n                                          frameworks that are directly related to water and sanitation include the\\\\n                                          Water Resources Management Act, 2009; The Water Supply and Sanitation\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          Act, 2019; The Energy and Water Utilities Regulatory Authority Act, 2001;\\\\n                                          The Environmental Management Act No. 20 of 2004 and Natural Wealth\\\\n                                          and Resources (Permanent Sovereignty Act 2017).\\\\n\\\\n                                          To effectively implement the revised policy and avoid ambiguity and\\\\n                                          duplication of functions, there is a need to undertake a comprehensive\\\\n                                          review of some of the above Acts, especially the Water Supply and Sanitation\\\\n                                          Act, 2019 and the Regulations for Water Supply and Sanitation of 2019.\\\\n                                          This Act states that when a WSSA extends services to an area serviced by\\\\n                                          a community organisation or a person, the latter\\u2019s services shall cease to\\\\n                                          exist, and provision of such services will be undertaken by the WSSA. In\\\\n                                          contrast, the revised policy encourages investments from private and other\\\\n                                          entities in the provision of water supply services. The new Act should be\\\\n                                          able to recognise and appreciate existing private investments and services\\\\n                                          and provide for the continuation of such services with clear engagement\\\\n                                          frameworks with the respective WSSAs.\\\\n\\\\n                                          Another provision in the Act that needs to be revised is the functions of\\\\n                                          RUWASA. The existing Water Supply and Sanitation Act grants RUWASA\\\\n                                          the mandate to register, invest, monitor, regulate and evaluate the\\\\n                                          performance of CBWSOs. RUWASA also has the mandate of planning,\\\\n                                          implementing and supervising projects while providing financial and\\\\n                                          technical support to CBWSOs. Such an arrangement gives RUWASA both\\\\n                                          regulatory and supervisory mandates over CBWSOs, which contradicts the\\\\n                                          prescribed governance principle of separating oversight, regulatory and\\\\n                                          implementation roles.\\\\n\\\\n                                          The Government desires to establish sewerage networks in urban and\\\\n                                          rural areas where all households would be connected to such networks.\\\\n                                          The Public Health Act of 2019 requires that any house located within 30\\\\n                                          meters of a sewer network be connected to that network. To complement\\\\n\\\\n\\\\n\\\\n             46\\\\n                                              THE UNITED REPUBLIC OF TANZANIA\\\\n                                                           MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nthe Public Health Act of 2019, the Water Supply and Sanitation Act of 2019\\\\nmust be revised to strengthen sanitation infrastructure\\u2019s development, its\\\\noptimal use, and sustainability.\\\\n\\\\nOther national legislations related to and directly complementing the\\\\nimplementation of NAWAPO 2002 and which may need to be reviewed\\\\ninclude Forest Act No. 14 of 2002; National Irrigation Act No. 5 of 2013;\\\\nThe Grazing Land and Animal Feed Resources Act No. 13, 2010; The Village\\\\nLand Act No. 5, 1999; The Land Act No 4 of 1999; The Wildlife Conservation\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nAct No 5 2009; The Local Government (District Authorities) Act No.7, 1982;\\\\nThe Local Government (Urban Authorities) Act No. 8, 1982; The Mining Act,\\\\n2010; The Roads Act No. 13 of 2007; The Standard Act of 2009; The Public\\\\nHealth Act No. 01 of 2009; The National Security Act, No. 03 of 1970; the\\\\nLand Acquisition Act, No. 47 of 1967; The Land Use Planning Act, 2007 and\\\\nThe Urban Planning Act No. 08 of 2007.\\\\n\\\\nThe revised regulatory frameworks will form a basis for implementing\\\\nthe reviewed NAWAPO 2002, Version 2025. Other legislations may be\\\\nreviewed\\/amended to effectively implement the reviewed policy.\\\\n\\\\n\\\\n\\\\n\\\\n    47\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n             48\\\\n  Chapter\\\\n\\\\n\\\\n    5\\\\n\\\\n                 National Water Policy 2002 Version 2025\\\\nInstitutional\\\\nFramework,\\\\nMonitoring\\\\nand Evaluation\\\\n\\\\n\\\\n\\\\n                              49\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                  INSTITUTIONAL FRAMEWORK, MONITORING\\\\n                                                             AND EVALUATION\\\\n\\\\n                                          5.1 Institutional Framework\\\\n                                          NAWAPO 2002, Version 2025 will use the existing institutional framework\\\\n                                          for management, coordination, and collaboration between ministries, the\\\\n                                          private sector, development partners and other stakeholders to ensure\\\\n                                          the sustainable development of the water sector. Under circumstances\\\\n                                          that will necessitate the review of the existing institutional framework,\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          the instruments for implementing this policy i.e water laws, strategies,\\\\n                                          programs and implementation plans will be used to make the necessary\\\\n                                          improvements. The following are the existing institutional responsibilities\\\\n                                          for implementing the policy.\\\\n\\\\n                                          5.1.1 Ministry Responsible for Water\\\\n                                          The ministry will coordinate the implementation and evaluation of NAWAPO\\\\n                                          2002, Version 2025.\\\\n\\\\n                                          5.1.2 Ministry Responsible for Health\\\\n                                          This will prepare guidelines and strategies for sanitation and hygiene\\\\n                                          matters.\\\\n\\\\n                                          5.1.3 Ministry Responsible for Regional Administration and Local\\\\n                                          Government Authorities\\\\n                                          This ministry will collaborate with the ministry responsible for water in\\\\n                                          preparing and implementing water resources management plans and\\\\n                                          construction of water supply and sanitation projects.\\\\n\\\\n                                          5.1.4 Ministry Responsible for Finance\\\\n                                          This ministry will allocate and provide financial resources to implement\\\\n                                          the Policy\\u2019s strategies.\\\\n\\\\n                                          5.1.5 Ministry Responsible for Works\\\\n                                          This ministry will collaborate with the Ministry of Water in planning and\\\\n                                          implementing infrastructure projects.\\\\n\\\\n                                          5.1.6 Ministry Responsible for Home Affairs\\\\n                                          This ministry will collaborate with the Ministry responsible for Water to\\\\n                                          protect and conserve water sources and infrastructure.\\\\n\\\\n\\\\n\\\\n\\\\n             50\\\\n                                              THE UNITED REPUBLIC OF TANZANIA\\\\n                                                           MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n5.1.7 Ministry Responsible for Investment and Planning\\\\nThis ministry will scrutinise and approve various water project proposals\\\\nto obtain financial resources for implementation.\\\\n\\\\n5.1.8 Ministry Responsible for Education\\\\nThis ministry will prepare programs to educate students in schools on\\\\nthe importance of water resource conservation, sanitation and personal\\\\nhygiene.\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\n5.1.9 Ministry Responsible for Agriculture\\\\nThis ministry will promote agricultural activities that prioritise water\\\\nsource conservation, environmental management, and efficient irrigation\\\\ninfrastructure.\\\\n\\\\n5.1.10 Ministry Responsible for Livestock and Fisheries\\\\nThis ministry will construct water infrastructure for livestock to prevent\\\\ndestruction of domestic water infrastructure and pollution of water\\\\nsources, manage and conserve aquatic ecosystems to support sustainable\\\\nfisheries and protect biodiversity.\\\\n\\\\n5.1.11 Ministry Responsible for Energy\\\\nThis ministry will ensure availability of energy, such as electricity, for\\\\nwater treatment facilities and water pumping systems and participate in\\\\nconserving watersheds in hydropower project areas.\\\\n\\\\n5.1.12 Ministry Responsible for Natural Resources and Tourism\\\\nThis ministry will conserve forests and ecosystems to protect water\\\\ncatchment areas.\\\\n\\\\n5.1.13 Ministry Responsible for Lands\\\\nThis ministry will allocate land for water sources and designate areas for\\\\nwater and sanitation projects.\\\\n\\\\n5.1.14 Ministry Responsible for Environment\\\\nThis ministry will prepare various environmental management guidelines\\\\nfor protecting and conserving water resources.\\\\n\\\\n5.1.15 Ministry Responsible for Disaster Management\\\\nThis will coordinate the management of social emergencies, especially\\\\ndrought, floods, and other disasters affecting water infrastructure and\\\\nsources.\\\\n\\\\n\\\\n    51\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          5.1.16 Ministry Responsible for Public Service and Good\\\\n                                          Governance\\\\n                                          This will ensure the availability of skilled human resources to implement\\\\n                                          the policy.\\\\n\\\\n                                          5.1.17 Ministry Responsible for Industries and Trade\\\\n                                          This will ensure a regulatory environment that balances industrial growth\\\\n                                          with the preservation of water resources, supporting initiatives to improve\\\\n                                          water access, quality, and conservation.\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          5.1.18 Ministry Responsible for Foreign Affairs\\\\n                                          This ministry will collaborate with the Ministry responsible for Water in\\\\n                                          preparing and implementing regional and international agreements and\\\\n                                          protocols on transboundary water resources.\\\\n\\\\n                                          5.1.19 Local Government Authorities\\\\n                                          These will sensitise communities to the importance of protecting and\\\\n                                          conserving water sources, safeguarding water infrastructure, and\\\\n                                          preparing and managing the implementation of by-laws for water resource\\\\n                                          management.\\\\n\\\\n                                          5.1.20 Energy and Water Utilities Regulatory Authority (EWURA)\\\\n                                          This will regulate the pricing and quality of water services provided by\\\\n                                          WSSAs.\\\\n\\\\n                                          5.1.21 Development Partners\\\\n                                          They will provide financial resources and technical support for implementing\\\\n                                          water projects.\\\\n\\\\n                                          5.1.22 The Private Sector\\\\n                                          This will participate in the development and management of water projects.\\\\n\\\\n                                          5.1.23 Non-Governmental and Civil Society Organisations\\\\n                                          They will prepare and implement community awareness programs to\\\\n                                          promote sustainable water resources, water use efficiency, and water\\\\n                                          system management, as well as finance and implement water supply and\\\\n                                          sanitation projects.\\\\n\\\\n                                          5.1.24 Academic and Research Institutions\\\\n                                          They will conduct research, produce water and sanitation experts, and\\\\n                                          provide consultation services on water sector issues.\\\\n\\\\n\\\\n             52\\\\n                                              THE UNITED REPUBLIC OF TANZANIA\\\\n                                                           MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n5.1.25 Basin Water Boards\\\\nThey will manage and develop water resources.\\\\n\\\\n5.1.26 Water Entities (WSSAs & RUWASA)\\\\nThese will construct water projects, provide clean and safe water and\\\\nsanitation services in rural and urban areas, and participate in the\\\\nconservation of water sources.\\\\n\\\\n5.1.27 National Water Fund\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nThe fund will mobilise financial resources to manage and develop water\\\\nresources and water supply and sanitation projects.\\\\n\\\\n5.1.28 The Water Institute\\\\nThe institute will produce experts in the construction, management, and\\\\ndevelopment of water projects, conduct research, and provide technical\\\\nconsultation to support the water sector.\\\\n\\\\n5.1.29 Community-Based Water Supply Organisations (CBWSOs) and\\\\nOther Water Service Providers\\\\nThese will manage and operate water supply and sanitation services at the\\\\ncommunity level and maintain water schemes to ensure reliable access to\\\\nclean and safe water.\\\\n\\\\n5.1.30 Water User Associations (WUAs)\\\\nThese will be responsible for conserving and protecting water sources\\\\nagainst encroachment and non-permitted water abstractions.\\\\n\\\\n5.1.31 The Community\\\\nThey will be responsible for conserving and protecting water sources and\\\\nwater distribution infrastructure and contributing to the costs of water\\\\nservice operations to ensure sustainability.\\\\n\\\\n5.1.32 Media\\\\nThey will be responsible for educating and providing accurate and timely\\\\ninformation about the water sector to citizens and various stakeholders.\\\\n\\\\n5.2 Monitoring and Evaluation\\\\nMonitoring and Evaluation (M&E) of this policy is the responsibility of the\\\\nministry responsible for water in collaboration with stakeholders. M&E will\\\\nbe conducted from national to lower levels using the existing Integrated\\\\n\\\\n\\\\n\\\\n    53\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\n                                          MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                          Water Sector Monitoring and Evaluation System. The mid-term evaluation\\\\n                                          will be conducted every five years of policy implementation. During\\\\n                                          the policy\\u2019s lifespan, the ministry will play a key role in its coordination,\\\\n                                          implementation, monitoring and evaluation. The stakeholders and water\\\\n                                          sector implementing agencies will be responsible for providing appropriate\\\\n                                          information to the ministry for the M&E process. The ministry will also be\\\\n                                          responsible for analysing, integrating and disseminating the received and\\\\n                                          analysed information for the benefit of the public.\\\\nNational Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                          5.3 Conclusion\\\\n                                          The overall objective of NAWAPO 2002 was to develop a comprehensive\\\\n                                          framework for sustainable development and management of the nation\\u2019s\\\\n                                          water resources. Important areas considered in the policy include water\\\\n                                          resources management; improved health and poverty alleviation of rural\\\\n                                          populations through improved access to adequate and safe water; and\\\\n                                          sustainable, effective and efficient development and management of\\\\n                                          urban water supply and sewerage services. The policy aimed at ensuring\\\\n                                          beneficiaries participate fully in the planning, construction, operation,\\\\n                                          maintenance and management of community-based domestic water\\\\n                                          supply schemes.\\\\n\\\\n                                          Achievements of NAWAPO 2002 include establishing the most extensive\\\\n                                          Water Sector Development Program in Sub-Saharan Africa, enacting\\\\n                                          water laws, and preparing and implementing the National Water Sector\\\\n                                          Development Strategy. Various institutions for managing water resources\\\\n                                          were established, including the National Water Board, Basin Water\\\\n                                          Boards, Water Supply and Sanitation Authorities, Community Based Water\\\\n                                          Supply Organisations, Rural Water Supply and Sanitation Agency and the\\\\n                                          National Water Fund. The establishment of these institutions has brought\\\\n                                          improvement in the management and development of water resources,\\\\n                                          including transboundary waters, improved water and wastewater quality\\\\n                                          management and the improved provision of water supply and sanitation\\\\n                                          services nationally.\\\\n\\\\n                                          Despite these achievements, some challenges have been observed\\\\n                                          during policy implementation. These include impacts of climate change\\\\n                                          causing floods and drought; inadequate investment in strategic water\\\\n                                          storage facilities for ensuring water security; water demand management\\\\n                                          challenges; degradation of water sources and catchments due to poor land\\\\n                                          use practices; encroachment of land near water sources for agriculture\\\\n\\\\n\\\\n\\\\n             54\\\\n                                                THE UNITED REPUBLIC OF TANZANIA\\\\n                                                             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\nand urbanisation which impacted wetlands, important watershed areas\\\\nand recharge areas. Furthermore, water harvesting technology and a self-\\\\nsustaining national water grid for efficient use of available water resources\\\\nfor all benefits were not emphasised in NAWAPO 2002. In water quality and\\\\nwastewater management, improper treatment and discharge of wastewater\\\\ninto the environment pollutes water sources, and in rural areas, water\\\\nquality issues were not considered in the previous policy. Urbanisation,\\\\nindustrial development, and other economic activities in water supply\\\\nand sanitation do not match the available water infrastructure. High non-\\\\n\\\\n\\\\n\\\\n\\\\n    National Water Policy 2002 Version 2025\\\\nrevenue water has resulted in revenue loss and inefficient service delivery.\\\\nIn rural areas, sanitation was not considered when planning and designing\\\\nwater projects. Other issues that were not given high consideration in\\\\nNAWAPO 2002 include R&D and the involvement of the private sector in\\\\nthe development and operation of water schemes.\\\\n\\\\nThese challenges and policy gaps in the implementation of NAWAPO 2002\\\\ndrove the Government and stakeholders to see the need for a review of the\\\\npolicy. NAWAPO 2002, Version 2025 will, therefore, provide policy guidance\\\\nfor important issues related to the water sector while also considering\\\\nchallenges observed during the implementation of NAWAPO 2002. This\\\\npolicy, among other things, emphasises aspects of climate change that are\\\\nof worldwide concern. It addresses the development of water resources\\\\nwhose implementation was limited due to lack of policy directives;\\\\nencourages more private sector participation in delivering water services;\\\\nconsiders inclusivity in policy issues of rural water and wastewater quality\\\\nmanagement and sanitation; and encourages research and development to\\\\nenhance new technologies and innovations in the water sector. Therefore,\\\\nthe Government invites all stakeholders to participate in implementing this\\\\nPolicy to achieve optimal, reliable, sustainable and equitable development\\\\nand use of water resources for the benefit of all in the most cost-effective\\\\nmanner possible.\\\\n\\\\n\\\\n\\\\n\\\\n    55\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n             56\\\\nTHE UNITED REPUBLIC OF TANZANIA\\\\n             MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                  National Water Policy 2002 Version 2025\\\\n\\\\n\\\\n\\\\n\\\\n                                               57\\\\n                                          THE UNITED REPUBLIC OF TANZANIA\\\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\\\n\\\\n\\\\n\\\\n\\\\n                                                         Ministry of Water\\\\n\\\\n                                                              Government City, Maji Street\\\\n                                                              P.O.Box 456, Dodoma\\\\n\\\\n                                                              Hotline +255 26 2322602\\\\n\\\\n                                                              Fax No. +255 26 2322602\\\\n\\\\n                                                              E-mail: ps@maji.go.tz\\\\n\\\\n                                                              Website: www.maji.go.tz\\\\n\\\\n\\\\n\\\\n\\\\n             58\', `policy_documents`.`updated_at` = \'2025-11-21 12:13:21\' where `id` = 2\",\"time\":\"11.37\",\"slow\":false,\"file\":\"\\/Users\\/dave\\/Sites\\/ae-policy-tracking-tool\\/app\\/Jobs\\/PolicyDocumentExtractContent.php\",\"line\":51,\"hash\":\"554886a75eaee8256d0ee6a96afaced9\",\"hostname\":\"dave-mbp\"}','2025-11-21 12:13:21'),(873,'a068f955-4c8d-4019-b2b9-de212d883045','a068f955-4de6-4077-b30a-c55fdcce9f47',NULL,1,'model','{\"action\":\"updated\",\"model\":\"App\\\\Models\\\\PolicyDocument:2\",\"changes\":{\"content\":\"THE UNITED REPUBLIC OF TANZANIA\\n            MINISTRY OF WATER\\n\\n\\n\\n\\n                                        National Water Policy 2002 Version 2025\\n\\nNATIONAL WATER POLICY 2002\\n       VERSION 2025\\n\\n                MARCH 2025                              a\\n                                          THE UNITED REPUBLIC OF TANZANIA\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\n\\n\\n\\n\\n                b\\n      THE UNITED REPUBLIC OF TANZANIA\\n            MINISTRY OF WATER\\n\\n\\n\\n\\nNATIONAL WATER POLICY 2002\\n       VERSION 2025\\n\\n                MARCH 2025\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                                              TABLE OF CONTENTS\\n\\n\\n                                          TABLE OF CONTENTS \\u2026 ii\\n                                          DEFINITIONS OF TERMS\\u2026 vi\\n                                          FOREWORD. \\u2026 x\\n\\n                                          CHAPTER ONE . \\u20261\\n                                          INTRODUCTION\\u20262\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          1.1. Background. \\u2026 2\\n                                          1.2. Situation Analysis\\u2026 4\\n                                               1.2.1\\t\\t Water Resources Management\\u2026 5\\n                                               1.2.2\\t\\t Water Resources Development. \\u2026 10\\n                                               1.2.3\\t\\t Water and Wastewater Quality Management\\u2026 11\\n                                               1.2.4\\t\\tAccess to Water Supply Services and Water Management\\n                                          \\t\\t\\t          Systems\\u2026 13\\n                                               1.2.5\\t\\t Sanitation\\u2026 17\\n                                               1.2.6\\t\\t Private Sector Participation\\u2026 19\\n                                               1.2.7\\t\\t Research and Technology Development\\u2026 20\\n                                               1.2.8\\t\\t Cross-Cutting Issues\\u2026 21\\n                                          \\t\\t\\t          1.2.8.1 Environmental and Climate Change Resilience. ....... 21\\n                                          \\t\\t\\t          1.2.8.2 Gender\\u2026 23\\n                                          \\t\\t\\t          1.2.8.3 Good Governance\\u2026 24\\n\\n                                          CHAPTER TWO. \\u202627\\n                                          RATIONALE, VISION, MISSION AND OBJECTIVES\\u202628\\n                                          2.1 Rationale and Justification\\u2026 28\\n                                          2.2 Vision, Mission and Objectives\\u2026 30\\n                                              2.2.1\\t\\t Vision\\u2026 30\\n                                              2.2.2\\t\\t Mission\\u2026 30\\n                                          2.3 Policy Objectives \\u2026 30\\n\\n                                          CHAPTER THREE. \\u202631\\n                                          POLICY ISSUES, OBJECTIVES AND STATEMENTS. \\u202632\\n                                          3.1 Sustainable Management of Water Resources\\u2026 32\\n                                          3.2 Water Resources Development. \\u2026 33\\n                                          3.3 Water and Wastewater Quality Management\\u2026 34\\n                                          3.4 Sustainable Water Supply Services and Water Management\\n                                              Systems\\u2026 35\\n\\n\\n\\n\\n                 ii\\n                                                                      THE UNITED REPUBLIC OF TANZANIA\\n    MINISTRY OF WATER\\n\\n\\n\\n\\n3.5    Reliable and Sustainable Sanitation Services\\u2026 38\\n3.6    Private Sector Participation in the Water Sector. \\u2026 39\\n3.7    Research and Technology Development\\u2026 39\\n3.8    Cross-Cutting Issues\\u2026 41\\n       3.8.1\\t\\t\\t\\u0007Environment, Climate Change and Disaster Resilience\\n                Systems\\u2026 41\\n       3.8.2\\t\\t\\t Gender Mainstreaming and Social Inclusion\\u2026 43\\n       3.8.3\\t\\t\\t Good Governance. \\u2026 44\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nCHAPTER FOUR\\u202645\\nLEGAL AND REGULATORY FRAMEWORK\\u202646\\n\\nCHAPTER FIVE . \\u202649\\nINSTITUTIONAL FRAMEWORK, MONITORING AND EVALUATION. ......50\\n5.1 Institutional Framework. \\u2026 50\\n5.2 Monitoring and Evaluation\\u2026 53\\n5.3 Conclusion\\u2026 54\\n\\n\\n\\n\\n    iii\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                    LIST OF ABBREVIATIONS AND ACRONYMS\\n\\n                                          BCM          Billion Cubic Meters\\n\\n                                          BOD          Biochemical Oxygen Demand\\n\\n                                          CBO          Community Based Organisation\\n\\n                                          CBWSOs       Community-Based Water Supply Organisations\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          CM           Cubic Meters\\n\\n                                          COD          Chemical Oxygen Demand\\n\\n                                          EFA          Environmental Flow Assessment\\n\\n                                          EMA          Environmental Management Act\\n\\n                                          EWS          Early Warning System\\n\\n                                          EWURA        Energy and Water Utilities Regulatory Authority\\n\\n                                          FBO          Faith-Based Organisation\\n\\n                                          FYDP         Five-Year Development Plan\\n\\n                                          IWRM         Integrated Water Resources Management\\n\\n                                          IWRMD        Integrated Water Resources Management and Development\\n\\n                                          JNHPP        Julius Nyerere Hydropower Plant\\n\\n                                          M&E          Monitoring and Evaluation\\n\\n                                          MCM          Million Cubic Meters\\n\\n                                          MIS          Management Information System\\n\\n                                          MoW          Ministry of Water\\n\\n                                          MW           Megawatt\\n\\n                                          NAWAPO National Water Policy\\n\\n                                          NGO          Non-Governmental Organisation\\n\\n                                          NSC          National Sanitation Campaign\\n\\n\\n\\n\\n               iv\\n                                           THE UNITED REPUBLIC OF TANZANIA\\n                                                        MINISTRY OF WATER\\n\\n\\n\\n\\nPO-RALG President\\u2019s Office, Regional Administration and Local\\n        Government\\nRUWASA Rural Water Supply and Sanitation Agency\\n\\nSDGs      Sustainable Development Goals\\n\\nTDV       Tanzania Development Vision 2025\\n\\n\\n\\n\\n                                                                             National Water Policy 2002 Version 2025\\nTSF       Tailings Storage Facility\\n\\nWASH      Water, Sanitation and Hygiene\\n\\nWRM       Water Resources Management\\n\\nWSDP      Water Sector Development Program\\n\\nWSSAs     Water Supply and Sanitation Authorities\\n\\nWUAs      Water Users Associations\\n\\n\\n\\n\\n    v\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                                 DEFINITIONS OF TERMS\\n\\n                                          Ambient Water Quality\\n                                          The quality of natural untreated water in rivers, lakes and ground waters,\\n                                          representing a combination of natural influences together with the impact\\n                                          of all anthropogenic activities\\n\\n                                          Basin\\n                                          An area of land where rainfall collects and drains water into a common\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          outlet\\n\\n                                          Domestic Purpose\\n                                          The use of water solely for meeting household and domestic needs and\\n                                          excluding any commercial activities\\n\\n                                          Faecal Sludge\\n                                          The slurry containing both solid and liquid waste that accumulates in on-\\n                                          site sanitation systems. Specifically, it may refer to a semi-solid mixture of\\n                                          human excrement accumulated in pit latrines, septic tanks, wastewater\\n                                          stabilisation ponds, and other liquid waste treatment systems. It can also\\n                                          refer to animal waste that collects in holding pens.\\n\\n                                          Faecal Sludge Management\\n                                          Organised programs that provide safe and hygienic septic tank and pit\\n                                          emptying services, along with proper treatment of liquids and re-use of\\n                                          bio-solids where possible\\n\\n                                          Groundwater\\n                                          Water which is naturally stored or flowing below the surface of the ground\\n                                          but can rise to the surface in, e.g. wetlands and springs\\n\\n                                          Non-Revenue Water\\n                                          The amount of water that a water utility produces (or purchases from\\n                                          other water utilities) minus the amount sold to consumers is presented as\\n                                          a percentage of water produced and\\/or purchased.\\n\\n                                          Pollution\\n                                          In relation to water resources, any direct or indirect alteration of the\\n                                          physical, thermal, chemical or biological properties of the water resource\\n                                          which makes it (a) less fit for any beneficial purpose for which it is or may\\n                                          be reasonably expected to be used; or (b) harmful or potentially harmful\\n\\n\\n               vi\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\nto (i) the welfare, health or safety of human beings; (ii) any aquatic or non-\\naquatic life; (iii) property; or (iv) the wider environment.\\n\\nPublic Tap\\nAny fountain, standpipe, tap, trough, valve or other appliance or structure\\nerected, provided or maintained by or on behalf of a water supply and\\nsanitation authority or a community-based water supply organisation to\\nsupply its consumers.\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nSanitation\\nAccess to and use of facilities and services for the safe disposal of human\\nurine and faeces\\n\\nSanitation Coverage\\nThe proportion of the population with access to sanitation services\\n\\nSanitation Works\\nSewers, drains, pipes, ducts or channels, whether open or closed, are used\\nfor the drainage of human excreta or wastewater from buildings or land,\\nand on-site systems for the reception of human excreta and wastewater\\nwhich do not connect to a sewer, as well as treatment to the recommended\\nstandards before disposal to the environment.\\n\\nSewage\\nLiquid waste conveyed in sewers, not including stormwater\\n\\nSewer\\nAny pipe or conduit, other than a drain, which is intended for the conveyance\\nof sewage\\n\\nSewerage\\nA network of pipes, pumping stations and appurtenances that convey\\nsewage from its point of origin to the point of treatment or disposal\\n\\nWater Stakeholders\\nIndividuals, organisations, and communities that are interested in water\\nresources and their management include, but are not limited to, government\\nagencies, environmental organisations, development partners, agricultural\\nproducers, industrial suppliers, the private sector, and local communities.\\n\\n\\n\\n\\n    vii\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          Surface Water\\n                                          All water flowing over the ground or contained in any visible water body,\\n                                          such as a lake, pond, reservoir, or river, is of any size and permanent or\\n                                          temporary.\\n\\n                                          Tailing Dam\\n                                          A specially constructed tailings pond for storing mining tailings and\\n                                          processing water\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          Transboundary Water\\n                                          These are water resources contained within drainage or river basins that\\n                                          cross political boundaries and are shared by more than one sovereign\\n                                          country. These can be surface or ground waters.\\n\\n                                          Wastewater\\n                                          Liquid waste of both excremental and non-excremental nature but which\\n                                          does not include stormwater.\\n\\n                                          Water pan\\n                                          An informal term used to collectively describe small, permanent, or\\n                                          seasonal water bodies created through the capture of rainwater runoff and\\n                                          used as a water source for livestock, agriculture, domestic purposes, and\\n                                          wildlife. The term is applied to deliberately constructed water works such\\n                                          as excavated ponds, small dams, and water bodies created naturally or as a\\n                                          by-product of other human activities such as mining or road construction.\\n\\n                                          Water Quality\\n                                          Chemical, physical, biological, and radiological characteristics of water\\n                                          relative to the requirements of the ecosystem or to any human need or\\n                                          purpose\\n\\n                                          Water Quality Management\\n                                          This is a process of monitoring, assessing, and improving the quality\\n                                          of water resources to ensure they are safe for human consumption,\\n                                          environmental health and recreational use. It involves a range of practices\\n                                          and policies aimed at protecting or restoring water quality from pollution\\n                                          and degradation.\\n\\n                                          Water Resources\\n                                          These are watercourse, surface water, groundwater or estuary water.\\n\\n\\n\\n            viii\\n                                               THE UNITED REPUBLIC OF TANZANIA\\n                                                            MINISTRY OF WATER\\n\\n\\n\\n\\nWater Scheme\\nThis is a structured plan or program designed to manage, distribute, and\\nimprove water resources within a specific area, typically encompasses\\nthe development and maintenance of infrastructure, such as pipelines,\\ntreatment facilities, and storage systems, to ensure access to clean and\\nsafe drinking water.\\n\\nWater Sector\\nWater resources development and management, water quality, water\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nsupply and sanitation services\\n\\nWater Service Coverage\\nThe percentage (proportion) of the population accessing clean and safe\\nwater from improved water sources\\n\\nWater Source\\nThis could be a river, tributary, estuary, lake, swamp, marsh, or other\\nwetland; an aquifer or a spring; seawater and the interface between\\nseawater and freshwater; or a dam, pond, or reservoir.\\n\\nWater Supply\\nThe provision of appropriate facilities and services for the sourcing,\\ntreatment and distribution of potable water\\n\\nWaterworks\\nWaterworks include canals, channels, reservoirs, embankments, weirs,\\ndams, wells, boreholes, and other works constructed for, or in connection\\nwith, the diversion, damming, storage, or abstraction of water, the\\nprotection of rivers, lakes, or any other water sources, the conservation of\\nwater sources, drainage, or the use of water for any purpose.\\n\\n\\n\\n\\n    ix\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                                            FOREWORD\\n\\n                                          Water is a shared natural resource essential to life and the environment.\\n                                          It plays a crucial role in any country\\u2019s social, cultural, and economic\\n                                          development. It influences all aspects of life, including the environment,\\n                                          productive and social sectors.\\n\\n                                          In 2002, the Government published the National Water Policy (NAWAPO)\\n                                          to ensure that water resources are effectively managed to support the\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          nation\\u2019s social and economic growth while protecting the environment. The\\n                                          policy aimed at creating a comprehensive framework for water resource\\n                                          management, improving health and reducing poverty in rural areas by\\n                                          increasing access to adequate safe water, while achieving sustainable\\n                                          development as well as effective management of urban water supply and\\n                                          sewerage services.\\n\\n                                          The implementation of NAWAPO 2002 resulted in the formulation of\\n                                          the Water Sector Development Program (WSDP 2006\\u20132025), which is\\n                                          the largest water programme in Sub-Saharan Africa, and the enactment\\n                                          of two key water laws - The Water Resources Management Act No. 11\\n                                          of 2009 (amended by the Miscellaneous Amendment Act No. 8 of 2022)\\n                                          and the Water Supply and Sanitation Act No. 12 of 2009 (repealed by the\\n                                          Water Supply and Sanitation Act No. 5 of 2019). These initiatives enabled\\n                                          the establishment of an institutional framework for water resource\\n                                          management and water supply and sanitation services, which included the\\n                                          National Water Board, Basin Water Boards, Water Supply and Sanitation\\n                                          Authorities, the Rural Water Supply and Sanitation Agency, Community-\\n                                          Based Water Supply Organisations, the National Water Fund and Water\\n                                          Institute.\\n\\n                                          Additionally, implementing the policy has led to improved water quality\\n                                          management and provision of water supply and sanitation services. Priority\\n                                          interventions and investment needs were identified in water resource\\n                                          management, urban water supply, sewerage services, and rural water\\n                                          supply. The implementation of these interventions have led to increased\\n                                          access to clean and safe water in rural areas from 50 to 83 per cent and\\n                                          in urban areas from 73 to 91.6 per cent from 2002 to 2024, respectively.\\n                                          Despite these achievements, various gaps in the policy have prompted\\n                                          its review. One of the gaps was the inability of rural communities to\\n                                          implement the policy\\u2019s directive that required them to contribute to capital\\n\\n\\n\\n                x\\n                                               THE UNITED REPUBLIC OF TANZANIA\\n                                                            MINISTRY OF WATER\\n\\n\\n\\n\\ninvestment and to own and manage their rural water schemes. Large-scale\\nwater projects have continued to be constructed in rural areas that require\\nsubstantial investment, advanced technology, and professional expertise,\\nand their costs are beyond the capacity of local communities. The policy\\nwas also silent on managing wastewater quality in rural areas. This led\\nto slower progress in service delivery and subsequent poor water quality\\nmanagement in rural areas. Furthermore, the policy\\u2019s directive to privatise\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nwater supply and sanitation services in small towns has not been realised\\nand is no longer a Government priority.\\n\\nTo address these gaps, the Government has reviewed the National Water\\nPolicy of 2002, now presented as Version 2025, through a consultative\\nprocess where all stakeholders were involved. The updated policy aims\\nto ensure optimal, reliable, sustainable, and equitable development and\\nuse of water resources for the benefit of all in the most cost-effective\\nway. It offers guidance to stakeholders on addressing challenges in water\\nresource management and development, water quality in both rural and\\nurban areas, and water supply and sanitation services of which are critical\\nto achieving socio-economic development and water security in line with\\nnational and international goals. The policy also emphasises private sector\\nengagement and the importance of research and development.\\n\\nLastly, I appreciate the contribution of all stakeholders and partners who\\nsupported the process of reviewing the policy. I urge all of us to commit\\nand actively participate in implementing this policy, recognising that water\\nis a precious resource essential for the well-being of both present and\\nfuture generations.\\n\\n\\n\\n\\n                    Hon. Jumaa Hamidu Aweso (MP)\\n\\n                          MINISTER FOR WATER\\n\\n\\n\\n\\n    xi\\n                                          THE UNITED REPUBLIC OF TANZANIA\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\n\\n\\n\\n\\n              xii\\n                                              1\\n                                              Chapter\\n\\n\\n\\n\\n                           Introduction\\n\\n\\n\\n\\n1\\n    National Water Policy 2002 Version 2025\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                                       INTRODUCTION\\n\\n                                          1.1 Background\\n                                          Water is a shared natural resource fundamental to life and the sustenance\\n                                          of the environment of which human beings depend upon. It plays a central\\n                                          role in Tanzania\\u2019s social and economic development, touching on all aspects\\n                                          of life necessary for sustainable economic development and stability. For\\n                                          the environment, water supports ecosystem biodiversity, including flora\\n                                          and fauna, to maintain a viable population.\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          To improve water and sanitation services in the country, the Government\\n                                          enacted the first National Water Policy of 1991 to guide the provision\\n                                          of clean and safe water to the population within 400 meters of their\\n                                          households. Due to challenges in implementing the 1991 Policy emanating\\n                                          from changing global trends in the water sector and other national policy\\n                                          reforms, the Government launched the National Water Policy of 2002\\n                                          (NAWAPO 2002).\\n\\n                                          The NAWAPO 2002 established an institutional framework for the\\n                                          management and development of water resources and the development\\n                                          and sustainable management of water supply services in rural and urban\\n                                          areas. The framework enabled the establishment of various institutions in\\n                                          the water sector, including the National Water Board, which serves as an\\n                                          advisory body to the Minister on water and sanitation issues; Basin Water\\n                                          Boards (BWBs), responsible for managing and developing water resources;\\n                                          Water Supply and Sanitation Authorities (WSSAs), tasked with providing\\n                                          water and sanitation services in urban areas; Community-Based Water\\n                                          Supply Organisations (CBWSOs), responsible for delivering water and\\n                                          sanitation services in rural areas; the Rural Water Supply and Sanitation\\n                                          Agency (RUWASA), which oversees the development and sustainable\\n                                          management of rural water supply and sanitation projects; the National\\n                                          Water Fund (NWF), which mobilises resources and provides investment\\n                                          support for water service provision and the management of catchment\\n                                          areas; and the Water Institute (WI) which is responsible for provision of\\n                                          trained and skilled personnel in the water sector.\\n\\n                                          The implementation of NAWAPO 2002 enhanced the credibility of\\n                                          hydrological data and information, the adoption of Integrated Water\\n                                          Resources Management and Development (IWRMD) planning, the\\n                                          conservation and protection of water sources, and enhanced collaboration\\n\\n\\n\\n                2\\n                                                 THE UNITED REPUBLIC OF TANZANIA\\n                                                              MINISTRY OF WATER\\n\\n\\n\\n\\nwith riparian states through joint protocols, conventions, and agreements\\nfor the development and management of transboundary water resources.\\n\\nIn 2020, a review of NAWAPO 2002 revealed some challenges and gaps.\\nUnder water resources management and development these challenges\\ninclude minimal consideration of the impacts of climate change in the\\nsector, and inadequate investment in water storage facilities and water\\ndemand management. This is on and above less emphasis on water\\nharvesting technologies and supporting a transformative national water\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\ngrid to enhance sustainable water supply and ensure water security in the\\ncountry.\\n\\nIn water quality and wastewater management, there have been challenges\\nin implementing the policy, especially due to persistent pollution of water\\nsources resulting from improper treatment and discharge of wastewater\\ninto the environment. The policy also considered water quality at the\\nsource, treatment of urban water and wastewater, but excluded the same\\nin rural areas since water quality and sanitation were not a problem in\\nsuch localities at the time. The increased rural population and enhanced\\neconomic development and change of lifestyles have led to increased water\\ndemand in such localities. This has led to the construction of small dams\\nin rural areas and the use of unimproved surface water sources, including\\nrivers and water pans, which calls for consideration of water quality and\\nsanitation issues in such localities. This has led to the construction of small\\ndams in rural areas and the use of unimproved surface water sources,\\nincluding rivers and water pans, which calls for consideration of water\\nquality and sanitation issues as well.\\n\\nThere are several identified water supply and sanitation challenges. One\\nis low investment that cannot cope with rapid urbanisation, industrial\\ndevelopment as well as other economic activities. Another critical challenge\\nis physical and commercial water loss, which accounts for high non-revenue\\nwater (NRW) caused by dilapidated infrastructure and inefficient water\\nmanagement (leaks, unauthorised usage and metering inaccuracies). The\\npopulation increase in rural areas has outrun the planned water schemes.\\nAdditionally, some schemes have been unsustainable due to the impacts\\nof climate change that have caused water sources to dry up. This has\\nnecessitated investment into large water infrastructure projects using\\nreliable water sources. Thus, it has been difficult to implement the policy\\ndirective requiring rural communities to contribute part of the project\\n\\n\\n\\n    3\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          capital cost. Moreover, rural sanitation services have not developed and\\n                                          have been limited in urban areas. The private sector has also not been\\n                                          active in investing and operating water supply and sanitation schemes. Their\\n                                          contribution has been limited to a few Corporate Social Responsibility (CSR)\\n                                          activities or consultancies and construction of water supply infrastructure.\\n                                          Furthermore, attempts to promote Public Private Partnerships (PPPs) in\\n                                          the water sector have had very limited success.\\n\\n                                          In addition, the policy emphasised the importance of Research and\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          Development (R&D) in effecting and adapting technological changes and\\n                                          innovation in the sector. To date, there has been limited progress in this\\n                                          area, with only a few studies that were either demand-driven with minimal\\n                                          impact on sectoral transformation. New Information and Communication\\n                                          Technology (ICT) tools, for example, the use of Artificial Intelligence (AI) in\\n                                          the water sector, have not been fully explored.\\n\\n                                          1.2 Situation Analysis\\n                                          The main goal of NAWAPO 2002 was to establish a robust system for\\n                                          managing and developing water resources and to institute a strong legal\\n                                          and institutional framework for managing policy implementation. It\\n                                          further aimed at ensuring beneficiaries in rural areas participate fully in\\n                                          the planning, construction, operation, maintenance and management of\\n                                          water supply schemes; and achieving sustainable, effective and efficient\\n                                          development and management of urban water supply and sewerage\\n                                          services. The Policy also aimed at changing the government\\u2019s role from\\n                                          service provision to coordination, policy and guidelines formulation,\\n                                          and regulation for sustainable development and management of water\\n                                          resources. The three main objectives of NAWAPO 2002 are:\\n\\n                                          i)\\t\\t\\u0007 Water Resources Management: To establish a comprehensive\\n                                                framework that promotes the optimal, sustainable, and equitable\\n                                                development of water resources for the benefit of all Tanzanians;\\n                                          ii)\\t\\t\\u0007Rural Water Supply: To improve public health and reduce poverty\\n                                                in rural areas by enhancing access to adequate and safe water; and\\n                                                Urban Water Supply: To ensure the sustainable, effective, and\\n                                          iii)\\t\\t\\u0007\\n                                                efficient development and management of urban water supply and\\n                                                sewerage services.\\n\\n                                          This section narrates the current situation in implementing the three main\\n                                          objectives and highlights the policy gaps that have necessitated a policy\\n                                          review.\\n\\n\\n                4\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\n1.2.1 Water Resources Management\\nTanzania is endowed with abundant natural freshwater resources,\\nincluding lakes, rivers, springs and aquifers, some of which are shared with\\nneighbouring countries as transboundary water resources. There are also\\nconstructed dams and many water pans, which are used as unimproved\\nwater sources for domestic and socio-economic purposes. With all these\\nresources, there is a need for a well-established and efficient institutional\\nset-up for water allocation, resource development, and management\\nof both quantity and quality across all water uses. The NAWAPO 2002\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nprovides a basis for supporting and guiding water resources management\\n(WRM), including institutions, infrastructure, and information systems.\\n\\nTo ensure good management of water resources in the country, nine\\nBasin Water Boards (BWBs) were established, namely, Pangani, Wami\\/\\nRuvu, Rufiji, Ruvuma and Southern Coast, Lake Nyasa, Lake Rukwa, Lake\\nTanganyika, Lake Victoria, and the Internal Drainage Basin. BWBs are the\\ninstitutions responsible for overseeing the implementation of basin plans.\\nThe BWBs develop and manage water resources through the Integrated\\nWater Resource Management and Development (IWRMD) and Catchment\\nConservation Plans (CCPs) to promote coordinated management and\\nsustainable development of water resources. IWRMD plans were prepared\\nby the BWBs in collaboration with other water-related sectors and\\nstakeholders, with implementation plans involving all parties. Functional\\nareas of WRM include water resources data and information systems,\\nassessment and planning, water allocation and demand management,\\nwater sources conservation and pollution control, dam development and\\nmanagement, and transboundary water resources management. Despite\\nthe success of NAWAPO 2002 in establishing a sound policy framework for\\nwater resources management, over the last twenty-three years, there has\\nemerged some challenges that require a new policy guidance as narrated\\nherein.\\n\\n1.2.1.1 Water Resources Data and Information System, Assessment\\nand Planning\\nThe task of collecting water resources data, processing and analysis for\\nwater resources management is performed by BWBs. They are responsible\\nfor ensuring the availability of hydrological and hydrogeological data\\nand information, which is central to the effective management of water\\nresources. In achieving this, a network of 832 monitoring stations has been\\ninstalled across the country, including 756 hydrometeorological stations\\n\\n\\n\\n    5\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          and 76 groundwater monitoring stations. The collected and analysed data\\n                                          support decision-making in managing and developing water resources.\\n                                          During the implementation of NAWAPO 2002, it was observed that some\\n                                          of the monitoring stations faced sustainability challenges due to wear and\\n                                          tear, lack of regular maintenance, outdated technology and equipment\\n                                          vandalism. Additionally, the available network is manually operated,\\n                                          leading to delays in data collection, processing and dissemination.\\n\\n                                          Water resources assessment is conducted at the basin level by determining\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          the point of assessment, quantity, and quality, as well as analysing the\\n                                          current status and trends related to availability, accessibility, and demand for\\n                                          water. Extensive water resources assessments have supported ascertaining\\n                                          existing and future water availability, disaster forecasting, establishing\\n                                          sectoral water demands and optimum water resource monitoring systems\\n                                          for the respective basins. Reliable water resource assessments have been\\n                                          hampered by inadequate hydrological, hydrogeological and meteorological\\n                                          monitoring networks, resulting in insufficient data and information for\\n                                          evidence-based planning and decision-making.\\n\\n                                          Water resources planning is conducted by using IWRMD plans. The plans\\n                                          provide blueprints for rational management and development of the\\n                                          nation\\u2019s water resources for multi-sectoral needs in each basin. To ensure\\n                                          proper implementation of the plans, the Government established platforms\\n                                          for stakeholder engagement for effective water resources planning and\\n                                          development.\\n\\n                                          These include the National Multi-Sectoral Forum, Basins Multi-Sectoral Fora\\n                                          and Catchment Stakeholders Fora. The fora have improved stakeholders\\u2019\\n                                          involvement in the implementation of the plans. One such success story\\n                                          of implementing basin IWRMD through stakeholder engagement is the\\n                                          construction of the Julius Nyerere Hydroelectric Power Project (JNHPP),\\n                                          where all stakeholders were engaged.\\n\\n                                          However, the implementation of sectoral plans is faced with inadequate\\n                                          coordination, as most sectors still do not adhere to IWRMD plans in\\n                                          implementing their respective water projects. This has led to sectoral\\n                                          conflicts on water use and inefficiency in water allocation. There has also\\n                                          been a lack of capacity and resources to reach and effectively engage\\n                                          constituents in remote areas with dispersed populations, especially in\\n                                          lower-level catchment areas.\\n\\n\\n\\n                6\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\n1.2.1.2 Water Allocation, Use and Demand Management\\nEffective water allocation aims at ensuring equity in apportioning water to\\ndifferent uses. In allocating water, priority is always given to domestic use,\\nfollowed by the environment, and lastly, economic activities. The allocation\\nprocess is done through issuing water use permits. As of June 2024, 13,579\\npermits had been issued across all BWBs, significantly improving control\\nof water use and demand management. Challenges observed in water\\nallocation include inadequate compliance within permitted volumes of\\nwater and insufficient water demand management. Enhancing compliance\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nfor all water users, especially during the dry season, is essential.\\n\\nWater use and demand have risen over the last 20 years because of\\nincreased population and economic activities. In 2015, water demand\\nfor different sectors was 47.5 Billion Cubic Meters (BCM); by 2024, it had\\nreached 62 BCM. This is projected to increase to 80.2 BCM by 2035, with\\na risk of the country being subjected to water stress if no appropriate\\naction is taken. In 2002, the population of Tanzania was 33,584,607, which\\ntranslated to a water per capita of 3,678 m3\\/ca\\/yr. In 2022, the population\\nwas 59,851,357, with a water per capita of 2,105 m3\\/ca\\/yr.\\n\\nThe internationally acceptable threshold for water stress is 1,700 m3\\/ca\\/yr,\\nindicating that Tanzania is not water-stressed. However, water demand is\\nincreasing due to population growth, lifestyle changes, rapid urbanisation\\nand increased production across all sectors. Alongside the increasing\\ndemand, there is limited awareness of efficient water use across various\\nsectors, leading to the deterioration of water quality.\\n\\nThis calls for urgent actions to increase water productivity, prevent\\ndeterioration of water quality, make effective use of innovative technologies\\nand approaches to increase water availability, harness other freshwater\\nsources, increase strategic water storage to ensure water security,\\nmaximise seawater desalination and reuse of wastewater. These critical\\nareas were not emphasised in NAWAPO 2002.\\n\\n1.2.1.3 Water Sources Conservation and Pollution Control\\nWater source conservation and pollution control have been implemented\\nthrough various interventions, including the identification, demarcation,\\ngazettement and restoration of degraded water sources. This is on and\\nabove enforcing water and related laws and regulations; promoting\\nsustainable agricultural, mining and land use practices; efficient water\\n\\n\\n\\n    7\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          allocations; issuing discharge permits; and creating awareness. All these\\n                                          initiatives have supported the conservation and protection of water\\n                                          sources. By June 2024, 3,339 water sources had been identified; out of\\n                                          these, 350 have been demarcated and 62 gazetted as protected areas.\\n                                          In addition, 254 wastewater discharge permits have been granted to\\n                                          industries countrywide to control the quality standards of wastewater\\n                                          discharged into the environment.\\n\\n                                          Despite these efforts, water resource depletion and quality deterioration\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          remain a growing concern. Encroachment into water sources due to\\n                                          socio-economic developments and the impacts of climate change are\\n                                          now threatening their sustainability. This calls for a new policy direction\\n                                          especially in ensuring climate resilience in the water sector.\\n\\n                                          1.2.1.4 Dam Development and Management\\n                                          Water dams are constructed mainly to mitigate droughts\\u2019 effects, regulate\\n                                          flows, control floods, and supplement groundwater recharge. Tailing dams,\\n                                          commonly known as Tailings Storage Facilities (TSFs), are used to store\\n                                          effluents from mines. Dam owners are responsible for such structures\\u2019\\n                                          operation, maintenance, and surveillance, while the government is\\n                                          responsible for oversight. Dam safety management includes a system for\\n                                          monitoring the state of dams, physical threats to the dams, and issuing\\n                                          safety warnings when necessary. By June 2024, there were 651 formally\\n                                          registered dams with various capacities, 29 of which were large, and the\\n                                          remaining were of medium and small sizes. There are also 43 tailings dams.\\n\\n                                          The government has developed the Dam Safety Regulations of 2020 to\\n                                          guide the enforcement of dam safety. This includes monitoring, issuance of\\n                                          construction permits, registration of dams with and without safety risk and\\n                                          registration of Approved Professional Persons (APPs) who are authorised to\\n                                          deal with all aspects of dam safety management - designing, construction,\\n                                          commissioning, operation, maintenance and decommissioning.\\n\\n                                          The Dam Safety Regulations have enhanced safety measures in dam design,\\n                                          construction, operations, and maintenance. Following regular monitoring,\\n                                          risks associated with dam failure or leakage of hazardous water from\\n                                          tailing dams have also been minimised. The government will continue to\\n                                          improve dam development and management by preparing and enforcing\\n                                          technical guidelines, standards, and design manuals for water dams and\\n                                          tailings storage facilities.\\n\\n\\n\\n                8\\n                                               THE UNITED REPUBLIC OF TANZANIA\\n                                                            MINISTRY OF WATER\\n\\n\\n\\n\\n1.2.1.5 Transboundary Water Resources\\nTanzania shares with neighbouring countries several water bodies which\\ninclude the six transboundary lakes, namely Victoria, Tanganyika, Nyasa,\\nNatron, Chala and Jipe; eight transboundary rivers, namely Kagera, Mara,\\nMalagarasi, Momba, Mwiruzi, Ruvuma, Songwe and Umba; and eight\\ntransboundary aquifers, namely Kagera (Tanzania\\/ Uganda\\/ Rwanda),\\nKilimanjaro (Tanzania\\/ Kenya), Coastal Sedimentary Basin (Tanzania and\\nKenya), Karoo Sandstone (Tanzania\\/ Mozambique), Weathered Basement\\n(Tanzania\\/ Malawi\\/ Zambia), Tanganyika Aquifer (Tanzania\\/ Burundi\\/ DRC\\/\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nRwanda), Rift Aquifer (Tanzania\\/ Kenya\\/ Uganda) and Coastal Sedimentary\\nBasin (Tanzania\\/ Mozambique).\\n\\nTo ensure equity in sharing the transboundary water resources, riparian\\ncountries have formed regional and international transboundary\\ninstitutions. Tanzania is a strategic and active partner in these regional\\ninstitutions, through which programs and projects that benefit Tanzania\\nare implemented. The institutions include the Joint Songwe River Basin\\nCommission (SONGWECOM), Nile Basin Initiative (NBI), Joint Ruvuma Basin\\nCommission, Zambezi Watercourse Commission (ZAMCOM), Lake Victoria\\nBasin Commission (LVBC) and Lake Tanganyika Authority (LTA). Additionally,\\nTanzania, in collaboration with other member states, implements\\ndevelopment strategies and programs that include Africa Water Vision\\n2025, Nile Basin Initiative Strategy 2017-2027, African Ministers\\u2019 Council\\non Water Strategy 2018\\u20132030, Zambezi Watercourse Strategic Plan 2018-\\n2040, and Songwe River Basin Development Program.\\n\\nBenefits that Tanzania has gained from bilateral, regional and international\\ncooperation on transboundary waters include the development of capacity\\nfor water experts, implementation of the Lake Victoria Environmental\\nManagement Project (LVEMP), construction of the Rusumo Falls\\nHydroelectric Power Plant, Kenya - Tanzania Interconnection Project and\\nRegional Agricultural Trade and Productivity Project.\\n\\nOthers are the Ruvuma Shared Watercourses Support Project and the\\nproposed Lower Songwe Multipurpose Dam for producing 180 MW of\\nelectricity to be shared between Tanzania and Malawi. The latter will\\nprovide water for irrigating 6,200ha and for domestic use targeting the\\ncommunities in the area. Despite establishing these transboundary\\ncooperation institutions, inadequate capacity, incoherent and conflicting\\nlegal frameworks, differences in socio-economic setups, differential\\n\\n\\n\\n    9\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          capacities and priorities among member states, and geopolitics have led\\n                                          to competition over water allocation and uses. Also, the national capacity\\n                                          to manage transboundary water affairs is still limited.\\n\\n                                          1.2.2 Water Resources Development\\n                                          The country is endowed with vast water bodies such as rivers, lakes, wetlands,\\n                                          springs, and groundwater aquifers. They add up to annual renewable water\\n                                          resources estimated to be 126,000 BCM. This figure includes an estimated\\n                                          storage capacity of 40 BCM in 651 registered dams (as of June 2024). This\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          does not include the water storage capacity of unregistered, unmanaged\\n                                          and unmonitored reservoirs, particularly the numerous natural and man-\\n                                          made water pans used as water sources in rural areas. In this regard,\\n                                          the storage capacity is underestimated in the country\\u2019s renewable water\\n                                          resources because it does not account for the significant contribution\\n                                          of rainwater harvesting to socio-economic development. Despite these\\n                                          abundant water resources, NAWAPO 2002 did not adequately guide the\\n                                          development to ensure lasting water security in the country. Instead, the\\n                                          policy only provided guidelines for dam construction. The construction of\\n                                          strategic water storage facilities is necessary to increase water security,\\n                                          reduce the impacts of climate change and support disaster management\\n                                          through drought and flood management. This includes constructing a\\n                                          national water grid that draws water resources from the main water bodies\\n                                          for distribution across all parts of the country.\\n\\n                                          During the review of NAWAPO 2002, it was revealed that, although issues\\n                                          of preparedness against water-related disasters were provided, their\\n                                          implementation was not given priority. The construction of water storage\\n                                          infrastructure and Early Warning Systems (EWSs) was inadequate, and\\n                                          the Water, Sanitation, and Hygiene (WASH) sector was always unprepared\\n                                          to respond promptly and effectively due to a lack of funding. In addition,\\n                                          there has been disjointed planning of water-related projects implemented\\n                                          in different sectors, resulting in duplication of efforts and wastage of\\n                                          resources. Assessment of investments in inter-basin water transfer\\n                                          systems was noted to be insufficient to mitigate extreme water stress in\\n                                          heavily impacted areas or to distribute water-related risks more evenly\\n                                          across different parts of the country. There are also other untapped water\\n                                          resource potential, such as desalination and reuse of treated wastewater,\\n                                          including development of water pans which could augment the available\\n                                          water resources if targeted investments are made.\\n\\n\\n\\n\\n             10\\n                                              THE UNITED REPUBLIC OF TANZANIA\\n                                                           MINISTRY OF WATER\\n\\n\\n\\n\\nGroundwater is one of the most indispensable natural resources and\\naccounts for about 17 per cent of available water resources in Tanzania,\\nwith numerous boreholes drilled to supplement surface water supply.\\nThe government gives groundwater special consideration and has been\\nexploring the resource. By June 2024, 172 potential groundwater sources\\nwere identified for development. Normally, groundwater helps to replenish\\nand maintain levels of surface water bodies such as lakes, streams and\\nrivers. Sustainable utilisation of groundwater has been challenging because\\nof inadequate data and continuous monitoring due to limited investment.\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nDeliberate initiatives must be taken to ensure sustainable investments in\\nthe monitoring of groundwater resources.\\n\\n1.2.3 Water and Wastewater Quality Management\\nWater and wastewater quality management is essential for ensuring that\\nquality is within acceptable standards for various uses and for control\\nof pollution. Quality management is implemented through monitoring\\nand assessment programs performed by Water Quality Laboratories in\\ncollaboration with other water quality stakeholders. The formulation and\\nimplementation of NAWAPO 2002 led to remarkable achievements in\\nwater and wastewater quality management. This include strengthening\\nwater quality analytical services through expansion of the service coverage\\nand scope, ISO\\/IEC 17025 accreditation of water laboratories on testing\\nand calibration, and upscaling of water treatment interventions for\\nimproving the quality of drinking water in the country. The Government\\ndeveloped National Guidelines on Drinking Water Quality Monitoring and\\nReporting, Operational Guidelines for Optimization of Water Treatment\\nChemical Dosing, and Guidelines for Preparation of Climate Resilient Water\\nSafety Plans for urban and rural water supply that support water quality\\nmanagement.\\n\\nMonitoring and assessment programs performed by Water Quality\\nLaboratories involve collection of samples from water sources, water\\nsupply systems and wastewater treatment systems. Data are collected\\nfrom water quality and pollution control stations established in water\\nbodies and water supply \\/distribution networks in various parts of the\\ncountry. The collected data are analysed to generate useful information\\nfor planning and informed decision-making on the development of water\\nsources to determine the suitability of water for various intended uses.\\n\\n\\n\\n\\n    11\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          In many parts of the country, deterioration of water quality caused by\\n                                          human development activities is evident. The water quality assessments\\n                                          have revealed the presence of harmful chemicals in water from industrial\\n                                          processing, mining and agriculture. There is concern about emerging\\n                                          contaminants in water sources which are not fully regulated. The long-\\n                                          term effects of these contaminants on human health and ecosystems\\n                                          are still being studied. Furthermore, there is inadequate water quality\\n                                          management - a lack of regular water quality monitoring and assessment,\\n                                          particularly in water sources, a lack of ambient water quality standards\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          and inadequate water pollution control practices. This leads to further\\n                                          deterioration of water quality, limits effectiveness and increases the cost\\n                                          of water treatment. Polluted water, as well as water-borne and related\\n                                          diseases, not only cause misery, morbidity and mortality but also impose\\n                                          high socio-economic costs through loss of human productivity and potential.\\n                                          Water quality management is also affected by low institutional capacity,\\n                                          inadequate implementation and enforcement of the legal provisions for\\n                                          water quality management, limited understanding and utilisation of water\\n                                          quality data, and inadequate information sharing among institutions and\\n                                          communities.\\n\\n                                          Water quality management in water supply and distribution networks in\\n                                          both urban and rural areas is challenged by pollution from both point and\\n                                          non-point sources; inadequate monitoring and assessment systems; non-\\n                                          compliance with drinking water standards by some utilities; inadequate\\n                                          water treatment; limited research on drinking water quality, storage\\n                                          and treatment; and a lack of adapted and practicable technologies and\\n                                          strategies for water quality management in rural areas for both man-\\n                                          made facilities such as small dams and natural water collecting facilities.\\n                                          Water quality management in water supply networks for rural areas was\\n                                          not stipulated in NAWAPO 2002. The new version has emphasised water\\n                                          quality in rural projects.\\n\\n                                          The government and other stakeholders have taken initiatives to manage\\n                                          wastewater quality and control pollution. These include advising on\\n                                          ways to legally manage discharges of pollutants from various sources to\\n                                          protect public health and integrity of ecosystems. The Government has\\n                                          also been regularly reviewing wastewater discharge standards to enhance\\n                                          the management of effluent prior to discharge to the environment. These\\n                                          initiatives have achieved only 60 per cent compliance. Some industries\\n                                          have no wastewater treatment facilities, resulting in toxic substances\\n\\n\\n\\n             12\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\nbeing discharged directly into the environment. Haphazard wastewater\\ndischarges have contaminated water sources, threatening public and\\necosystem health. This highlights the need for more efforts to increase\\ncompliance. There is also limited research and development on wastewater\\ntreatment technologies leading to inadequate and ineffective proactive\\nmeasures to curb pollution. Similarly, water quality management facilities\\nwere not given priority in rural areas during the implementation of NAWAPO\\n2002. This was because the small projects that were implemented in such\\nlocalities had no serious pollution challenges. Also, there was no priority in\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nmanaging wastewater in rural areas as people used traditional pit latrines.\\nHowever, with change of lifestyles in rural areas where modern houses\\nare being built, there is a need to address management of wastewater and\\nhence the reviewed policy will give high priority to wastewater management\\nin both rural and urban areas.\\n\\n1.2.4 Access to Water Supply Services and Water Management\\nSystems\\n\\n1.2.4.1 Access to Water Supply Services\\nAccess to water supply services for rural and urban populations has\\nincreased since 2002. In rural areas, access has increased from 50 per\\ncent in 2002 to 83 per cent in June 2024. This improvement is as a result\\nof Government investment in the construction of new water projects,\\nand rehabilitation and extension of existing ones. As of June 2024, 2,943\\nwater projects with 169,515 water points were constructed in rural areas,\\nincluding 194,591 house connections. Some of the water projects being\\nconstructed in the rural areas are big enough to serve more than one\\nvillage. Also, other villages benefit from water transmission mains for\\ntowns. These initiatives have enabled 34,950,360 out of 39,232,990 people,\\nas per the 2022 census, to access water supply services in rural areas.\\n\\nDespite these achievements, some challenges are notable. NAWAPO 2002\\ndirectives require a water point to serve 250 people within a distance of not\\nmore than 400 meters. This has proved impractical because of the scattered\\nnature of settlements. Furthermore, small water projects were intended\\nto serve small communities, with beneficiaries contributing to investment\\ncosts. However, population growth and water demand have outstripped\\nadvances in water supply. Currently, the Government is developing large\\nand high-tech projects intended to serve many villages. With these types\\nof projects, it is difficult for communities to contribute to investing and\\n\\n\\n\\n    13\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          operating new water schemes or extend their water supply service outside\\n                                          areas designated by the Government at the time. Therefore, the NAWAPO\\n                                          2002 directives were not sufficient to respond to rural developments. In\\n                                          this regard, the policy need to be reviewed to include more adaptable\\n                                          and multi-pronged strategies to address the rapidly changing situations\\n                                          especially in rural areas.\\n\\n                                          In urban areas, access to water supply services increased from 73% in 2002\\n                                          to 91.6% in 2024. This improvement results from Government initiatives to\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          invest in water supply infrastructure, including developing water sources,\\n                                          transmission mains, water treatment plants, storage reservoirs or tanks,\\n                                          distribution networks, customer connections and water meters. These\\n                                          efforts have significantly expanded the water networks in regional centres,\\n                                          which have extended from 8,662 kilometres in 2015 to 27,534 in 2024.\\n\\n                                          Likewise, the cumulative storage tanks capacity increased from 712,933\\n                                          cubic meters to 857,900 cubic meters by 2024. Water supply services in\\n                                          urban areas are expected to continue improving, as most regional water\\n                                          utilities have the potential to expand their customer base, generating more\\n                                          revenue to fund service extensions and new connections.\\n\\n                                          Despite the achievements in providing water services to urban areas\\n                                          under the NAWAPO 2002, the assessment shows that the quantity of\\n                                          water available per person remains below national standards, and some\\n                                          households still need to travel long distances to fetch water. Additionally,\\n                                          the assessment highlights Tanzania\\u2019s growing population and economy.\\n                                          Population is expected to reach 138 million by 2050, with 50 per cent living\\n                                          in urban areas. There will thus be a significant increase in water demand.\\n                                          Battered water infrastructures and increasing population density due to\\n                                          unplanned urbanisation present further challenges.\\n\\n                                          The rapid population growth has outpaced the capacity of existing\\n                                          infrastructure, reducing the quality of water services. Economic growth\\n                                          in urban areas has also increased the water demand. As cities expand,\\n                                          slum-like peri-urban areas have emerged, requiring new investments in\\n                                          water supply infrastructure. The deterioration of existing infrastructure\\n                                          has resulted in higher Non-Revenue Water, thus undermining the ability\\n                                          of water utilities to cover operational and maintenance costs.\\n\\n\\n\\n\\n             14\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\n1.2.4.2 Water for Other Uses\\nNAWAPO 2002 outlined three key areas of water demand i.e domestic use,\\nenvironmental needs and economic activities. During its implementation,\\nthe policy focused primarily on meeting water needs for domestic and\\npastoral communities. However, with significant rural and urban economic\\ngrowth, it is necessary to widen the scope to focus more on ensuring water\\nsecurity rather than meeting water needs.\\n\\nCurrently, water demand for agriculture, hydropower, mining industry,\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nenvironmental services, and other sectors is rising due to increased\\neconomic activities. Despite the importance of water in these sectors, there\\nhas been minimal cross-sectoral planning on water issues. Joint planning is\\nuseful especially to avoid duplication of efforts e.g inadvertently allocation\\nof a water source for multiple purposes of which could have a direct impacts\\non downstream water users. Joint planning would trigger early warning\\nsystems for overuse of water sources, enhance water productivity, and\\nprevent duplication and wastage of public resources. The revised policy\\nemphasises cross-sectoral coordination in design and implementation of\\nall water-related projects.\\n\\nAnother area not sufficiently addressed in NAWAPO 2002 is the provision\\nof water services to public institutions such as schools, markets and\\nhealth facilities. Adequate water supply to these facilities is essential for\\nhygiene, drinking, medical use, cleaning, sanitation, and overall well-being\\nof surrounding environment. By 2019, through the WASH initiative, the\\nGovernment had provided water access to 2,105 health facilities through\\ntap connections and 3,220 through rainwater harvesting storage tanks.\\nAdditionally, 8,832 out of 19,995 schools gained access to clean and safe\\nwater through tap connections, wells, and rainwater harvesting storage\\ntanks. Integrating water supply, sanitation services and hygiene education\\nhas been a priority in improving health conditions, particularly in rural\\nareas. However, the lack of inter-sectoral planning has led to gaps in\\naccessing clean water in some institutions.\\n\\nWater supply for livestock is also crucial in rural areas where over 70%\\nof Tanzania\\u2019s livestock is reared. Water projects must, therefore, include\\nprovision for watering livestock, as prescribed and outlined in the Design,\\nConstruction, Supervision, and Operation and Maintenance Manual\\n(2020). By June 2024, the Government had constructed 1,384 Charco dams\\nand 458 cattle troughs and drilled 103 boreholes for providing water to\\n\\n\\n\\n    15\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          livestock. Inadequate water supply for livestock leads to herders migrating\\n                                          in search of water. This can result in land degradation, contamination and\\n                                          destruction of water sources and infrastructure, and conflicts among water\\n                                          users. The reviewed policy includes directives to promote water supply for\\n                                          livestock in rural areas through inter-sectoral cooperation and dialogue\\n                                          with all stakeholders.\\n\\n                                          1.2.4.3 Management of Water Supply Services\\n                                          The Water Supply and Sanitation Act No. 5 of 2019 assigns responsibility for\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          water supply and sanitation services to water entities. In rural areas, this\\n                                          mandate is bestowed to Community-Based Water Supply Organisations\\n                                          (CBWSOs), which manage water schemes, collect water tariffs, and manage\\n                                          operational and maintenance (O&M) costs. CBWSO leadership is elected\\n                                          at village meetings and is tasked to employ a technician for maintenance\\n                                          works and an accountant to manage funds. As of June 2024, 1,018 CBWSOs\\n                                          were registered, serving 9,203 villages. The Rural Water Supply and\\n                                          Sanitation Agency (RUWASA) was also established to improve water and\\n                                          sanitation services in rural areas. It is mandated to construct and monitor\\n                                          rural water projects and ensuring the sustainability of rural water supply\\n                                          services. While RUWASA oversees and regulates rural water services, its\\n                                          dual role in construction and regulation may create conflict of interest or\\n                                          lack of impartiality in their mandate.\\n\\n                                          In rural areas, water service beneficiaries are expected to contribute\\n                                          to investment costs and pay tariffs to cover O&M costs. Some water\\n                                          schemes function well, while others struggle because of poor resource\\n                                          management. This includes disinterest among people in paying for water\\n                                          services, inadequate capacity of CBWSO leadership, and theft or damage\\n                                          of water infrastructure. All these threaten sustainability of rural water\\n                                          service delivery. The review of NAWAPO will address these challenges in\\n                                          rural water services especially operational and regulatory issues.\\n\\n                                          In urban areas, the Minister responsible for Water is empowered to\\n                                          establish Water Supply and Sanitation Authorities (WSSAs). By 2024,\\n                                          there were 88 WSSAs providing water and sanitation services in urban\\n                                          centres. Their primary function is to ensure efficient and equitable water\\n                                          supply by implementing Water Demand Management (WDM) strategies.\\n                                          These include technological, economic, institutional, and communication\\n                                          measures to promote sustainable water use. To maintain high-quality\\n                                          water supply services in urban areas, WSSAs must minimise non-revenue\\n\\n\\n\\n             16\\n                                                 THE UNITED REPUBLIC OF TANZANIA\\n                                                              MINISTRY OF WATER\\n\\n\\n\\n\\nwater (NRW), increase water production, assess water use through\\nwater meters, apply appropriate tariffs, and set aside funds for service\\nexpansion and infrastructure rehabilitation. The Government typically\\ncarries out major water projects requiring significant investment in\\ncollaboration with development partners. The National Water Fund (NWF)\\nprovides financial support to WSSAs through soft loans for rehabilitation\\nand service expansion projects. Between 2015 and 2024, several major\\nwater projects were completed, including the Tabora\\u2013Igunga\\u2013Nzega,\\nMugango\\u2013Kiabakari\\u2013Butiama, Orkesumet and Arusha City projects. These\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nefforts reduced national average of NRW from 43% to 36.6%, increased\\nthe metering ratio from 95.4% to 99.9%, boosted water production from\\n234.50 MCM to 334.7 MCM per year, and promoted the use of appropriate\\ntariffs to minimise wasteful water use.\\n\\nChallenges in urban water service provision include the increasing water\\ndemand, which is not matched by the expansion of supply services. For\\ninstance, cumulative water demand in all regional centres increased from\\n435.04 MCM in 2015 to 681.87 MCM in 2024 due to rapid urbanisation,\\nincreased economic activities, and inefficient water use. While the\\nGovernment continues to establish water projects and commission them to\\nWSSAs, the authorities are responsible for collecting water tariffs and using\\nthe same to cover O&M costs, including minor rehabilitation. Investment\\nin major infrastructure rehabilitation remains the responsibility of the\\nGovernment. Despite the substantial investments by the Government,\\nleakages and illegal connections contribute to high NRW, leading to\\nrevenue loss, poor service delivery, and water rationing. The revised policy\\nwill emphasise effective water supply management to ensure sustainability\\nand high-quality water services in urban areas.\\n\\n1.2.5 Sanitation\\nSanitation encompasses a broader system of managing waste and ensuring\\na clean environment and prevent the spread of diseases. It includes\\nproviding and maintaining facilities for the proper disposal of human\\nexcrement, managing wastewater, and promoting good hygiene practices.\\nIt involves constructing and maintaining toilets and latrines, waste collection\\nand treatment, installing hygiene facilities, and public education on health\\nand cleanliness. Implementing and promoting sanitation in the country,\\nincluding hygienic behaviour and solid waste and stormwater management,\\nis crucial because they are all related to human health, cleanliness and\\nenvironmental entegrity. All these require collaborative actions among\\n\\n\\n\\n    17\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          various actors, including the Ministry of Health, which deals with sanitation\\n                                          and hygiene in rural areas; the Ministry of Education, dealing with school\\n                                          sanitation and hygiene; and Local Governments, dealing with sanitation\\n                                          in their areas, including solid waste and stormwater management. There\\n                                          has been fragmented planning among these key stakeholders dealing with\\n                                          overall issues of sanitation and effective coordination is required.\\n\\n                                          Wastewater is generated from different sources including domestic water\\n                                          use which 80% of its water supplies is converted to wastewater. Other\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          sources include industrial processes and mining. Wastewater usually\\n                                          contains toxic substances or biological process inhibitors. Therefore, it\\n                                          must be treated before being discharged into the environment. In the last\\n                                          20 years, there has been a slight increase in access to sanitation facilities\\n                                          and services to safely dispose of human excreta. By 2024, 11 regional\\n                                          centres out of 26 had constructed sewered sanitation infrastructure with\\n                                          an average access of 13 per cent. The regions are Dodoma, Songea, Iringa,\\n                                          Arusha, Tanga, Moshi, Mbeya, Tabora, Morogoro, Mwanza and Dar es\\n                                          Salaam. The Government has been constructing sewerage networks and\\n                                          waste stabilisation ponds in different areas of the country.\\n\\n                                          Construction of conveyance infrastructure has increased the length of\\n                                          the sewer network from 652.29 kilometres in 2010 to 1,477.63 kilometres\\n                                          in 2024 in regional centres. The remaining 15 regions use non-sewered\\n                                          sanitation, and in some townships, the Government has constructed\\n                                          faecal sludge treatment facilities. These are Kahama, Nansio, Sengerema,\\n                                          Sumbawanga, Kigoma, Geita, Lamadi, Musoma, Magu, Misungwi, Lindi,\\n                                          Bukoba and Arusha. Emptying and transporting faecal sludge in areas\\n                                          without a sewerage network is through public and private exhauster trucks.\\n\\n                                          During the implementation of NAWAPO 2002, although there was some\\n                                          emphasis on constructing sewerage systems in urban centres, it was\\n                                          insufficient because more attention was on providing potable water\\n                                          and relatively low investments were channeled to sanitation. This has\\n                                          resulted in inadequate sewerage network and treatment facilities, unsafe\\n                                          sludge disposal and dilapidated sewerage infrastructure. Investment in\\n                                          sanitation infrastructure has been low because of high costs and limited\\n                                          financial resources. Access to sewage removal and treatment services\\n                                          has, therefore, been unsatisfactory. For example, by June 2024, availability\\n                                          of sewerage service was only 13 per cent in regional centres. For other\\n                                          urban areas, sewage disposal service is being provided using wastewater\\n\\n\\n\\n             18\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\ntrucks. Another challenge in wastewater management is ineffective\\nregulatory monitoring and unreliable enforcement of minimum quality of\\nservice in each segment of the non-sewered sanitation chain. This results\\nin non-emptiable toilets, leaking containments, unsafe emptying and\\ntransportation facilities and inadequate faecal sludge treatment facilities.\\nFor rural areas, NAWAPO 2002 remained silent, and no investment has\\nbeen made in sewage disposal in such localities. Communities use pit\\nlatrines, which are abandoned when they are full. Enhanced socio-economic\\ndevelopment in rural areas has empowered people to construct modern\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nhouses requiring wastewater treatment facilities, including faecal sludge\\ncollection. Untreated wastewater adversely affects the environment,\\ncausing contamination and pollution of surface and groundwater sources.\\nThe reviewed policy considers wastewater infrastructure construction in\\nrural and urban areas.\\n\\n1.2.6 Private Sector Participation\\nThere has been a deliberate effort by the Government to enhance Private\\nSector Participation (PSP) in the water sector especially in supporting the\\nprovision of goods and water services to the public. The Government\\nhas multiple national responsibilities and faces financial constraints and\\nhence it\\u2019s prudent to seek alternatives sources of funds to support the\\nwater sector. The private sector is often more advanced in leveraging skills\\nand efficiencies - bringing in new technologies, sharing risks and providing\\nfinancing to accelerate development that aligns with the inclusive objectives\\nof the Government. In Tanzania, the government has created an enabling\\nenvironment for PSP, including the enactment of the Public Private\\nPartnership Policy (2009), the Public Private Partnership (Amendment)\\nAct, 2023, and the Public Private Partnership Regulations (2020). NAWAPO\\n2002 identifies the private sector as among the key partners in supporting\\ngovernment initiatives to provide water supply and sanitation services.\\n\\nNAWAPO 2002 emphasises the construction of water infrastructure,\\nrehabilitation and building the capacity of WSSAs to operate commercially\\nas areas that the private sector could invest and or add value. Various\\ninitiatives have been undertaken to implement the policy directive,\\nincluding capacity building at all levels in the sector through PPP training,\\ndevelopment of project concept notes, and convening forums to discuss\\nPSP development. Achievements realized include motivated Implementing\\nAgencies (IAs) to engage the private sector, some of which have already\\ndeveloped a pipeline of projects. Tanga WSSA has managed to prepare\\n\\n\\n\\n    19\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          a project that has raised about TZS 53 billion through Green bonds, and\\n                                          other WSSAs are preparing projects of the same nature. Despite these\\n                                          achievements, PSP in water resources has been limited, relying mainly\\n                                          on corporate social responsibility (CSR) activities, consultancy services,\\n                                          project construction and provision of goods and services. NAWAPO 2002\\n                                          evaluation report shows that the private sector not motivated to invest\\n                                          and operate water projects due to relatively high investment costs and\\n                                          long payback periods. Moreover, Section 76 of the Water Supply and\\n                                          Sanitation Act No. 5 of 2019 and Regulation 14(1) of the Water Supply\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          Regulation of 2019 requires a private entity to vacate a service area once\\n                                          a water authority extends its operations to the area earlier serviced by the\\n                                          private service provider. These legal directives discourage private sector\\n                                          investment and operation in water projects.\\n\\n                                          To attract PSPs to the water sector, the reviewed policy will prioritise creating\\n                                          a conducive and supportive environment to encourage private sector\\n                                          engagement and investments. The Government will create opportunities\\n                                          for private sector partners as part of an integrated strategy, placing them\\n                                          alongside government funded water schemes in non-viable areas.\\n\\n                                          NAWAPO 2002 also directed the privatisation of water supply and sewerage\\n                                          entities in small urban centres to improve water supply and sewerage\\n                                          services. According to the policy, water supply and sewerage entities in small\\n                                          urban centres were to be encouraged to form private liability companies\\n                                          or any other legal autonomous commercial arrangement. Attempts to\\n                                          privatise service provision in other sectors showed unfavourable results\\n                                          and hence the policy directive was not implemented. This prompted the\\n                                          Government to change the mode of engagement from privatisation to\\n                                          public-private partnerships. PPP policy, legislation and guidelines have\\n                                          been prepared and are used to engage the private sector. The review of\\n                                          this policy considers changing the modality of private sector engagement\\n                                          in line with the PPP enabling environment.\\n\\n                                          1.2.7 Research and Technology Development\\n                                          NAWAPO 2002 emphasised strengthening the capacity of Research\\n                                          and Development (R&D) through enhancing collaboration with sector\\n                                          stakeholders and local and international research institutions. The objective\\n                                          was to undertake strategic water sector research initiatives, establish water\\n                                          resources research and technological development centres, and encourage\\n                                          local researchers to take lead in such strategic initiative. To this end, the\\n\\n\\n\\n             20\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\nGovernment has established the Water Resources Center of Excellence\\n(WRCoE) and conducted a few research studies on water-related issues.\\nResearch institutions, including the University of Dar es Salaam, Sokoine\\nUniversity of Agriculture (SUA), Nelson Mandela African Institution of\\nScience and Technology and others, have continued to conduct academic\\nresearch in the water sector. However, the challenge is bridging the gap\\nbetween academic findings and practical applications that could directly\\nbenefit the sector. Furthermore, the Water Institute (WI), a college under\\nthe Ministry of Water, undertakes research related to water and sanitation,\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nbut the scope and dissemination of its findings remain limited. Similarly, the\\nNgurdoto Defluoridation Research Center has produced groundbreaking\\ninnovations in safe water provision. However, the Center\\u2019s potential is not\\nfully exploited. A stronger focus on prioritising and facilitating strategic\\nresearch and development within the water and sanitation sector is\\nimperative to address these challenges. It is also acknowledged that most\\nof the research undertaken is externally funded through partnerships\\nwith international institutions. For the water sector to maximumly benefit\\nfrom local research efforts, a dedicated commitment is required to fund\\nstrategic research in earmarked sectoral areas of concern through public\\nresources. This is also supported by the NAWAPO 2002 assessment report\\nthat highlights that the reviewed policy will need to motivate the sector to\\nadopt local emerging innovations and technologies by investing in R&D. In\\nthe long run, this will generate additional revenue and improve operational\\nefficiency.\\n\\n1.2.8 Cross-Cutting Issues\\n\\n1.2.8.1 Environmental and Climate Change Resilience\\nNAWAPO 2002 directed environmental and climate change issues to be\\nconsidered during the planning, preparation and implementation of water\\nresource management and in water supply and sanitation projects. This\\nis due to inherent impacts of climate change on water availability in the\\ncountry. Water is a finite resource with existential importance and currently\\nunder pressure, getting scarcer, due to growing population and increased\\nmulti-sectoral demands. Primary livelihood and development strategies\\nstrongly rely on extracting natural resources from the environment,\\nwith limited options for decoupling economic growth and resource use.\\nThe increase in temperature, due to climate change, has affected water\\navailability as well as functionality and sustainability of some water supply\\nand sanitation works. Temperatures over the highland areas have been\\n\\n\\n\\n    21\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          rising, while rainfall has been decreasing amid seasonal shifts in rainfall\\n                                          patterns in most parts of the country. Other areas have continued to\\n                                          receive heavy rains leading to hazardous floods. These are attributed to\\n                                          changing of hydrological cycle triggered by increase in temperatures. The\\n                                          impacts of such changes are observed not only in water resources but also\\n                                          in water and sanitation works.\\n\\n                                          To ensure environmental issues are considered, the Government has\\n                                          developed various environmental and social safeguard frameworks to\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          protect and manage water sources and associated water and sanitation\\n                                          infrastructure. These include the National Climate Change Strategy\\n                                          of 2021, the Environmental and Social Management Framework, the\\n                                          Resettlement Management Framework, the Climate Resilient Water Safety\\n                                          Plans Preparation Guidelines, and Guidelines for Good Environmental and\\n                                          Social Practices for the Water and Sanitation Sector. These frameworks\\n                                          have facilitated government\\u2019s implementation of the Simiyu Climate\\n                                          Resilience Project, Climate Adapted Urban Infrastructure, and Integrated\\n                                          Water Resources Management Programs.\\n\\n                                          The construction of the Kidunda dam along the Ruvu River is intended\\n                                          address the impacts of climate change on river flows in the Ruvu river. The\\n                                          frameworks and other initiatives have facilitated building the resilience\\n                                          of communities that have adversely been impacted by climate change. In\\n                                          addition, the frameworks have improved compliance to environmental\\n                                          and social safeguard mechanisms through training, providing technical\\n                                          support on enhancing compliance of water and sanitation projects to\\n                                          guidelines on environmental and social safeguard, and undertaking\\n                                          environmental audits on the implementing agencies.\\n\\n                                          Furthermore, compliance with environmental and social safeguard\\n                                          requirements to address hydrological ecosystems and climatic matters\\n                                          has gradually improved due to increased awareness among water and\\n                                          sanitation practitioners. The impact of compliance with environmental and\\n                                          social safeguard requirements in the water sector cuts across different\\n                                          sectors and hence enhances collective initiatives on environmental\\n                                          conservation and protection. These have led to social stability, protection,\\n                                          and conservation of water and sanitation infrastructure and natural\\n                                          systems.\\n\\n                                          Despite the government\\u2019s efforts to address concerns on environmental\\n                                          and social safeguard in the water sector, land degradation, deforestation,\\n\\n\\n             22\\n                                               THE UNITED REPUBLIC OF TANZANIA\\n                                                            MINISTRY OF WATER\\n\\n\\n\\n\\nand pollution have continued to be a challenge.\\nBesides, competing water use demands, inadequate enforcement of\\nwastewater management and implementation of some projects without\\nadherence to environmental and social guidelines have led to environmental\\ndegradation, pollution and social grievances, which significantly affect\\nsocio-economic development.\\n\\nSome of the existing rainwater harvesting structures, such as charco\\ndams, are located specifically to intercept surface water run-off of which\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nis expected to flow downstream for environment and other water uses. In\\nthis regard, research is needed to explore sustainability issues, address\\nenvironment concerns and possibility of utilising such waterworks in\\neffectively channelling and managing floodwaters, feeding secondary\\nwater storage systems and increasing drought resilience.\\n\\nIn addition, natural disasters (floods and droughts) induced by climate\\nvariability and climate change has led to various environmental impacts\\nincluding decreased or increased runoff in rivers, prolonged dry periods,\\nerratic rainfall, and sea level rise. The latter has often led to seawater\\nintrusion affecting freshwater resources along the coastal areas. The\\nreviewed policy will promote strengthening environmental safeguards and\\nclimate resilience in the water sector to overcome identified challenges.\\n\\n1.2.8.2 Gender\\nNAWAPO 2002 emphasised active and effective participation of women and\\nmen in rural water supply programs through fair representation of women\\nin village water-user entities. Water supply programs were established\\nbased on what both men and women in rural communities knew, wanted,\\ncould manage, maintain and pay for. This was on and above raising\\nawareness, training, and empowering women to actively participate at\\nall levels of implementing water programmes, including decision-making,\\nplanning, supervision, and management.\\n\\nThis policy directive has been implemented where gender has been\\nmainstreamed ensuring equity and equality in managing water resources\\nand services related to access to clean and safe water as well as sanitation\\nservices. In 2005, the Government prepared the National Strategy for\\nGender Development (NSGD), which provides guidance on promoting\\nequity, equality and empowerment of women, men and vulnerable\\ngroups. Also, the Ministry of Water prepared a gender strategy to guide the\\nparticipation of women and men in management, decision-making, use\\n\\n\\n    23\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          and operation of water resources, water supply and sanitation services.\\n                                          In implementing the policy directive, gender mainstreaming in rural water\\n                                          supply has shown notable success in enhancing equity and efficiency.\\n                                          Women, often the primary water collectors and users in rural areas, have\\n                                          continued to be involved in planning and decision-making. This has made\\n                                          water projects more responsive to the community\\u2019s needs. For example,\\n                                          gender equity has been noted in management positions, decision-making,\\n                                          operations and implementation of water projects in the country. As of\\n                                          2022, out of 9,207 employees in water sector institutions, 2,762 are women,\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          equal to 30 per cent of the total workforce. Despite women increasing their\\n                                          presence in decision-making roles in the water sector, progress has been\\n                                          uneven across the different institutions. In the 2020-2024 period, women\\n                                          accounted for an average of 35 per cent of Ministry of Water leadership,\\n                                          37 per cent of the National Water Fund, 22 per cent of Basin Water Board\\n                                          directors, and six per cent of WSSA leadership. Within RUWASA, women\\n                                          comprise 28 per cent of managers and directors and 14 per cent of regional\\n                                          managers.\\n\\n                                          Additionally, gender considerations in the water sector have empowered\\n                                          women, increasing their participation in local governance and development\\n                                          activities. This inclusive approach ensures that water supply systems are\\n                                          more effectively managed and contributes to broader social and economic\\n                                          benefits by fostering gender equality and community resilience. Despite\\n                                          the achievements, women and girls remain disproportionally affected\\n                                          by water challenges, for example, carrying the burden of care duties for\\n                                          family members suffering from water-borne diseases, lack of good hygiene\\n                                          facilities in schools, and spending more time and effort to collect water\\n                                          and other resources from degrading ecosystems. The reviewed policy\\n                                          will continue to assess gender disparities in decision-making and access\\n                                          to water to ensure the water sector draws on the capabilities of women,\\n                                          youth and the disable and responds to their needs.\\n\\n                                          1.2.8.3 Good Governance\\n                                          NAWAPO 2002 does not have directives for promoting good governance\\n                                          in the water sector. However, good governance practices have been\\n                                          adhered to using various guidelines issued by the Ministry that are aligned\\n                                          with the same. Good governance in the water sector has improved the\\n                                          sustainable and equitable use and distribution of water while ensuring\\n                                          better use of water resources and effective delivery of water supply and\\n                                          sanitation services. Accountability and integrity in the provision of water\\n\\n\\n\\n             24\\n                                             THE UNITED REPUBLIC OF TANZANIA\\n                                                          MINISTRY OF WATER\\n\\n\\n\\n\\nservices have improved through greater transparency regarding water\\nuse fees, active stakeholders\\u2019 engagement and effective management in\\nimplementation of water supply and sanitation projects. There has been\\nincreased community participation in water resources management and\\nwater supply and sanitation services through community governing bodies\\nsuch as WSSA Boards, Water Users Associations (WUAs) and CBWSOs that\\nadhere to good governance. This has increased communities\\u2019 awareness of\\nwater charges, thus making them more willing to pay for various services.\\n\\n\\n\\n\\n                                                                               National Water Policy 2002 Version 2025\\nGood governance in the water sector is a priority issue and hence the\\nreviewed policy has provided targeted policy statements for promoting\\nits functionality in all thematic areas of management and development of\\nwater resources, water and wastewater quality, and water supply services\\nprovision.\\n\\n\\n\\n\\n    25\\n                                          THE UNITED REPUBLIC OF TANZANIA\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\n\\n\\n\\n\\n             26\\n   Chapter\\n\\n\\n    2\\n\\n                  National Water Policy 2002 Version 2025\\nRationale,\\nVision, Mission\\nand Objectives\\n\\n\\n\\n\\n                               27\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                RATIONALE, VISION, MISSION AND OBJECTIVES\\n\\n                                          2.1 Rationale and Justification\\n                                          The foundation of NAWAPO 2002 was the management of water resources\\n                                          and delivery of water supply in both urban and rural areas. However, over\\n                                          the last twenty-three years of implementing the policy, the water sector\\n                                          has experienced biophysical changes and socio-economic transformation\\n                                          in urban and rural areas, requiring a new policy focus on ensuring water\\n                                          security and service delivery. The new policy focus must also align with the\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          Tanzania Development Vision 2050, emphasising climate resilience and\\n                                          water security. The latter may include constructing strategic water storage\\n                                          and reticulated infrastructure for enhancing water security and resilience\\n                                          against risks associated with climate change and water-related disasters.\\n                                          In particular, some of the key gaps that were noted in NAWAPO 2002 and\\n                                          have been addressed in the revised policy include:\\n\\n                                          2.1.1 Community Contribution and Management of Water Projects in\\n                                          Rural Areas\\n                                          NAWAPO 2002 had provided that, for the sustainability of rural water\\n                                          schemes, they were best owned and managed by the communities. The\\n                                          policy also required beneficiaries in rural areas to contribute financially\\n                                          or in kind to the construction of water supply projects. However, due to\\n                                          diminished freshwater sources caused by climate change and impacts of\\n                                          land use change, the government is currently constructing large water\\n                                          projects that draw water from reliable sources that are not necessarily\\n                                          close to service delivery areas. The construction, technology and operation\\n                                          costs of these projects are high and need special attention and expertise.\\n                                          Hence, communities cannot own or operate them. The revised policy\\n                                          provides for managing and operating rural water projects by entities\\n                                          with the requisite capacity to deliver services at the desired standards.\\n                                          Such an approach enhances the resilience of the infrastructure and the\\n                                          water supply services. The revised policy also encourages communities,\\n                                          especially those in underserved areas, to improve water access by utilising\\n                                          sources within their reach, while at the same time the Government creates\\n                                          an enabling environment for them.\\n\\n                                          2.1.2 Sanitation Services in Rural Areas\\n                                          NAWAPO 2002 recognised the importance of sanitation in both urban and\\n                                          rural areas. However, while the policy provided for hygiene and sanitation\\n                                          education in rural areas, it did not emphasise the construction of sewage\\n\\n\\n\\n             28\\n                                              THE UNITED REPUBLIC OF TANZANIA\\n                                                           MINISTRY OF WATER\\n\\n\\n\\n\\nconveyance and disposal infrastructure. In addition, the policy did not\\naddress wastewater quality management, and as a result, the requisite\\nwastewater infrastructure to complement water supply services was not\\nconstructed in rural areas.\\n\\nDue to the ongoing socio-economic transformation in rural areas that\\ninvolves the construction of modern houses, the provision of total\\nsanitation services, including sewage management, needs to be covered in\\nthe revised policy. This will ensure the implementation of integrated water\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nsupply and sanitation projects and prioritising and supporting initiatives\\nthat improve effluent quality in rural areas.\\n\\n2.1.3 Privatization of Water Supply and Sanitation Services in Small\\nTowns\\nNAWAPO 2002 emphasised privatising water supply and sanitation\\nservices in small towns. This policy direction has never been implemented,\\nand privatisation of such entities is no longer a Government priority after\\nthe exercise failed to deliver in other sectors. However, the Government\\nenacted the Public-Private Partnership Policy (PPP) of 2009, establishing a\\nsound and progressive framework for engaging the private sector. In this\\nregard, in alignment with the PPP policy, the revised water policy guides\\nengaging the private sector in investing in water and sanitation services.\\nThis is useful, especially in widening the water sector\\u2019s funding sources.\\n\\n2.1.4 Adaptation to Climate Change and Disaster Management\\nThe impacts of climate change are often manifested through water, either\\nin droughts or floods. The country has continued to experience frequent\\nunprecedented disastrous events such as floods and droughts that have\\nled to loss of lives and property. NAWAPO 2002 did not have adequate\\nprovisions on adaptation measures to climate change in the water\\nsector. For example, it did not provide for integrating climate adaptation\\nand resilience measures in all planning and implementation strategies,\\nincluding establishing integrated flood and drought Early Warning Systems\\n(EWSs).\\n\\nThe lack of integrated EWSs makes the country vulnerable to disasters,\\nwhich can be easily managed by providing adequate lead information to\\nenable relevant authorities to take appropriate measures. The new policy\\nprovides for such measures with a view to enhancing climate resilience\\nand managing disasters in the water sector.\\n\\n\\n\\n    29\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          2.2 Vision, Mission and Objectives\\n\\n                                          2.2.1 Vision\\n                                          A water-secure country with equitable, sustainable, accessible, affordable,\\n                                          and reliable water and sanitation services for socio-economic development.\\n\\n                                          2.2.2 Mission\\n                                          Through innovative, ethical, and motivated staff, protect and conserve\\n                                          water sources, control water quality and pollution, improve sanitation\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          services, and develop water resources and water supply infrastructure in\\n                                          Tanzania while ensuring climate resilience.\\n\\n                                          2.3 Policy Objectives\\n                                          The main objective of NAWAPO 2002, Version 2025, is to ensure water\\n                                          security for all through optimal, reliable, sustainable, and equitable\\n                                          development and use of water resources in the most cost-effective manner.\\n\\n                                          The specific objectives of this policy are:\\n                                          i)     To enhance sustainable management of water resources;\\n                                          ii)    To improve water resources development;\\n                                          iii) To improve water and wastewater quality management;\\n                                          iv)\\t\\u0007To enhance sustainable water supply services and water management\\n                                                 systems;\\n                                          v)     To enhance reliable and sustainable sanitation services;\\n                                          vi) To strengthen private sector participation in the water sector;\\n                                          vii)\\t\\u0007 To enhance research and technology development in the water\\n                                                 sector; and\\n                                          viii)\\t\\u0007To promote cross-cutting issues, which include environmental and\\n                                                 climate change resilience, gender and good governance.\\n\\n\\n\\n\\n             30\\n  Chapter\\n\\n\\n    3\\n\\n                 National Water Policy 2002 Version 2025\\nPolicy Issues,\\nObjectives and\\nStatements\\n\\n\\n\\n\\n                              31\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                     POLICY ISSUES, OBJECTIVES AND STATEMENTS\\n\\n                                          This chapter highlights policy issues, objectives, and statements.\\n\\n                                          3.1 Sustainable Management of Water Resources\\n                                          Effective water resources management requires an adequate understanding\\n                                          of the balance between available water resources and water demand.\\n                                          This has to be based on robust data and information to facilitate strategic\\n                                          decision-making processes. There is inadequate data and information\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          on key areas, including water availability, water requirements for various\\n                                          uses, and water productivity for assessing and managing competing water\\n                                          demands. Management of water resources is also affected by different\\n                                          factors, including (i) inefficiency in existing water use technologies, (ii) illegal\\n                                          water use, (ii) high non-revenue water, (iii) inefficient irrigation practices,\\n                                          (iv) inefficient abstraction control facilities, and (v) ineffective preparedness\\n                                          to water-related disasters such as floods and droughts.\\n\\n                                          In addition, the framework for implementing Integrated Water Resources\\n                                          Management Plans (IWRM) requires all sectors using and or dependent on\\n                                          water resources to plan together, especially on water-related projects that\\n                                          serve multiple socio-economic needs. This includes dams that supply water\\n                                          for domestic water, irrigated agriculture, electricity production, drought\\n                                          and flood control, among others. Lack of collaborative planning and\\n                                          coordination in implementing IWRM plans among sectors has sometimes\\n                                          caused duplication of efforts and wastage of resources.\\n\\n                                          There are also natural rainwater harvesting structures, man-made ponds,\\n                                          rural water pans and pit lakes, which are poorly monitored or not well\\n                                          documented with proper guidelines on their sustainable use. In addition,\\n                                          the rate of encroachment of water sources to create space for other socio-\\n                                          economic developments is increasing to the extent that the sustainability of\\n                                          water resources in many localities is being threatened. Such bad practices\\n                                          and illegal activities can be controlled and managed through effective\\n                                          stakeholder engagement processes, especially at the community level.\\n                                          Moreover, management of transboundary water resources is hampered by\\n                                          inadequate capacity of sectoral institutions, lack of effective management\\n                                          of transboundary water resources among riparian member states,\\n                                          differences in socio-economic set-ups and priorities between member\\n                                          states, geopolitics, and competition over water allocation, security, and\\n                                          uses.\\n\\n\\n\\n             32\\n                                                  THE UNITED REPUBLIC OF TANZANIA\\n                                                               MINISTRY OF WATER\\n\\n\\n\\n\\nPolicy Objective\\nTo enhance sustainable management of water resources.\\n\\nPolicy Statements\\nThe Government, in collaboration with stakeholders, shall:\\ni)\\t\\u0007ensure water resources data, information, and early warning systems\\n      are available for informed decision-making;\\nii)\\t\\u0007ensure effective water resources assessment for determining water\\n      availability, quality, distribution, scarcity, pollution and climate change\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\n      impacts;\\niii)\\t\\u0007ensure collaborative planning, allocation and efficient utilisation of\\n      water resources and water demand management across sectors;\\niv)\\t\\u0007ensure water source conservation, protection, pollution control, and\\n      catchment management;\\nv)\\t\\u0007ensure effective management of transboundary water resources for\\n      the interest of the country; and\\nvi)\\t\\u0007\\u0007promote stakeholders\\u2019 awareness of sustainable management of\\n      water resources in both urban and rural areas.\\n\\n3.2 Water Resources Development\\nWater resources development in the country is constrained by various\\nissues, including inadequate investment in strategic water storage and\\nrainwater harvesting systems, limited use of the large natural freshwater\\nlakes, limited inter-basin transfer systems, partial development and non-\\noptimal exploitation of the immense potential of groundwater resources,\\nincluding enhancing recharge systems. This calls for change of approach in\\nthe water sector by aligning more on ensuring water security and quality\\nservice. A good example is envisioning a national water grid system that\\nis able to tap onto sustainable and unlimited water sources e.g lakes\\nand conveying it to all parts of the country through inter-basin transfer\\nschemes. One area that has not been fully explored is maximising the\\ndevelopment of multi-purpose water storage infrastructure to cater for\\ndifferent sectors. Such an approach has the benefit of reducing costs and\\navoiding duplication of efforts while promoting integrated water resources\\nplanning and development. Other areas that have not been fully explored\\nare maximizing the potential of alternative sources of water such as\\nrecycling, reuse of treated wastewater and desalination.\\n\\nPolicy Objective\\nTo improve water resources development.\\n\\n\\n\\n    33\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          Policy Statements\\n                                          The Government, in collaboration with stakeholders, shall:\\n                                          i)\\t\\u0007ensure development and management of climate-resilient multi-\\n                                                purpose water storage infrastructure for socio-economic activities,\\n                                                enhancement of water security, and reduction of drought and flood\\n                                                risks across sectors;\\n                                          ii)   promote rainwater harvesting technologies;\\n                                          iii)\\t\\u0007ensure and coordinate integrated planning, development and\\n                                                management of water resources infrastructure across sectors;\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          iv)\\t\\u0007ensure development and management of inter and intra-basin\\n                                                water transfer infrastructure;\\n                                          v)\\t\\u0007explore and promote the development of alternative sources of\\n                                                water, including recycling of wastewater and desalination; and\\n                                          vi)\\t\\u0007assess and enhance groundwater development and recharging\\n                                                systems.\\n\\n                                          3.3 Water and Wastewater Quality Management\\n                                          Managing the quality of water supplies and wastewater is critical to\\n                                          ecosystem protection and sustaining public health. Ensuring the desired\\n                                          quality of both water supplies and wastewater is essential for protecting\\n                                          and sustaining water resources, guaranteeing the safety of human\\n                                          health and the integrity of the environment. The quality of water and\\n                                          wastewater has continued to face numerous challenges, mainly as a result\\n                                          of anthropogenic activities. Various assessments of water quality have\\n                                          indicated the presence of harmful chemicals with threats of emerging\\n                                          contaminants in water sources. Deterioration of water quality contributes\\n                                          to the spread of water-borne and water-related diseases. It also limits the\\n                                          effectiveness of water treatment and increases the overall cost of ensuring\\n                                          water quality thresholds for different uses.\\n\\n                                          Additionally, water quality management lacks regular monitoring and\\n                                          assessment, particularly in water sources. There is also a lack of ambient\\n                                          water quality standards, inadequate technical and institutional capacity,\\n                                          weak inter-sectoral collaboration among water quality management-\\n                                          related sectors, weak enforcement of existing water quality and wastewater\\n                                          management regulations and inadequate water pollution control.\\n\\n                                          On the other hand, water supply projects in rural areas were constructed\\n                                          without reticulated treatment infrastructure since they were small\\n                                          schemes and sourced water from wells and springs that did not have\\n\\n\\n\\n             34\\n                                               THE UNITED REPUBLIC OF TANZANIA\\n                                                            MINISTRY OF WATER\\n\\n\\n\\n\\nwater quality challenges. However, enhanced socio-economic growth,\\nimproved livelihoods and change of lifestyles in rural areas have led to the\\npollution of previously pristine water sources. In this case, water quality\\nissues must be considered in both urban and rural areas. NAWAPO 2002\\ndid not provide for consideration of water quality in rural water projects.\\nHence, the revised policy has addressed this anomaly by emphasising\\nwater quality issues in rural water projects. Additionally, the revised\\npolicy has addressed issues of technical and institutional capacity, inter-\\nsectoral collaboration, and legal and regulatory framework for water and\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nwastewater quality management.\\n\\nPolicy Objective:\\nTo improve water and wastewater quality management.\\n\\nPolicy Statements\\nThe Government, in collaboration with stakeholders, shall:\\ni)\\t\\u0007Strengthen monitoring and assessment of the quality of water\\n      sources and wastewater for the safety and well-being of the people\\n      and to protect ecosystems and biodiversity;\\nii)\\t\\u0007safeguard public health through monitoring and assessment of\\n      water quality in public and private water supply schemes in both\\n      rural and urban areas;\\niii)\\t\\u0007promote public awareness and education to build public support for\\n      water and wastewater quality management through encouraging\\n      responsible water use and fostering a culture of environmental\\n      stewardship;\\niv)\\t\\u0007enhance water and wastewater quality infrastructure investment to\\n      ensure the delivery of safe drinking water and the safe disposal of\\n      wastewater in rural and urban areas;\\nv)\\t\\u0007enhance inter-sectoral and transboundary water quality\\n      management and\\nvi)\\t\\u0007improve the institutional, legal, and regulatory frameworks for water\\n      and wastewater quality management.\\n\\n3.4 Sustainable Water Supply Services and Water Management\\nSystems\\n\\n3.4.1 Rural Water Supply\\nMost water projects constructed in rural areas were small to meet the\\ngrowing community demands. Furthermore, the scattered population due\\n\\n\\n\\n    35\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          to unplanned rural development has caused challenges in providing water\\n                                          service using domestic water points (DPs) that earlier were designed to\\n                                          serve 250 people in a radius of 400 meters. In addition, climate change has\\n                                          led to drying of boreholes and water springs in some rural areas, especially\\n                                          during dry seasons, making the sources unsustainable and unreliable. All\\n                                          these factors have led to insufficient water supply and sanitation services,\\n                                          as well as poor hygiene, thus contributing to waterborne diseases in\\n                                          rural areas. These challenges disproportionately affect women and girls,\\n                                          who are usually responsible for fetching water and caring for household\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          members who fall sick from contaminated water.\\n\\n                                          High operational and maintenance costs have hampered the sustainability\\n                                          of some rural water schemes. Some CBWSO schemes have depleted their\\n                                          water sources due to impacts of climate change. To address such failures,\\n                                          the Government is currently constructing large water projects that use\\n                                          reliable sources, covering both rural and urban areas. The design and\\n                                          implementation of these projects do not align with the NAWAPO 2002\\n                                          guidance, which directed small water supply projects to be constructed\\n                                          and managed by local communities. The large projects require advanced\\n                                          expertise and technology, which local communities can neither afford nor\\n                                          manage. Likewise, socio-economic transformation in rural areas has led\\n                                          to increased demand for house connections, thus reducing the need for\\n                                          public water points, the model on which CBWSOs are based upon. In this\\n                                          regard, reflecting afresh on service delivery and providing policy directives\\n                                          on restructuring water supply services in rural areas is useful.\\n\\n                                          In addition, separating water requirements for people and livestock\\n                                          has been difficult in rural and semi-arid livestock-keeping communities.\\n                                          Livestock keeping is one of the main economic activities supporting many\\n                                          rural livelihoods. There is a need for the construction of more infrastructure\\n                                          for watering livestock to prevent conflict with and contamination of water\\n                                          for domestic use. This also calls for new designs of water abstraction and\\n                                          treatment systems for domestic water use that can draw water for multi-\\n                                          purpose water uses. The integrated management of such multi-purpose\\n                                          water supply systems needs to be well coordinated to avoid conflicts\\n                                          between competing users.\\n\\n                                          3.4.2 Urban Water Supply\\n                                          In urban areas, water supply services face water demand management\\n                                          challenges due to wasteful water use and unmanageable non-revenue\\n\\n\\n\\n             36\\n                                                 THE UNITED REPUBLIC OF TANZANIA\\n                                                              MINISTRY OF WATER\\n\\n\\n\\n\\nlosses. Increased population density and enhanced economic activities\\nhave strained water service management. Insufficient water production\\nby utilities, increased water demand, and high non-revenue water losses\\nhave led to water rationing and even lack of water supply services in some\\nareas. Nevertheless, the Government has continued to invest in new water\\nsupply infrastructure, including major rehabilitation on some of the water\\ninfrastructure. Plans are underway to design a national water grid that will\\ntap water from reliable water sources for supplying across the country.\\nHowever, some water utilities still depend on the Government for operation\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nand maintenance costs (salaries and electricity), service extension and\\ninfrastructure rehabilitation. These WSSAs must be restructured to enable\\nthem to use their revenues to meet operation and maintenance costs,\\nincluding rehabilitation.\\n\\nSince clean and safe water is a basic need and right for all, entities providing\\nwater services must do so at affordable costs and within a reasonable\\ndistance to reduce time poverty, especially for women and children. The\\nrevised policy has considered this.\\n\\nPolicy Objective\\nTo enhance sustainable water supply services and water management\\nsystems.\\n\\nPolicy Statements\\nThe Government, in collaboration with stakeholders, shall:\\ni)\\t\\u0007develop large-scale water projects, including a national water grid\\n      using reliable water sources for socio-economic development;\\nii)   enhance reduction of non-revenue water to acceptable levels;\\niii)\\t\\u0007ensure rural water supply schemes are effectively regulated,\\n      operated, and managed sustainably by well-capacitated legal\\n      entities;\\niv)\\t\\u0007ensure full cost recovery by water supply and sanitation authorities;\\nv)\\t\\u0007ensure good quality water supply services for household and other\\n      uses;\\nvi)\\t\\u0007ensure sustainability of water supply services in both rural and\\n      urban areas; and\\nvii)\\t\\u0007promote public awareness of the efficient use and management of\\n      water.\\n\\n\\n\\n\\n    37\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          3.5 Reliable and Sustainable Sanitation Services\\n                                          Sewerage infrastructure has been developed in 11 of the 26 regional\\n                                          centres where only 13 per cent of the population in these localities have\\n                                          access to sewerage services. Some areas use faecal sludge facilities to\\n                                          treat wastewater, while others do not have sustainable sanitation services\\n                                          and hence unsafely discharge their wastes into the environment. Provision\\n                                          of sanitation services in the country is limited mainly due to low coverage\\n                                          of sewerage services, high connection costs, unplanned dwellings and\\n                                          dilapidated infrastructure.\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          Most households continue to use unsustainable onsite sanitation, which\\n                                          risks contaminating groundwater sources and polluting the environment.\\n                                          Likewise, most of the existing wastewater treatment facilities do not cater\\n                                          to treating faecal sludge. Such an anomaly has led to the deterioration\\n                                          of wastewater treatment facilities. Hence, the quality of both the faecal\\n                                          sludge and effluents does not meet the desired disposal standards.\\n\\n                                          Non-sewered sanitation is used in many urban areas and is the dominant\\n                                          system in rural areas. Despite some initiatives to construct faecal sludge\\n                                          treatment facilities in 16 townships, progress has been slow and falls short\\n                                          of service requirements. A significant proportion of the population in\\n                                          the country uses non-emptiable pit latrines that eventually contaminate\\n                                          groundwater.\\n\\n                                          The sanitation challenge in the country is further compounded by unsafe\\n                                          emptying of pit latrines, improper transportation facilities, inadequate\\n                                          faecal sludge treatment facilities and unsafe disposal practices. In addition,\\n                                          many urban centres have not planned for sanitation services, such as\\n                                          setting aside land for sanitation infrastructure. Also, regulatory monitoring\\n                                          and enforcement of minimum service standards in each segment of the\\n                                          non-sewered sanitation chain is largely ineffective.\\n\\n                                          Implementing and promoting sanitation in the country, including hygienic\\n                                          behaviour, solid waste and stormwater management, has become critical.\\n                                          All these touch on human health, so their proper handling requires\\n                                          collaborative action among various actors.\\n\\n                                          Policy Objective\\n                                          To enhance reliable and sustainable sanitation services.\\n\\n\\n\\n\\n             38\\n                                               THE UNITED REPUBLIC OF TANZANIA\\n                                                            MINISTRY OF WATER\\n\\n\\n\\n\\nPolicy Statements\\nThe Government, in collaboration with stakeholders, shall:\\ni)\\t\\u0007enhance investment and appropriate technologies for sanitation\\n      infrastructure and service provision in rural and urban areas;\\nii)\\t\\u0007enhance regulatory monitoring and enforcement for quality\\n      sanitation services;\\niii)\\t\\u0007promote and coordinate risk-based management approach in the\\n      sanitation value chain among sectors;\\niv) promote city-wide and rural inclusive sanitation planning; and\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nv)    promote community hygiene practices.\\n\\n3.6 Private Sector Participation in the Water Sector\\nPrivate sector engagement and contribution in the water sector remains\\nminimal, limited to capacity building, supplies, consultancy services\\nand construction. Their participation in financing, investment and\\nimplementation of water projects has been low because of high investment\\nrequirements and long payback periods. Existing regulations, such as\\nthe Water Supply and Sanitation Act No.5 of 2019 and the Water Supply\\nRegulations, regulation 14(1), are also not attractive for private sector\\ninvestment and operation of water supply schemes. Thus, the government\\nhas remained burdened with all capital investment and the operation of\\nwater sector projects. With overcommitted financial resources and the\\nmany needs in the water sector, greater private sector involvement will\\nrelieve government finances for other critical purposes, increase service\\ndelivery efficiency and advance modern technology in the sector.\\n\\nPolicy Objective\\nTo strengthen private sector participation in the water sector.\\n\\nPolicy Statements\\nThe Government, in collaboration with stakeholders, shall:\\ni)\\t\\u0007promote private sector engagement in water resources\\n     management and development, provision of water supply and\\n     sanitation services, and\\nii)  coordinate and support private sector initiatives in the water sector.\\n\\n3.7 Research and Technology Development\\nEmerging innovations and technologies in the water sector require\\ndedicated learning from different experiences and continuous, purposeful\\nresearch in different areas. Some areas that require such interventions\\n\\n\\n\\n    39\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          are data and information management systems, climate resilience,\\n                                          non-revenue water losses, wastewater reuse and resource recovery,\\n                                          sanitation, desalination, revenue management and all aspects of water\\n                                          resource management. The absence of a robust knowledge base and\\n                                          continued reliance on traditional and conventional approaches impede\\n                                          effective water resources management, water and wastewater quality\\n                                          management, as well as the provision of sustainable water supply and\\n                                          sanitation services. This requires prioritising research and development\\n                                          and strategic investments in transformative technologies to revolutionise\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          the water sector. Actions needed include fostering and promoting research,\\n                                          technology, and innovation as key drivers of a thriving water sector.\\n                                          Through research, cost-effective and efficient technological alternatives in\\n                                          water and sanitation can be identified to suit current and future needs.\\n\\n                                          In addition, Information and Communication Technology (ICT) plays a\\n                                          pivotal role in enhancing Research and Development (R&D) by providing\\n                                          tools such as Artificial Intelligence (AI) and platforms for streamlining\\n                                          processes, facilitating collaboration and accelerating innovation. It enables\\n                                          researchers to access vast databases, shares findings in real-time, and\\n                                          utilise advanced analytical tools to derive insights from complex data sets.\\n                                          ICT in the water sector must adapt and innovate digital technologies and\\n                                          related tools to facilitate timely informed decisions on water resources\\n                                          management, water quality management, water supply and sanitation\\n                                          services, and infrastructure management. Considering the importance of\\n                                          ICT, the revised policy will continue to strengthen and promote ICT in the\\n                                          water sector.\\n\\n                                          A clear policy direction is required to ensure continued research and\\n                                          technological innovations in the water and sanitation sector, such as\\n                                          categorisation, piloting, approval, and implementation of research\\n                                          findings and technological innovations. A policy environment that allows\\n                                          and encourages experimentation and entrepreneurial thinking, or where\\n                                          WASH innovations are remunerated, is likely to provide an incentive to\\n                                          Basin Water Boards, water utilities and other entities across the sector to\\n                                          invest in R&D. Such investment will, in the long run, lead to well-managed\\n                                          water resources, quality and effective water and sanitation services, more\\n                                          revenue generation by WSSAs and reduction in operational expenses.\\n\\n                                          Furthermore, integrating ICT into water sector R&D will enhance water\\n                                          resource planning, allocation, development, and conservation.\\n\\n\\n\\n             40\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\nPolicy Objective\\nTo enhance research and development in the water sector.\\n\\nPolicy Statements\\nThe Government, in collaboration with stakeholders, shall:\\ni)\\t\\u0007promote and encourage Research and Development (R&D) in the\\n     water sector;\\nii)  promote enabling R&D environment; and\\niii) promote the use of ICT in the water sector.\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\n3.8 Cross-Cutting Issues\\n\\n3.8.1 Environment, Climate Change and Disaster Resilience Systems\\nThe climate in Tanzania is mainly influenced by biophysical factors such\\nas location, seasons, vegetation cover, and proximity to natural dominant\\nbodies such as lakes, oceans, and mountains. Climate change has continued\\nto affect the functioning of ecosystems and has had direct, often harmful,\\nimpacts on human well-being.\\n\\nIn addressing the challenges and impacts of climate change, the Government\\ndeveloped and is implementing the National Climate Change Strategy of\\n2021, covering all sectors. However, the water sector is still vulnerable\\nto climate change, where numerous impacts have been observed,\\nincluding higher temperatures, droughts, floods, and sea level rises.\\nFloods have disrupted water and sanitation services and destruction of\\ncritical infrastructure such as river monitoring stations, roads and bridges.\\nDroughts have led to the drying of rivers and reservoirs, crop failures\\nand depletion of pastures. Generally, climate change has disrupted most\\nproductive sectors and negatively impacts rural communities\\u2019 livelihoods.\\nNotably, the impacts have affected men and women differently - for\\nexample, increasing water scarcity forces women and girls to walk longer\\ndistances to access clean water, thus reducing time for education and\\nincome-generating activities.\\n\\nDespite these observable changes and recorded impacts, the capacity\\nto guide responses is inadequate, and there is generally low resilience\\nagainst climate shocks. The latter could encompass strategic water\\nsecurity investments, e.g., dams to cushion the country against droughts\\nand promotion of risk-based planning in all water projects, among others.\\nInformation systems are uncoordinated, and levels of preparedness\\n\\n\\n\\n    41\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          for water-related disasters remain low, making the water sector more\\n                                          vulnerable to the impacts of climate change.\\n\\n                                          In addition, promoting environmental integrity and social safeguards\\n                                          are key aspects to be considered in implementing water and sanitation\\n                                          projects. Some of the key aspects include pollution and contamination\\n                                          of water resources; purposeful land acquisition for conserving water\\n                                          sources, water supply and sanitation works; catchment degradation and\\n                                          deforestation attributed to land use and land use change; competing water\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          use demands; and inadequate initiatives on wastewater management.\\n\\n                                          There have been cases where some projects have been implemented\\n                                          without adherence to environmental and social guidelines, leading\\n                                          to environmental degradation, pollution and social grievances. These\\n                                          unwarranted impacts have led to significant effects on socio-economic\\n                                          development. In order to address environmental and social safeguards\\n                                          in surface and groundwater projects, a catchment approach is needed.\\n                                          This recognises that all hydrological and environmental systems in the\\n                                          catchment are integrated and dependent on each other. A good example\\n                                          is the change of hydrological water balance across catchments where\\n                                          inter-basin transfer schemes have been implemented.\\n\\n                                          In addressing the potential impact of environmental and social safeguards\\n                                          in water projects, the Ministry of Water has developed and implemented\\n                                          the Resettlement Management Framework, the Environmental and Social\\n                                          Management Framework, and Guidelines for Good Environmental and\\n                                          Social Practices for the water and sanitation sector. However, challenges\\n                                          continue to exist regarding environmental and social safeguards, which\\n                                          require policy guidance.\\n\\n                                          Policy Objective\\n                                          To promote environmental and climate change resilience.\\n\\n                                          Policy Statements\\n                                          The Government, in collaboration with stakeholders, shall:\\n                                          i)\\t\\u0007promote environmental and social safeguards and compliance in\\n                                                the water sector;\\n                                          ii)   ensure land availability for water projects;\\n                                          iii)\\t\\u0007promote mainstreaming of climate change resilience interventions\\n                                                in the water sector;\\n\\n\\n\\n             42\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\niv)\\t\\u0007promote risk-based climate change adaptation and mitigation\\n     measures in the water sector; and\\nv)\\t\\u0007promote cross-sectoral coordination and collaboration in managing\\n     the impacts of climate change and environmental issues.\\n\\n3.8.2 Gender Mainstreaming and Social Inclusion\\nGender equity and social inclusion play a pivotal role in ensuring the\\neffective management and development of water resources and the\\nprovision of water supply and sanitation services. Women, girls and those\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nwith disabilities often have unique WASH challenges, and WASH practices\\nare usually steeped in traditional norms and stigma. Strengthened WASH\\nand IWRM practices often require the empowerment of marginalised\\nvoices within the home, workplace, community, and society to have equal\\nopportunities in the sector.\\n\\nThis includes the youth, who form the main structural base for the\\nTanzanian population. The Government recognises the importance\\nof social inclusion, especially women\\u2019s active participation in water\\nmanagement decision-making, the gendered nature of water collection\\nand the resulting consequences for economic development. In the water\\nsector, efforts to promote gender equality have increased the gender\\nbalance in some decision-making bodies for water resource management\\nand Water Supply and Sanitation Authorities.\\n\\nHowever, the leadership in several of these bodies remains male-\\ndominated, especially in WSSA, where women in leadership positions are\\nless than 10%. By promoting social inclusion in decision-making and using\\na gender lens to inform decisions within the water sector, the revised\\npolicy aims to ensure that relevant water infrastructure is accessible to all\\nand sustainably addresses respective water needs.\\n\\nPolicy Objective\\nTo promote gender and social inclusion in the water sector.\\n\\nPolicy Statements\\nThe Government, in collaboration with stakeholders, shall:\\ni)     strengthen gender mainstreaming in the water sector;\\nii)\\t\\u0007promote public awareness of the role of gender in the water sector;\\n       and\\niii)\\t\\u0007\\u0007ensure inclusiveness of socially vulnerable groups in water-related\\n       matters.\\n\\n\\n    43\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          3.8.3 Good Governance\\n                                          Good governance is important in managing and developing water\\n                                          resources and providing water supply and sanitation services. Some good\\n                                          governance practices ensure participatory decision-making processes,\\n                                          equal capacity-building opportunities, transparency and accountability.\\n                                          These must be observed and mainstreamed in legal frameworks,\\n                                          strategies, plans and programs. To mainstream good governance in the\\n                                          water sector, the Government, in collaboration with stakeholders, will\\n                                          continue to monitor and enforce legal frameworks that prevent corruption\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          and maintain the political stability of the country; enhance transparency\\n                                          and accountability in all implementing agencies by publicly availing various\\n                                          reports and engaging the public on issues of interest relating to the water\\n                                          sector. This is useful so that people are aware of ongoing activities and\\n                                          effectively contribute to development initiatives.\\n\\n                                          Apart from the Government, other partners and stakeholders, e.g.,\\n                                          development partners, the private sector, well-wishers, and communities,\\n                                          have continued to provide financial resources to support the water\\n                                          sector. These resources require accountability and transparency on their\\n                                          expenditures in financing water projects.\\n\\n                                          Policy Objective\\n                                          To promote good governance in the water sector.\\n\\n                                          Policy Statements\\n                                          The Government, in collaboration with stakeholders, shall:\\n                                          i)   s\\u0007trengthen accountability, Impartiality, transparency, and the rule of\\n                                               law in the water sector;\\n                                          ii)  enhance staff capacity building;\\n                                          iii) enhance stakeholders\\u2019 engagement in water sector activities and\\n                                          iv) promote public awareness of good governance in the water sector.\\n\\n\\n\\n\\n             44\\n  Chapter\\n\\n\\n    4\\n\\n                       National Water Policy 2002 Version 2025\\nLegal and Regulatory\\nFramework\\n\\n\\n\\n\\n                                    45\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                      LEGAL AND REGULATORY FRAMEWORK\\n\\n                                          Tanzania has established the legal and regulatory frameworks facilitating\\n                                          the management, coordination, and implementation of NAWAPO 2002\\n                                          objectives, strategies, and activities. The legislation is aligned to various\\n                                          Acts, Codes of Practice, and Regulations under a general water law that\\n                                          guides the functioning of the water sector. The existing legal and regulatory\\n                                          frameworks that are directly related to water and sanitation include the\\n                                          Water Resources Management Act, 2009; The Water Supply and Sanitation\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          Act, 2019; The Energy and Water Utilities Regulatory Authority Act, 2001;\\n                                          The Environmental Management Act No. 20 of 2004 and Natural Wealth\\n                                          and Resources (Permanent Sovereignty Act 2017).\\n\\n                                          To effectively implement the revised policy and avoid ambiguity and\\n                                          duplication of functions, there is a need to undertake a comprehensive\\n                                          review of some of the above Acts, especially the Water Supply and Sanitation\\n                                          Act, 2019 and the Regulations for Water Supply and Sanitation of 2019.\\n                                          This Act states that when a WSSA extends services to an area serviced by\\n                                          a community organisation or a person, the latter\\u2019s services shall cease to\\n                                          exist, and provision of such services will be undertaken by the WSSA. In\\n                                          contrast, the revised policy encourages investments from private and other\\n                                          entities in the provision of water supply services. The new Act should be\\n                                          able to recognise and appreciate existing private investments and services\\n                                          and provide for the continuation of such services with clear engagement\\n                                          frameworks with the respective WSSAs.\\n\\n                                          Another provision in the Act that needs to be revised is the functions of\\n                                          RUWASA. The existing Water Supply and Sanitation Act grants RUWASA\\n                                          the mandate to register, invest, monitor, regulate and evaluate the\\n                                          performance of CBWSOs. RUWASA also has the mandate of planning,\\n                                          implementing and supervising projects while providing financial and\\n                                          technical support to CBWSOs. Such an arrangement gives RUWASA both\\n                                          regulatory and supervisory mandates over CBWSOs, which contradicts the\\n                                          prescribed governance principle of separating oversight, regulatory and\\n                                          implementation roles.\\n\\n                                          The Government desires to establish sewerage networks in urban and\\n                                          rural areas where all households would be connected to such networks.\\n                                          The Public Health Act of 2019 requires that any house located within 30\\n                                          meters of a sewer network be connected to that network. To complement\\n\\n\\n\\n             46\\n                                              THE UNITED REPUBLIC OF TANZANIA\\n                                                           MINISTRY OF WATER\\n\\n\\n\\n\\nthe Public Health Act of 2019, the Water Supply and Sanitation Act of 2019\\nmust be revised to strengthen sanitation infrastructure\\u2019s development, its\\noptimal use, and sustainability.\\n\\nOther national legislations related to and directly complementing the\\nimplementation of NAWAPO 2002 and which may need to be reviewed\\ninclude Forest Act No. 14 of 2002; National Irrigation Act No. 5 of 2013;\\nThe Grazing Land and Animal Feed Resources Act No. 13, 2010; The Village\\nLand Act No. 5, 1999; The Land Act No 4 of 1999; The Wildlife Conservation\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nAct No 5 2009; The Local Government (District Authorities) Act No.7, 1982;\\nThe Local Government (Urban Authorities) Act No. 8, 1982; The Mining Act,\\n2010; The Roads Act No. 13 of 2007; The Standard Act of 2009; The Public\\nHealth Act No. 01 of 2009; The National Security Act, No. 03 of 1970; the\\nLand Acquisition Act, No. 47 of 1967; The Land Use Planning Act, 2007 and\\nThe Urban Planning Act No. 08 of 2007.\\n\\nThe revised regulatory frameworks will form a basis for implementing\\nthe reviewed NAWAPO 2002, Version 2025. Other legislations may be\\nreviewed\\/amended to effectively implement the reviewed policy.\\n\\n\\n\\n\\n    47\\n                                          THE UNITED REPUBLIC OF TANZANIA\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\n\\n\\n\\n\\n             48\\n  Chapter\\n\\n\\n    5\\n\\n                 National Water Policy 2002 Version 2025\\nInstitutional\\nFramework,\\nMonitoring\\nand Evaluation\\n\\n\\n\\n                              49\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                                  INSTITUTIONAL FRAMEWORK, MONITORING\\n                                                             AND EVALUATION\\n\\n                                          5.1 Institutional Framework\\n                                          NAWAPO 2002, Version 2025 will use the existing institutional framework\\n                                          for management, coordination, and collaboration between ministries, the\\n                                          private sector, development partners and other stakeholders to ensure\\n                                          the sustainable development of the water sector. Under circumstances\\n                                          that will necessitate the review of the existing institutional framework,\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          the instruments for implementing this policy i.e water laws, strategies,\\n                                          programs and implementation plans will be used to make the necessary\\n                                          improvements. The following are the existing institutional responsibilities\\n                                          for implementing the policy.\\n\\n                                          5.1.1 Ministry Responsible for Water\\n                                          The ministry will coordinate the implementation and evaluation of NAWAPO\\n                                          2002, Version 2025.\\n\\n                                          5.1.2 Ministry Responsible for Health\\n                                          This will prepare guidelines and strategies for sanitation and hygiene\\n                                          matters.\\n\\n                                          5.1.3 Ministry Responsible for Regional Administration and Local\\n                                          Government Authorities\\n                                          This ministry will collaborate with the ministry responsible for water in\\n                                          preparing and implementing water resources management plans and\\n                                          construction of water supply and sanitation projects.\\n\\n                                          5.1.4 Ministry Responsible for Finance\\n                                          This ministry will allocate and provide financial resources to implement\\n                                          the Policy\\u2019s strategies.\\n\\n                                          5.1.5 Ministry Responsible for Works\\n                                          This ministry will collaborate with the Ministry of Water in planning and\\n                                          implementing infrastructure projects.\\n\\n                                          5.1.6 Ministry Responsible for Home Affairs\\n                                          This ministry will collaborate with the Ministry responsible for Water to\\n                                          protect and conserve water sources and infrastructure.\\n\\n\\n\\n\\n             50\\n                                              THE UNITED REPUBLIC OF TANZANIA\\n                                                           MINISTRY OF WATER\\n\\n\\n\\n\\n5.1.7 Ministry Responsible for Investment and Planning\\nThis ministry will scrutinise and approve various water project proposals\\nto obtain financial resources for implementation.\\n\\n5.1.8 Ministry Responsible for Education\\nThis ministry will prepare programs to educate students in schools on\\nthe importance of water resource conservation, sanitation and personal\\nhygiene.\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\n5.1.9 Ministry Responsible for Agriculture\\nThis ministry will promote agricultural activities that prioritise water\\nsource conservation, environmental management, and efficient irrigation\\ninfrastructure.\\n\\n5.1.10 Ministry Responsible for Livestock and Fisheries\\nThis ministry will construct water infrastructure for livestock to prevent\\ndestruction of domestic water infrastructure and pollution of water\\nsources, manage and conserve aquatic ecosystems to support sustainable\\nfisheries and protect biodiversity.\\n\\n5.1.11 Ministry Responsible for Energy\\nThis ministry will ensure availability of energy, such as electricity, for\\nwater treatment facilities and water pumping systems and participate in\\nconserving watersheds in hydropower project areas.\\n\\n5.1.12 Ministry Responsible for Natural Resources and Tourism\\nThis ministry will conserve forests and ecosystems to protect water\\ncatchment areas.\\n\\n5.1.13 Ministry Responsible for Lands\\nThis ministry will allocate land for water sources and designate areas for\\nwater and sanitation projects.\\n\\n5.1.14 Ministry Responsible for Environment\\nThis ministry will prepare various environmental management guidelines\\nfor protecting and conserving water resources.\\n\\n5.1.15 Ministry Responsible for Disaster Management\\nThis will coordinate the management of social emergencies, especially\\ndrought, floods, and other disasters affecting water infrastructure and\\nsources.\\n\\n\\n    51\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          5.1.16 Ministry Responsible for Public Service and Good\\n                                          Governance\\n                                          This will ensure the availability of skilled human resources to implement\\n                                          the policy.\\n\\n                                          5.1.17 Ministry Responsible for Industries and Trade\\n                                          This will ensure a regulatory environment that balances industrial growth\\n                                          with the preservation of water resources, supporting initiatives to improve\\n                                          water access, quality, and conservation.\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          5.1.18 Ministry Responsible for Foreign Affairs\\n                                          This ministry will collaborate with the Ministry responsible for Water in\\n                                          preparing and implementing regional and international agreements and\\n                                          protocols on transboundary water resources.\\n\\n                                          5.1.19 Local Government Authorities\\n                                          These will sensitise communities to the importance of protecting and\\n                                          conserving water sources, safeguarding water infrastructure, and\\n                                          preparing and managing the implementation of by-laws for water resource\\n                                          management.\\n\\n                                          5.1.20 Energy and Water Utilities Regulatory Authority (EWURA)\\n                                          This will regulate the pricing and quality of water services provided by\\n                                          WSSAs.\\n\\n                                          5.1.21 Development Partners\\n                                          They will provide financial resources and technical support for implementing\\n                                          water projects.\\n\\n                                          5.1.22 The Private Sector\\n                                          This will participate in the development and management of water projects.\\n\\n                                          5.1.23 Non-Governmental and Civil Society Organisations\\n                                          They will prepare and implement community awareness programs to\\n                                          promote sustainable water resources, water use efficiency, and water\\n                                          system management, as well as finance and implement water supply and\\n                                          sanitation projects.\\n\\n                                          5.1.24 Academic and Research Institutions\\n                                          They will conduct research, produce water and sanitation experts, and\\n                                          provide consultation services on water sector issues.\\n\\n\\n             52\\n                                              THE UNITED REPUBLIC OF TANZANIA\\n                                                           MINISTRY OF WATER\\n\\n\\n\\n\\n5.1.25 Basin Water Boards\\nThey will manage and develop water resources.\\n\\n5.1.26 Water Entities (WSSAs & RUWASA)\\nThese will construct water projects, provide clean and safe water and\\nsanitation services in rural and urban areas, and participate in the\\nconservation of water sources.\\n\\n5.1.27 National Water Fund\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nThe fund will mobilise financial resources to manage and develop water\\nresources and water supply and sanitation projects.\\n\\n5.1.28 The Water Institute\\nThe institute will produce experts in the construction, management, and\\ndevelopment of water projects, conduct research, and provide technical\\nconsultation to support the water sector.\\n\\n5.1.29 Community-Based Water Supply Organisations (CBWSOs) and\\nOther Water Service Providers\\nThese will manage and operate water supply and sanitation services at the\\ncommunity level and maintain water schemes to ensure reliable access to\\nclean and safe water.\\n\\n5.1.30 Water User Associations (WUAs)\\nThese will be responsible for conserving and protecting water sources\\nagainst encroachment and non-permitted water abstractions.\\n\\n5.1.31 The Community\\nThey will be responsible for conserving and protecting water sources and\\nwater distribution infrastructure and contributing to the costs of water\\nservice operations to ensure sustainability.\\n\\n5.1.32 Media\\nThey will be responsible for educating and providing accurate and timely\\ninformation about the water sector to citizens and various stakeholders.\\n\\n5.2 Monitoring and Evaluation\\nMonitoring and Evaluation (M&E) of this policy is the responsibility of the\\nministry responsible for water in collaboration with stakeholders. M&E will\\nbe conducted from national to lower levels using the existing Integrated\\n\\n\\n\\n    53\\n                                          THE UNITED REPUBLIC OF TANZANIA\\n                                          MINISTRY OF WATER\\n\\n\\n\\n\\n                                          Water Sector Monitoring and Evaluation System. The mid-term evaluation\\n                                          will be conducted every five years of policy implementation. During\\n                                          the policy\\u2019s lifespan, the ministry will play a key role in its coordination,\\n                                          implementation, monitoring and evaluation. The stakeholders and water\\n                                          sector implementing agencies will be responsible for providing appropriate\\n                                          information to the ministry for the M&E process. The ministry will also be\\n                                          responsible for analysing, integrating and disseminating the received and\\n                                          analysed information for the benefit of the public.\\nNational Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                          5.3 Conclusion\\n                                          The overall objective of NAWAPO 2002 was to develop a comprehensive\\n                                          framework for sustainable development and management of the nation\\u2019s\\n                                          water resources. Important areas considered in the policy include water\\n                                          resources management; improved health and poverty alleviation of rural\\n                                          populations through improved access to adequate and safe water; and\\n                                          sustainable, effective and efficient development and management of\\n                                          urban water supply and sewerage services. The policy aimed at ensuring\\n                                          beneficiaries participate fully in the planning, construction, operation,\\n                                          maintenance and management of community-based domestic water\\n                                          supply schemes.\\n\\n                                          Achievements of NAWAPO 2002 include establishing the most extensive\\n                                          Water Sector Development Program in Sub-Saharan Africa, enacting\\n                                          water laws, and preparing and implementing the National Water Sector\\n                                          Development Strategy. Various institutions for managing water resources\\n                                          were established, including the National Water Board, Basin Water\\n                                          Boards, Water Supply and Sanitation Authorities, Community Based Water\\n                                          Supply Organisations, Rural Water Supply and Sanitation Agency and the\\n                                          National Water Fund. The establishment of these institutions has brought\\n                                          improvement in the management and development of water resources,\\n                                          including transboundary waters, improved water and wastewater quality\\n                                          management and the improved provision of water supply and sanitation\\n                                          services nationally.\\n\\n                                          Despite these achievements, some challenges have been observed\\n                                          during policy implementation. These include impacts of climate change\\n                                          causing floods and drought; inadequate investment in strategic water\\n                                          storage facilities for ensuring water security; water demand management\\n                                          challenges; degradation of water sources and catchments due to poor land\\n                                          use practices; encroachment of land near water sources for agriculture\\n\\n\\n\\n             54\\n                                                THE UNITED REPUBLIC OF TANZANIA\\n                                                             MINISTRY OF WATER\\n\\n\\n\\n\\nand urbanisation which impacted wetlands, important watershed areas\\nand recharge areas. Furthermore, water harvesting technology and a self-\\nsustaining national water grid for efficient use of available water resources\\nfor all benefits were not emphasised in NAWAPO 2002. In water quality and\\nwastewater management, improper treatment and discharge of wastewater\\ninto the environment pollutes water sources, and in rural areas, water\\nquality issues were not considered in the previous policy. Urbanisation,\\nindustrial development, and other economic activities in water supply\\nand sanitation do not match the available water infrastructure. High non-\\n\\n\\n\\n\\n    National Water Policy 2002 Version 2025\\nrevenue water has resulted in revenue loss and inefficient service delivery.\\nIn rural areas, sanitation was not considered when planning and designing\\nwater projects. Other issues that were not given high consideration in\\nNAWAPO 2002 include R&D and the involvement of the private sector in\\nthe development and operation of water schemes.\\n\\nThese challenges and policy gaps in the implementation of NAWAPO 2002\\ndrove the Government and stakeholders to see the need for a review of the\\npolicy. NAWAPO 2002, Version 2025 will, therefore, provide policy guidance\\nfor important issues related to the water sector while also considering\\nchallenges observed during the implementation of NAWAPO 2002. This\\npolicy, among other things, emphasises aspects of climate change that are\\nof worldwide concern. It addresses the development of water resources\\nwhose implementation was limited due to lack of policy directives;\\nencourages more private sector participation in delivering water services;\\nconsiders inclusivity in policy issues of rural water and wastewater quality\\nmanagement and sanitation; and encourages research and development to\\nenhance new technologies and innovations in the water sector. Therefore,\\nthe Government invites all stakeholders to participate in implementing this\\nPolicy to achieve optimal, reliable, sustainable and equitable development\\nand use of water resources for the benefit of all in the most cost-effective\\nmanner possible.\\n\\n\\n\\n\\n    55\\n                                          THE UNITED REPUBLIC OF TANZANIA\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\n\\n\\n\\n\\n             56\\nTHE UNITED REPUBLIC OF TANZANIA\\n             MINISTRY OF WATER\\n\\n\\n\\n\\n                                  National Water Policy 2002 Version 2025\\n\\n\\n\\n\\n                                               57\\n                                          THE UNITED REPUBLIC OF TANZANIA\\nNational Water Policy 2002 Version 2025   MINISTRY OF WATER\\n\\n\\n\\n\\n                                                         Ministry of Water\\n\\n                                                              Government City, Maji Street\\n                                                              P.O.Box 456, Dodoma\\n\\n                                                              Hotline +255 26 2322602\\n\\n                                                              Fax No. +255 26 2322602\\n\\n                                                              E-mail: ps@maji.go.tz\\n\\n                                                              Website: www.maji.go.tz\\n\\n\\n\\n\\n             58\",\"updated_at\":\"2025-11-21 12:13:21\"},\"hostname\":\"dave-mbp\"}','2025-11-21 12:13:21'),(874,'a068f955-4d6c-4a36-85c1-f5d91775a229','a068f955-4de6-4077-b30a-c55fdcce9f47',NULL,1,'query','{\"connection\":\"mysql\",\"driver\":\"mysql\",\"bindings\":[],\"sql\":\"select * from `jobs` where `id` = 3 limit 1 for update\",\"time\":\"0.88\",\"slow\":false,\"file\":\"\\/Users\\/dave\\/Sites\\/ae-policy-tracking-tool\\/artisan\",\"line\":13,\"hash\":\"701e0eff6beceb4d961bc890c63f6ecd\",\"hostname\":\"dave-mbp\"}','2025-11-21 12:13:21'),(875,'a068f955-4da1-45ee-8d56-be77db9a9c0e','a068f955-4de6-4077-b30a-c55fdcce9f47',NULL,1,'query','{\"connection\":\"mysql\",\"driver\":\"mysql\",\"bindings\":[],\"sql\":\"delete from `jobs` where `id` = 3\",\"time\":\"0.39\",\"slow\":false,\"file\":\"\\/Users\\/dave\\/Sites\\/ae-policy-tracking-tool\\/artisan\",\"line\":13,\"hash\":\"8d1bddd6e09fe9e9537d55b08cba190b\",\"hostname\":\"dave-m