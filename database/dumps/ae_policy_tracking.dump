DROP TABLE IF EXISTS `priority_actions`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `priority_actions` (
  `id` varchar(400) COLLATE utf8mb4_unicode_ci NOT NULL,
  `name` varchar(400) COLLATE utf8mb4_unicode_ci NOT NULL,
  `code_and_name` varchar(500) COLLATE utf8mb4_unicode_ci GENERATED ALWAYS AS (concat(`id`,_utf8mb4' - ',`name`)) VIRTUAL,
  `recommendation_id` bigint unsigned NOT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `priority_actions`
--

LOCK TABLES `priority_actions` WRITE;
/*!40000 ALTER TABLE `priority_actions` DISABLE KEYS */;
INSERT INTO `priority_actions` (`id`, `name`, `recommendation_id`, `created_at`, `updated_at`) VALUES ('1.1','Promote the integration of agroecological approaches in policies and plans that address agriculture and food system challenges in the local context by strengthening the resilience of food systems.',1,NULL,NULL),('1.2','Strengthen public policies to harness market mechanisms to enable sustainable agriculture and food systems by considering economic, environmental, and social, including public health, externalities, trade-offs and synergies. ',1,NULL,NULL),('1.3','Enhance policy coherence and coordination of agroecological approaches across sectors such as health, agriculture, environment, trade, and finance, which impact food systems and nutrition outcomes. ',1,NULL,NULL),('1.4','Strengthen policies, programmes and actions that address root causes of gender inequality, in particular laws and policies to support inter alia equal access to natural resources, finance and public services, respecting and protecting women\'s knowledge.',1,NULL,NULL),('2.1','Encourage data collection and analysis at national level, documentation of lessons learned and information sharing at all levels to support evaluation of the performance of agroecological approaches.',2,NULL,NULL),('2.2','Undertake holistic assessments of employment conditions, dietary diversity, nutritional outcomes, women\'s empowerment, and income stability. ',2,NULL,NULL),('2.3','Assess and document the contribution of agroecology to FSN at national and global levels, working in collaboration with member countries. ',2,NULL,NULL),('2.4','Encourage data collection, documentation and information sharing on agroecological principles and practices to foster transitions toward sustainable food systems.',2,NULL,NULL),('3.1','Raise awareness and advocate for the importance of diversified production systems and healthy diets that integrate livestock, aquaculture, cropping and agroforestry, as appropriate, to enhance resilient livelihoods and promote sustainable production for healthy diets.',3,NULL,NULL),('3.2','Promote, based on agroecological approaches, alternatives to chemical pesticides and greater integration of biodiversity for food and agriculture and especially, encourage the removal of highly hazardous pesticides.',3,NULL,NULL),('3.3','Strengthen responsible investment and social innovation in micro, small and medium-sized enterprises that support sustainable agriculture and food systems and retain value locally, especially small-scale producers and women.',3,NULL,NULL),('3.4','Support market and social innovations (including use of digital technologies) that strengthen linkages between urban communities and rural farmers by capturing a high proportion of the value of production locally.',3,NULL,NULL),('3.5','Raise awareness of the contribution of agroecological approaches to achieving most of the SDGs and to advancing the Koronivia Joint Work on Agriculture (KJWA) to achieve sustainable and climate-resilient food systems at the national and global levels.',3,NULL,NULL),('3.6','Consistent with national contexts, recognize the value of and strengthen support for agroecological approaches that promote recycling, regeneration of soil health, optimizing and reducing, where appropriate, reliance on external inputs.',3,NULL,NULL),('4.1','Considering national contexts and regulations, encourage increased resource allocation in public research and responsible investments in private research that promotes evidence-based balanced investment towards enhanced support for agroecological approaches.',4,NULL,NULL),('4.2','Develop and support transdisciplinary research and innovation platforms that foster co-learning between researchers and practitioners, especially through farmer-to-farmer networks and communities of practice.',4,NULL,NULL),('4.3','Promote and enable, responsible investment in participatory research and innovation on agroecological approaches, especially to address the specific needs of vulnerable groups, with their active engagement.',4,NULL,NULL),('4.5','Support horizontal sharing of knowledge and experiences building on existing producer organizations and networks with a focus on women, youth, local and indigenous communities.',4,NULL,NULL),('5.1','Embed property rights for small-scale producers and indigenous peoples through formal legal and regulatory frameworks.',5,NULL,NULL),('5.2','Ensure participation of marginalized and vulnerable groups at all levels of decision-making in the food system',5,NULL,NULL),('5.3','Promote the empowerment of women, particularly small-scale food producers and family farmers, and their organizations, by supporting collective action, negotiation and leadership skills, to increase access to and equity in the control over land and natural resources, according to national legislation. ',5,NULL,NULL),('5.4','Strengthen linkages between urban communities and food production systems that favour transitions towards sustainable food systems by including consumer cooperatives and multi-stakeholder platforms focused on local and regional markets.',5,NULL,NULL);
/*!40000 ALTER TABLE `priority_actions` ENABLE KEYS */;
UNLOCK TABLES;

